# Gerçek sır taşıma riski olan env dosyaları. .env.test bir fixture (commit'li);
# türevleri (.env.test.staging vb.) ve .env.production adı gereği gerçek prod
# sırları taşıyabilir → ignore. Sadece bilinçli fixture'a açık istisna ver.
.env.test.*
.env.production
!.env.test
.DS_Store
*.tsbuildinfo
.vscode/
.idea/
*.swp
.cache/

# Next.js local env
.env.local

# Geçici logo kaynak klasörü
.logo-source/

# Security audit D-3 — backup dosyaları (CLAUDE.md.backup vd.) içerikleri
# hassas mimari/test bilgisi taşıyor. Repo'ya girmemeli.
*.backup
*.bak

# Jest/ts-jest derleme artifact'leri — helper kaynak .ts'leri commit'lenir,
# .js/.d.ts/.map çıktıları repo'ya girmez.
apps/api/test/helpers/*.js
apps/api/test/helpers/*.d.ts
apps/api/test/helpers/*.d.ts.map
apps/api/test/helpers/*.js.map

# Windows/WSL "downloaded from internet" alternate data stream artifact'leri.
*:Zone.Identifier

# Playwright test artifacts
apps/web/test-results/
apps/web/playwright-report/

# Claude Code yerel oturum/memory verisi
.claude/

# packages/db geçici debug scriptleri (chk.mjs, rel.mjs vb.)
packages/db/*.mjs
