# ============================================================================
# Rothern — ÜRETİM env şablonu (Coolify/Hetzner).
# .env.example'ın prod-değerli hâli. Domain'leri kendi alan adınızla değiştirin.
#
# ⚠️ NEXT_PUBLIC_* → Next DERLEME ZAMANI gömer. Coolify web/admin uygulamasında
#    bunları RUNTIME env DEĞİL, "Build Variable / Build Arg" olarak girin.
#    Diğer tüm değişkenler runtime env'dir (api uygulamasında).
# ============================================================================

# ---- Database (Supabase Postgres) -----------------------------------------
DIRECT_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# ---- Supabase Auth ---------------------------------------------------------
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<anon JWT>
SUPABASE_SERVICE_ROLE_KEY=<service_role JWT — SADECE api runtime env, asla build/browser>
SUPABASE_JWT_SECRET=<HS256 secret>

# ---- API (api.rothern.com) -------------------------------------------------
NODE_ENV=production
API_PORT=4000
API_URL=https://api.rothern.com
JWT_SECRET=<openssl rand -base64 48 — GÜÇLÜ, dev'den FARKLI>
JWT_EXPIRES_IN=1h
# app + admin origin'leri (virgülle). Yalnız gerçek prod domain'ler.
CORS_ORIGINS=https://app.rothern.com,https://admin.rothern.com
# Subdomain'ler arası httpOnly cookie paylaşımı için nokta-önekli kök domain.
# app/admin/api hepsi *.rothern.com → ".rothern.com". NODE_ENV=production ayrıca
# Secure bayrağını açar (yalnız HTTPS). Coolify TLS'i (Let's Encrypt) sağlar.
COOKIE_DOMAIN=.rothern.com

# İlk deploy'da bir kez admin tohumu: api uygulamasında RUN_SEED=true ver,
# başarılı ilk boot'tan sonra KALDIR. seed prod'da zayıf parolayı reddeder.
RUN_SEED=false
INITIAL_ADMIN_EMAIL=admin@rothern.com
INITIAL_ADMIN_PASSWORD=<GÜÇLÜ parola — min 12+ karakter, prod seed zorunlu kılar>
INITIAL_ADMIN_FIRST_NAME=Rothern
INITIAL_ADMIN_LAST_NAME=Admin

# ---- Web (app.rothern.com) — NEXT_PUBLIC_* = BUILD ARG ---------------------
WEB_URL=https://app.rothern.com
NEXT_PUBLIC_API_URL=https://api.rothern.com/api
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon JWT>
NEXT_PUBLIC_SITE_URL=https://app.rothern.com

# ---- Admin (admin.rothern.com) --------------------------------------------
ADMIN_URL=https://admin.rothern.com

# ---- E-posta (Resend) — prod'da DOĞRULANMIŞ domain ------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=<re_...>
EMAIL_FROM_NAME=Rothern
# Resend Dashboard → Domains'te SPF+DKIM+DMARC doğrulanmış adres (onboarding@resend.dev DEĞİL).
EMAIL_FROM_ADDRESS=no-reply@rothern.com
EMAIL_REPLY_TO=destek@rothern.com

# ---- File Storage (Cloudflare R2) -----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=rothern-prod
# Kalıcı public URL — R2 custom domain veya pub-XXXX.r2.dev. Prod'da ŞART.
R2_PUBLIC_BASE_URL=https://cdn.rothern.com

# ---- Gözlemlenebilirlik ----------------------------------------------------
SENTRY_DSN=<https://...ingest.sentry.io/...>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info

# ---- Webhook / AI (opsiyonel ama önerilir) --------------------------------
# Resend webhook imza doğrulaması (e-posta teslim takibi). Resend Dashboard →
# Webhooks → Signing Secret. Prod'da SET → imzalı webhook'lar doğrulanır.
RESEND_WEBHOOK_SECRET=<whsec_...>
# AI "Hakkımızda" metni (Claude Haiku). Yoksa heuristik fallback (özellik kapanmaz).
ANTHROPIC_API_KEY=
# Rate-limit (varsayılan 100/10 yeterli — override gerekirse):
# THROTTLE_DEFAULT_LIMIT=100
# THROTTLE_AUTH_LIMIT=10

# ---- Güvenlik --------------------------------------------------------------
# Prod'da webhook imza doğrulaması ZORUNLU → bu satırı HİÇ koymayın (veya false).
# ALLOW_INSECURE_WEBHOOK=
