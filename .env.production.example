# ============================================================================
# Rothern — ÜRETİM env şablonu (Coolify/Hetzner).
# .env.example'ın prod-değerli hâli. Domain'leri kendi alan adınızla değiştirin.
#
# ⚠️ NEXT_PUBLIC_* → Next DERLEME ZAMANI gömer. Coolify web/admin uygulamasında
#    bunları RUNTIME env DEĞİL, "Build Variable / Build Arg" olarak girin.
#    Diğer tüm değişkenler runtime env'dir (api uygulamasında).
# ============================================================================

# ---- Database (Supabase Postgres) -----------------------------------------
DIRECT_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20

# ---- Supabase Auth ---------------------------------------------------------
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<anon JWT>
SUPABASE_SERVICE_ROLE_KEY=<service_role JWT — SADECE api runtime env, asla build/browser>
# İsteğe bağlı ama CANLIDA ÖNERİLİR (derin denetim Y-11): Dashboard → Settings → API Keys →
# Secret key (sb_secret_…). Tanımlıysa parola doğrulaması bu anahtarla yapılır ve istemci IP'si
# Sb-Forwarded-For ile Supabase'e iletilir → IP başına giriş kotası sunucu IP'sinde paylaşılmaz.
# SUPABASE_SECRET_KEY=<sb_secret_… — SADECE api runtime env>

# ---- API (api.rothern.com) -------------------------------------------------
NODE_ENV=production
API_PORT=4000
API_URL=https://api.rothern.com
JWT_SECRET=<openssl rand -base64 48 — GÜÇLÜ, dev'den FARKLI>
JWT_EXPIRES_IN=1h
# app + admin origin'leri (virgülle). Yalnız gerçek prod domain'ler.
CORS_ORIGINS=https://www.rothern.com,https://admin.rothern.com
# Subdomain'ler arası httpOnly cookie paylaşımı için nokta-önekli kök domain.
# app/admin/api hepsi *.rothern.com → ".rothern.com". NODE_ENV=production ayrıca
# Secure bayrağını açar (yalnız HTTPS). Coolify TLS'i (Let's Encrypt) sağlar.
COOKIE_DOMAIN=.rothern.com
# CSRF KRİTİK: same-domain prod'da (api/app/admin.rothern.com hepsi rothern.com
# altında = same-site) "lax" → CsrfGuard double-submit fail-closed + tarayıcı
# SameSite backstop AÇILIR. Boş bırakılırsa prod'da "none"a düşer ve CsrfGuard
# KOMPLE bypass olur (csrf.guard.ts:70) → CSRF açık.
#   ⚠️ SIRALI BAĞIMLILIK (bkz. launch-checklist): önce custom domain'leri bağla +
#   doğrula, SONRA bunu "lax" yap. Ham provider domain'inde (rothern-api.onrender.com
#   + *.vercel.app = CROSS-SITE) "lax" cookie'yi göndermez → GİRİŞ KIRILIR. O
#   topolojide "none" kalır + CORS origin-allowlist'e güvenilir (bkz. item 4).
COOKIE_SAMESITE=lax
# Doğrulanmamış kayıt temizliği (e-postası 7 gündür doğrulanmamış kayıt silinir;
# gece 05:10, gecede en fazla 500 kayıt + kayıt / ekip daveti anında). Canlıda ve
# staging'de TANIMLAMAYIN: NODE_ENV=production iken kendiliğinden AÇIK.
# Acil durdurma: Render panelinden "false" (deploy gerekmez; servis yeniden
# başlar, açılış günlüğü "Unverified sign-up purge is OFF …" yazar).
# Yedekten dönülen bir KOPYA bu ortamın auth anahtarlarıyla açılacaksa "false"
# ZORUNLU (docs/backup-restore-drill.md). Ayrıntı: .env.example.
# UNVERIFIED_SIGNUP_PURGE_ENABLED=

# İlk deploy'da bir kez admin tohumu: api uygulamasında RUN_SEED=true ver,
# başarılı ilk boot'tan sonra KALDIR. seed prod'da zayıf parolayı reddeder.
RUN_SEED=false
INITIAL_ADMIN_EMAIL=admin@rothern.com
INITIAL_ADMIN_PASSWORD=<GÜÇLÜ parola — min 12+ karakter, prod seed zorunlu kılar>
INITIAL_ADMIN_FIRST_NAME=Rothern
INITIAL_ADMIN_LAST_NAME=Admin

# ---- Web (www.rothern.com) — NEXT_PUBLIC_* = BUILD ARG ---------------------
WEB_URL=https://www.rothern.com
NEXT_PUBLIC_API_URL=https://api.rothern.com/api
NEXT_PUBLIC_SITE_URL=https://www.rothern.com

# --- Pazar yeri (herkese açık vitrin) ---------------------------------------
# İKİ anahtar, İKİ platform; ikisi de fail-closed (env yoksa KAPALI, yalnız
# tam olarak "true" açar). Biri eksikse pazar yeri BOŞ görünür — görünür bir
# hata, sessiz sızıntının tersi.
#   MARKETPLACE_LIVE            → API uçları (/public/listings*, /directory*)
#   NEXT_PUBLIC_MARKETPLACE_LIVE→ web sayfaları + robots + sitemap (BUILD zamanı)
# Açılış GERİ ALINAMAZ (indeksten düşme süresi arama motorunun elinde) —
# bkz. docs/launch-checklist.md § Pazar yeri açılışı.
MARKETPLACE_LIVE=false
NEXT_PUBLIC_MARKETPLACE_LIVE=false


# ---- Admin (admin.rothern.com) --------------------------------------------
ADMIN_URL=https://admin.rothern.com

# ---- E-posta (Resend) — prod'da DOĞRULANMIŞ domain ------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=<re_...>
EMAIL_FROM_NAME=Rothern
# Resend Dashboard → Domains'te SPF+DKIM+DMARC doğrulanmış adres (onboarding@resend.dev DEĞİL).
EMAIL_FROM_ADDRESS=hesap@rothern.com
EMAIL_REPLY_TO=destek@rothern.com
# Akış başına gönderen (apps/api modules/email/email-streams.ts) — HEPSİ İSTEĞE
# BAĞLI; boş bırakılan akış EMAIL_FROM_ADDRESS'ten çıkar. Canlı açılış kapısı
# doluysa sitenin alan adını (ya da alt alan adını) ister. Hepsi doğrulanmış
# rothern.com Resend alan adında:
#   ACTIVITY     — alıcının kendi işlemine dair bildirimler (teklifim elendi,
#                  talebim kapandı, onay bekliyor…): çıkış başlığı YOK, işlem
#                  göndericisi gibi davranır
#   NOTIFICATION — keşif bildirimleri (kategori eşleşmesi, AI önerisi, özet,
#                  duyuru): tek tık çıkış başlığı VAR
#   INVITE       — kayıtsız adrese davet
#   LIFECYCLE    — karşılama serisi / haftalık özet
EMAIL_FROM_ADDRESS_ACTIVITY=hesap@rothern.com
EMAIL_FROM_ADDRESS_NOTIFICATION=bildirim@rothern.com
EMAIL_FROM_ADDRESS_INVITE=davet@rothern.com
EMAIL_FROM_ADDRESS_LIFECYCLE=haber@rothern.com
# Davet mektupları (INVITE) List-Unsubscribe başlığı TAŞIMAZ; yalnız Gmail'e
# günlük toplam hacim 5.000'e yaklaşırken TAM OLARAK "true" (API yeniden
# başlatılır). Bkz. docs/release-process.md "Operatör: soğuk davet…" madde 7.
# COLD_INVITE_LIST_UNSUBSCRIBE_HEADER=
# Alıcı izin listesi CANLIDA BOŞ KALIR (yalnız staging; doluysa listede olmayan
# hiçbir müşteriye e-posta gitmez). Bkz. .env.example.
# AÇILIŞ KAPISI (2026-10-07): canlıda (NODE_ENV=production + WEB_URL alan adı
# rothern.com) EMAIL_ALLOWLIST doluysa ya da CORS_ALLOW_VERCEL=true ise API
# AÇILMAZ (common/config/prod-config-sanity.ts). Staging (supkeys.com) etkilenmez.
# Bilinçli istisna — canlıda TANIMLANMAZ, yalnız rothern.com altında koşan ama
# canlı olmayan bir prova ortamı için: ALLOW_STAGING_ONLY_ENV=true
EMAIL_ALLOWLIST=

# ---- File Storage (Cloudflare R2) — İKİ BUCKET (güvenlik) ------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# PRIVATE bucket — KYC/ihale/teklif/sipariş belgeleri. Public access KAPALI,
# custom domain YOK, yalnız presigned. (Mevcut rothern-prod bunun rolünü alır.)
R2_PRIVATE_BUCKET=rothern-prod
# PUBLIC bucket — yalnız profil görselleri. Public access AÇIK + custom domain.
R2_PUBLIC_BUCKET=rothern-public
# PUBLIC bucket'ın custom domain'i (kalıcı görsel URL'i). Prod'da ŞART.
# ⚠️ Bu domain YALNIZ public bucket'a bağlı olmalı; private bucket'a ASLA.
# Bkz. docs/r2-bucket-split.md (Cloudflare kurulum sırası + API token uyarısı).
# Web tarafı görsel optimizasyonu (next/image `remotePatterns`) bu değerden
# türetilir — API'nin `R2_PUBLIC_BASE_URL`i ile AYNI host olmalı. Boşsa
# görseller optimize edilmeden düz <img> ile servis edilir (kırılmaz).
NEXT_PUBLIC_CDN_URL=https://cdn.rothern.com
R2_PUBLIC_BASE_URL=https://cdn.rothern.com

# ---- Gözlemlenebilirlik ----------------------------------------------------
# ZORUNLU (prod): BOŞ bırakılırsa error tracking + kritik-audit/webhook alarmları
# tümüyle PASİF (Sentry no-op) olur. Sentry projesinden gerçek DSN'i al ve set et.
SENTRY_DSN=https://<key>@o<org-id>.ingest.sentry.io/<project-id>
SENTRY_ENVIRONMENT=production
# Performance tracing örnekleme oranı. 0.1 = isteklerin %10'u (p95/N+1 fast-follow
# için baz veri). Kota/gürültü olursa 0'a çek — salt env, kod değişmez.
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info

# ---- Webhook / AI (opsiyonel ama önerilir) --------------------------------
# Resend webhook imza doğrulaması (e-posta teslim takibi). Resend Dashboard →
# Webhooks → Signing Secret. Prod'da SET → imzalı webhook'lar doğrulanır.
RESEND_WEBHOOK_SECRET=<whsec_...>
# AI "Hakkımızda" metni (Claude Haiku). Yoksa heuristik fallback (özellik kapanmaz).
ANTHROPIC_API_KEY=
# AI özellikleri (Faz AI-0/1/2 — Gemini): asistan sohbeti, belgeden ihale
# doldurma, kullanım ekranı. GEMINI_API_KEY YOKSA hepsi KAPALI (503).
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL_DEFAULT=gemini-flash-latest
AI_MODEL_VISION=gemini-flash-latest
AI_MODEL_PREMIUM=gemini-pro-latest
AI_MAX_PAGES=20
# Rate-limit (kod varsayılanı: default=100, auth=1000, public=600 — override gerekirse).
# Boş / sayı olmayan / ≤ 0 değer VARSAYILANA düşer ve açılışta uyarı basar
# (eskiden boş değer 0 sınırı = tüm API 429 idi); varsayılan için satırı silin:
# THROTTLE_DEFAULT_LIMIT=100
# THROTTLE_AUTH_LIMIT=1000   # DİKKAT: 'auth' throttler'ı TÜM route'lara uygulanır
#                            # (app.module.ts yorumu). Düşük bir değer TÜM API'yi
#                            # o limite indirir — kendi kendine DoS.

# ---- Güvenlik --------------------------------------------------------------
# Prod'da webhook imza doğrulaması ZORUNLU → bu satırı HİÇ koymayın (veya false).
# ALLOW_INSECURE_WEBHOOK=

# Cloudflare arkasında gerçek istemci IP'si (throttle/audit): Render/CF kurulumunda true; CF yoksa false.
TRUST_CF_CONNECTING_IP=true
# TOTP sırrı şifreleme anahtarı (opsiyonel; yoksa JWT_SECRET türevi). JWT_SECRET rotasyonundan ÖNCE eski değerle sabitle.
# TOTP_ENC_KEY=
