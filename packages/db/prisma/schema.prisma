// Rothern/Rothern — birleşik Company sistemi şeması (eski Tenant/Supplier söküldü)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supavisor pooler (port 6543, transaction mode) — runtime sorgular.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — prisma migrate ve introspect için.
  // Supabase'e geçtikten sonra zorunlu; local Docker'da DATABASE_URL ile aynıdır.
  directUrl = env("DIRECT_URL")
}

model PasswordResetToken {
  id               String       @id @default(cuid())
  companyUserId    String?
  companyUser      CompanyUser? @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  tokenHash        String       @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime     @default(now())
  createdByAdminId String?

  @@index([companyUserId])
  @@map("password_reset_tokens")
}

/**
 * E-posta doğrulama kodu (6 hane) — kayıt sonrası e-posta sahipliğini kanıtlar.
 * Kod hash'lenmiş saklanır, tek kullanımlık, süreli. Resend ile gönderilir.
 */
model EmailVerificationCode {
  id            String      @id @default(cuid())
  companyUserId String
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  codeHash      String
  expiresAt     DateTime
  usedAt        DateTime?
  attempts      Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([companyUserId])
  @@map("email_verification_codes")
}

model PlatformAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  // Supabase Auth bridge — `auth.users.id` (UUID).
  authId       String?   @unique
  passwordHash String?
  firstName    String
  lastName     String
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true)
  // 2FA (TOTP) — admin panel yüksek yetkili: firma tarafındaki authenticator
  // akışının portu (Faz 7).
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("platform_admins")
}

enum AdminRole {
  SUPER_ADMIN // her şey
  SALES // demo, tenant
  SUPPORT // sadece okuma + tenant impersonate
}

model EmailLog {
  id                String      @id @default(cuid())
  template          String
  toEmail           String
  toName            String?
  subject           String
  provider          String
  providerMessageId String?     @unique
  status            EmailStatus @default(QUEUED)
  errorMessage      String?
  payload           Json?
  attemptCount      Int         @default(0)
  queuedAt          DateTime    @default(now())
  sentAt            DateTime?
  failedAt          DateTime?

  // V2-1 — Resend webhook delivery tracking
  deliveredAt  DateTime?
  openedAt     DateTime? // ilk açılma
  clickedAt    DateTime? // ilk tıklama
  bouncedAt    DateTime?
  bounceType   String? // "hard" | "soft" | "undetermined"
  bounceReason String?   @db.Text
  complainedAt DateTime?

  events EmailEvent[]

  contextType String?
  contextId   String?

  @@index([status])
  @@index([toEmail])
  @@index([template])
  @@index([contextType, contextId])
  @@index([queuedAt])
  @@map("email_logs")
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  // V2-1 — Resend webhook tracking
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
}

model EmailEvent {
  id         String   @id @default(cuid())
  emailLogId String
  emailLog   EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  /// Webhook idempotency key (svix-id header). Aynı event 2 kez işlenmesin.
  eventId    String         @unique
  eventType  EmailEventType
  /// Resend payload'tan gelen orijinal timestamp.
  occurredAt DateTime
  payload    Json

  /// CLICKED event için tıklanan link.
  clickedUrl   String? @db.Text
  /// BOUNCED event için bounce detay.
  bounceType   String?
  bounceReason String? @db.Text

  createdAt DateTime @default(now())

  @@index([emailLogId, occurredAt])
  @@index([eventType])
  @@map("email_events")
}

enum EmailEventType {
  SENT
  DELIVERED
  DELIVERY_DELAYED
  BOUNCED
  COMPLAINED
  OPENED
  CLICKED
  FAILED
}

enum CompanyType {
  JOINT_STOCK
  LIMITED
  SOLE_PROPRIETOR
}

enum CompanyVerificationStatus {
  UNVERIFIED // belge yok / eksik
  PENDING // 6/6 belge yüklendi, admin onayı bekliyor
  VERIFIED // onaylandı — ihale/premium kapısı açık
  REJECTED // reddedildi (eksik/hatalı belge)
}

// Belge bazlı inceleme durumu — admin her belgeyi ayrı onaylar/reddeder.
// Onaylanan belge kilitlenir; reddedilen belge firma tarafından yeniden
// yüklenebilir (yeniden yüklenince PENDING'e döner).
enum KycDocStatus {
  PENDING // yüklendi, admin incelemesi bekliyor
  APPROVED // admin onayladı — kilitli
  REJECTED // admin reddetti — firma yeniden yükleyebilir
}

enum Currency {
  TRY
  USD
  EUR
  GBP
  CHF
  JPY
  AED
  CNY
  RUB
}

enum TwoFactorMethod {
  AUTHENTICATOR // TOTP uygulaması (Google Authenticator vb.)
  EMAIL // girişte e-postaya kod
}

model Category {
  id     String @id @default(cuid())
  /**
   * UNSPSC 8-haneli kod (10000000=segment, 10100000=family, 10101500=class, 10101501=commodity)
   */
  code   String @unique
  nameTr String
  /**
   * TR-katlanmış arama metni (foldSearchText(nameTr)) — 'İ'/aksan sorunsuz
   * substring arama için. Seed yazar; sorgu tarafı da aynı fold'dan geçer.
   */
  searchText String @default("")
  /**
   * Küratörlü eşanlamlı/jargon listesi (ör. "telfer caraskal" → vinç) —
   * kaynak: packages/db/src/seeds/category-keywords.tsv. searchText'e
   * katlanarak dahil edilir; arama yalnız searchText'ten yapılır.
   */
  keywords String @default("")
  /**
   * 1=Segment, 2=Family, 3=Class, 4=Commodity
   */
  level  Int

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")

  /**
   * Sadece level 1: PratisPro tarzı harf prefix (A, B, C...)
   */
  segmentLetter String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
  @@index([level, sortOrder])
  @@index([code])
  @@map("categories")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorType  String // "tenant" | "admin" | "supplier" | "system"
  actorId    String?
  actorEmail String?
  action     String // "auth.login", "auth.login_failed", "tender.awarded", ...
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@index([actorId])
  // Perf: admin liste varsayılan sıralaması (orderBy createdAt, filtresiz);
  // append-only yüksek hacim (INV-AUDIT-1 dalga 1+2).
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// Faz AI-0 — AI kullanım sayacı (append-only, AuditLog deseni).
// Bakiye TÜRETİLİR: SUM(costUsd) — stored bakiye/flag YOK (X7-drift önlemi).
// costUsd yazım anında fiyat-SNAPSHOT'ıdır (config fiyatı değişse geçmiş
// bozulmaz — award FX-damga deseniyle aynı). userEmail denormalize: kullanıcı
// silinse de kırılım okunabilir (actorEmail deseni). RLS policy BİLİNÇLİ yok
// (INV-MT-5 backstop listesine eklendi; reaper cron bypass gerektirirdi).
// ============================================================

enum AiUsageStatus {
  RESERVED // bütçeden tahmini tutar ayrıldı, sağlayıcı çağrısı sürüyor
  SETTLED // gerçek usage ile kapatıldı (costUsd = gerçek maliyet)
  FAILED // sağlayıcı hatası: costUsd=0 (token harcanmadı) veya tahmin (timeout, fail-closed)
}

model AiUsage {
  id               String        @id @default(cuid())
  companyId        String
  userId           String
  userEmail        String?
  feature          String // "test" | AI-1+: "pdf_form", "bid_compare", ...
  model            String
  status           AiUsageStatus @default(RESERVED)
  inputTokens      Int           @default(0)
  outputTokens     Int           @default(0)
  cacheReadTokens  Int           @default(0)
  cacheWriteTokens Int           @default(0)
  costUsd          Decimal       @db.Decimal(12, 6)
  errorCode        String?
  // AI-1+: özellik bağlamı (route: text|pdf_vision|image_vision, sayfa sayısı
  // vb.) — ölçüm/kalibrasyon için; PII/belge içeriği YAZILMAZ.
  metadata         Json?
  createdAt        DateTime      @default(now())
  settledAt        DateTime?

  @@index([companyId, createdAt])
  @@index([companyId, userId, createdAt])
  // Reaper: eski RESERVED taraması.
  @@index([status, createdAt])
  @@map("ai_usage")
}

// ============================================================
// Faz AI-2 — Asistan sohbeti (kalıcı, kullanıcıya scope'lu). Sohbet KVKK gereği
// 90 gün dokunulmazsa AiScheduler cron'u siler. RLS BİLİNÇLİ yok (userId+
// companyId scope servis içinde). Asistan araçları DB'ye DEĞİL sistemin okuma
// SERVİSLERİNE (kullanıcı kimliğiyle) gider → yetki katmanı bedava çalışır.
// ============================================================

enum AiChatRole {
  USER
  ASSISTANT
}

model AiChatSession {
  id                   String          @id @default(cuid())
  companyId            String
  userId               String
  title                String?
  /** Kayan pencere taşınca üretilen tek özet (maliyet kontrolü). */
  summary              String?
  /** Özetin hangi mesaj seq'ine kadar kapsadığı (tekrar özetleme önlenir). */
  summarizedThroughSeq Int             @default(0)
  /** Kullanıcı turu sayısı (tur sınırı önerisi + seq üretimi). */
  turnCount            Int             @default(0)
  /** Faz AI-3 — oturum boyunca biriken ihale taslağı (AiTenderDraft JSON);
   *  belge + konuşma birleşiminin tek kaynağı. Kullanıcı wizard'a taşıyınca kullanılır. */
  tenderDraft          Json?
  /**
   * Faz AI-4 — onay bekleyen aksiyon (tek kayıt; {id,type,params,summary,
   * severity,expiresAt}). Confirm/reject sonrası null'lanır.
   */
  pendingAction        Json?
  createdAt            DateTime        @default(now())
  lastMessageAt        DateTime        @default(now())
  archivedAt           DateTime?
  messages             AiChatMessage[]

  @@index([companyId, userId, lastMessageAt])
  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id        String        @id @default(cuid())
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /** Oturum içi sıra (1'den artan). */
  seq       Int
  role      AiChatRole
  content   String
  /** Asistan turunda kullanılan araç izleri (ad + özet) — teşhis/gösterim. */
  toolTrace Json?
  createdAt DateTime      @default(now())

  @@index([sessionId, seq])
  @@map("ai_chat_messages")
}

enum CompanyRole {
  SAHIP // firma sahibi — Yönetici ⊇ + billing/silme/devir. Firmada TEK kişi.
  YONETICI // hesap yönetimi: kullanıcı/rol, ayarlar, bağlantılar
  SATIN_ALMACI // alım operasyonu (🔵)
  SATISCI // satış operasyonu (🟢)
  ONAYLAYICI // onay zinciri
}

enum CompanyTier {
  STANDART // paketsiz-pasif: PUBLIC'i maskeli görür, teklif veremez; davet/bağlantı ihalesine teklif; dizinde görünmez
  BRONZ // tedarikçi paketi: dizinde görünür, davet gönderir, PUBLIC'e teklif verir
  SILVER // + satınalma paneli, ihale açma, rapor/şablon, onay-akışı, AI
  GOLD // + "Gold Üye" rozeti (eski PAKET buraya eşlendi)
}

model Company {
  id        String  @id @default(cuid())
  rothernId String? @unique // genel kimlik (Rothern ID) — keşfet/istek için
  slug      String? @unique // public profil URL'i (sadece PAKET)

  // Kimlik
  name        String // ticari ad
  legalName   String?
  companyType CompanyType?
  taxNumber   String?      @unique
  taxOffice   String?
  country     String       @default("TR")
  stateRegion String?

  // Adres (inline; ileride Address[] defteriyle zenginleşir)
  city         String?
  district     String?
  neighborhood String?
  addressLine  String?
  postalCode   String?

  // İletişim / fatura / kurumsal
  industry               String?
  website                String?
  billingTitle           String?
  billingEmail           String?
  billingPhone           String?
  billingPhoneVerifiedAt DateTime?
  authorizedTckn         String?
  authorizedTitle        String?
  mersisNo               String?
  tradeRegistryNo        String?
  kepAddress             String?
  iban                   String?
  ibanHolder             String?

  // Kategoriler — AYRI: ne alırım vs ne satarım
  buyerCategoryIds     String[] @default([])
  buyerSubCategoryIds  String[] @default([])
  sellerCategoryIds    String[] @default([])
  sellerSubCategoryIds String[] @default([])

  // Üyelik (koltuk yok; sınırsız kullanıcı)
  tier            CompanyTier @default(STANDART)
  membershipEndAt DateTime?

  // KYC / doğrulama
  companyVerificationStatus CompanyVerificationStatus @default(UNVERIFIED)
  companyVerifiedAt         DateTime?
  companyRejectionReason    String? // genel red özeti (REJECTED → firmaya gösterilir; belge bazlı gerekçe ayrıca)
  // Her belge: URL(key) + inceleme durumu + belge bazlı red gerekçesi.
  docTaxPlateUrl            String?
  docTaxPlateStatus        KycDocStatus @default(PENDING)
  docTaxPlateReason        String?
  docTradeRegistryUrl       String?
  docTradeRegistryStatus   KycDocStatus @default(PENDING)
  docTradeRegistryReason   String?
  docSignatureCircularUrl   String?
  docSignatureCircularStatus KycDocStatus @default(PENDING)
  docSignatureCircularReason String?
  docActivityCertUrl        String?
  docActivityCertStatus    KycDocStatus @default(PENDING)
  docActivityCertReason    String?
  docIdFrontUrl            String?
  docIdFrontStatus         KycDocStatus @default(PENDING)
  docIdFrontReason         String?
  docIdBackUrl             String?
  docIdBackStatus          KycDocStatus @default(PENDING)
  docIdBackReason          String?
  onboardingCompletedAt     DateTime?

  // Public profil (sadece PAKET görünür)
  publicEnabled     Boolean  @default(false)
  aboutText         String?
  logoUrl           String?
  coverImageUrl     String?
  linkedinUrl       String?
  instagramUrl      String?
  services          String[] @default([])
  photos            String[] @default([]) // herkese açık profil galeri görselleri
  certificateImages String[] @default([]) // sertifika belge/görselleri
  foundedYear       Int?
  employeeCount     String?
  certifications    String[] @default([])

  // Durum
  isActive      Boolean   @default(true)
  isBlocked     Boolean   @default(false)
  blockedReason String?
  blockedAt     DateTime?

  // Sahiplik — tekil firma sahibi (CompanyUser.id). Sahip ⊇ Yönetici.
  ownerUserId String?

  users                CompanyUser[]
  listings             Listing[]
  bidsPlaced           ListingBid[]              @relation("BidderCompany")
  connectionsInitiated CompanyConnection[]       @relation("ConnInviter")
  connectionsReceived  CompanyConnection[]       @relation("ConnInvitee")
  referralInvitesSent  CompanyReferralInvite[]   @relation("ReferralInviter")
  ordersAsSeller       CompanyOrder[]            @relation("OrderSeller")
  ordersAsBuyer        CompanyOrder[]            @relation("OrderBuyer")
  blocksMade           CompanyBlock[]            @relation("BlockMade")
  blockedByOthers      CompanyBlock[]            @relation("BlockedBy")
  complaintsMade       CompanyComplaint[]        @relation("ComplaintBy")
  complaintsReceived   CompanyComplaint[]        @relation("ComplaintAgainst")
  listingInvitations   ListingInvitation[]       @relation("ListingInvitee")
  listingTemplates     ListingTemplate[]
  supplierTemplates    SupplierTemplate[]
  threadsAsBuyer       MessageThread[]           @relation("ThreadBuyer")
  threadsAsSeller      MessageThread[]           @relation("ThreadSeller")
  messagesSent         Message[]                 @relation("MessageSender")
  questionTemplates    ListingQuestionTemplate[]
  approvalFlows        ApprovalFlow[]
  approvalRequests     ApprovalRequest[]
  userInvitations      CompanyUserInvitation[]
  addresses            CompanyAddress[]
  timeSavingsConfig    TimeSavingsConfig?
  bankAccounts         CompanyBankAccount[]
  membershipEvents     CompanyMembershipEvent[]
  adminNotes           CompanyAdminNote[]
  kycRevisions         CompanyKycRevision[]
  reviewsGiven         CompanyReview[]    @relation("ReviewsGiven")
  reviewsReceived      CompanyReview[]    @relation("ReviewsReceived")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier, isActive, country])
  // Perf: admin KYC kuyruğu (where companyVerificationStatus) + groupBy.
  @@index([companyVerificationStatus])
  @@map("companies")
}

/**
 * 1-1 mesajlaşma thread'i — her zaman bir ALICI ve bir SATICI firma arasında.
 * Bağımsız-per-portal: bir firma için buyer olduğu thread'ler Satınalma
 * inbox'ına, seller olduğu thread'ler Satış inbox'ına düşer. A→B (alış) ile
 * B→A (satış) ayrı thread'lerdir; bu yüzden iki portal birbirinden bağımsız.
 */
model MessageThread {
  id              String  @id @default(cuid())
  buyerCompanyId  String
  buyerCompany    Company @relation("ThreadBuyer", fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  sellerCompanyId String
  sellerCompany   Company @relation("ThreadSeller", fields: [sellerCompanyId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime?
  messages      Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerCompanyId, sellerCompanyId])
  // Perf: inbox (where OR[buyer,seller] orderBy lastMessageAt). FK-index'leri
  // sort kolonuyla GENİŞLETİLDİ (prefix eski point-lookup'ı karşılar).
  @@index([buyerCompanyId, lastMessageAt])
  @@index([sellerCompanyId, lastMessageAt])
  @@map("message_threads")
}

model Message {
  id              String        @id @default(cuid())
  threadId        String
  thread          MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderCompanyId String
  senderCompany   Company       @relation("MessageSender", fields: [senderCompanyId], references: [id], onDelete: Cascade)
  senderUserId    String? // CompanyUser.id — mesajı yazan kişi
  senderName      String // gönderim anındaki ad (denormalize, geçmiş korunur)
  body            String
  readAt          DateTime? // karşı taraf okuduğunda set edilir

  createdAt DateTime @default(now())

  @@index([threadId])
  @@map("messages")
}

// V2-3 — TCMB günlük gösterge kurları (cron ile fetch + upsert).
model ExchangeRate {
  id        String   @id @default(cuid())
  currency  Currency
  rate      Decimal  @db.Decimal(15, 6) // 1 {currency} = X TRY
  rateDate  DateTime @db.Date // TCMB tarihi (gün-bazlı)
  source    String   @default("TCMB") // TCMB | MANUAL | FALLBACK
  fetchedAt DateTime @default(now())

  @@unique([currency, rateDate])
  @@index([rateDate])
  @@map("exchange_rates")
}

/// Dahili admin notu — müşteri ASLA görmez ("aradı, X sözü verildi" kayıtları).
model CompanyAdminNote {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adminId   String // PlatformAdmin id
  body      String
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("company_admin_notes")
}

enum MembershipEventAction {
  GRANT // PAKET verildi (bitiş bugünden hesap)
  EXTEND // mevcut bitişe EK ay
  REVOKE // premium admin eliyle kaldırıldı
  EXPIRE // süre doldu (scheduler otomatik düşürdü)
}

/// Üyelik geçmişi — kim, ne zaman, kaç ay, hangi gerekçeyle (append-only).
/// Gelir/yenileme raporu ve destek çağrılarındaki "premium'um nereye gitti?"
/// sorusunun tek kaynağı.
model CompanyMembershipEvent {
  id        String                @id @default(cuid())
  companyId String
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action    MembershipEventAction
  months    Int?
  endBefore DateTime?
  endAfter  DateTime?
  reason    String?
  /// PlatformAdmin id — null = sistem (scheduler EXPIRE).
  adminId   String?
  createdAt DateTime              @default(now())

  @@index([companyId, createdAt])
  @@index([createdAt])
  @@map("company_membership_events")
}

enum ComplaintStatus {
  OPEN // yeni — admin incelemesi bekliyor
  RESOLVED // çözüldü, aksiyon alındı (örn. askı)
  DISMISSED // geçersiz/reddedildi
}

model CompanyComplaint {
  id                   String          @id @default(cuid())
  complainantCompanyId String
  complainant          Company         @relation("ComplaintBy", fields: [complainantCompanyId], references: [id], onDelete: Cascade)
  againstCompanyId     String
  against              Company         @relation("ComplaintAgainst", fields: [againstCompanyId], references: [id], onDelete: Cascade)
  reason               String // başlık/kategori
  detail               String?
  status               ComplaintStatus @default(OPEN)
  adminNote            String?
  createdById          String // CompanyUser
  resolvedAt           DateTime?
  resolvedByAdminId    String?
  createdAt            DateTime        @default(now())

  @@index([againstCompanyId])
  @@index([status])
  @@map("company_complaints")
}

enum ConnectionStatus {
  PENDING // davet gönderildi, kabul bekliyor
  ACTIVE // kabul edildi, bağlı
}

enum ConnectionOrigin {
  INVITE // davet-kabul / referans kodu — premium düşüşünde KALICI
  PREMIUM // premium keşif üzerinden — premium düşüşünde PASİFE alınır
  ADMIN // platform bağladı
}

model CompanyConnection {
  id               String  @id @default(cuid())
  inviterCompanyId String
  inviter          Company @relation("ConnInviter", fields: [inviterCompanyId], references: [id], onDelete: Cascade)
  inviteeCompanyId String
  invitee          Company @relation("ConnInvitee", fields: [inviteeCompanyId], references: [id], onDelete: Cascade)

  status      ConnectionStatus @default(PENDING)
  origin      ConnectionOrigin @default(INVITE)
  invitedById String // CompanyUser (daveti atan kişi)
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inviterCompanyId, inviteeCompanyId])
  @@index([inviteeCompanyId])
  @@map("company_connections")
}

enum ReferralInviteStatus {
  PENDING // davet gönderildi, hedef henüz kayıt olmadı
  ACCEPTED // hedef kayıt oldu → INVITE bağlantısı kuruldu
}

/**
 * Kayıtlı OLMAYAN firmayı e-posta + referans ile davet. Hedef bu e-posta ile
 * kayıt olunca otomatik INVITE (kalıcı) bağlantı kurulur. Kayıtlı firmalar
 * doğrudan connect-by-referral / Rothern ID ile bağlanır (bu model değil).
 */
model CompanyReferralInvite {
  id               String  @id @default(cuid())
  inviterCompanyId String
  inviter          Company @relation("ReferralInviter", fields: [inviterCompanyId], references: [id], onDelete: Cascade)
  email            String
  invitedById      String // daveti atan CompanyUser
  token            String  @unique @default(cuid())

  status            ReferralInviteStatus @default(PENDING)
  acceptedCompanyId String?
  acceptedAt        DateTime?
  /**
   * Dış davet ihale bağlamı: davet "X sizi Y ihalesine davet etti" olarak
   * gider; kayıt token'la tamamlanınca bağlantıya EK bu ihaleye davet yazılır.
   */
  listingId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inviterCompanyId, email])
  @@index([email])
  @@map("company_referral_invites")
}

/**
 * Dış davet opt-out — bu adrese bir daha davet e-postası GÖNDERİLMEZ
 * (e-postadaki tek tık linkiyle beslenir; ETK/İYS hijyeni + itibar koruması).
 */
model ReferralOptOut {
  email     String   @id
  createdAt DateTime @default(now())

  @@map("referral_opt_outs")
}

model CompanyBlock {
  id               String   @id @default(cuid())
  blockerCompanyId String
  blocker          Company  @relation("BlockMade", fields: [blockerCompanyId], references: [id], onDelete: Cascade)
  blockedCompanyId String
  blocked          Company  @relation("BlockedBy", fields: [blockedCompanyId], references: [id], onDelete: Cascade)
  reason           String?
  createdAt        DateTime @default(now())

  @@unique([blockerCompanyId, blockedCompanyId])
  @@index([blockedCompanyId])
  @@map("company_blocks")
}

enum ListingType {
  ALIM // alım ilanı (reverse — fiyat iner, en ucuz kazanır)
  SATIS // satış ilanı (forward — fiyat çıkar, en yüksek kazanır)
}

enum ListingBidStatus {
  DRAFT // taslak teklif — henüz gönderilmedi
  SUBMITTED
  WITHDRAWN
  WON
  AWARDED_PARTIAL // kalem-bazlı kazandırmada kısmen kazandı
  LOST
}

enum CompanyOrderStatus {
  PENDING // kazandırıldı, satıcı onayı bekliyor
  ACCEPTED // satıcı siparişi onayladı
  CREATED // (legacy) eski kayıtlar — yeni akışta PENDING ile başlar
  IN_DELIVERY // kargoda
  DELIVERED // teslim alındı
  COMPLETED // tamamlandı (ödeme + teslim)
  REJECTED // satıcı siparişi reddetti
  CANCELLED
  DISPUTED // A1 — satıcı iptal talebini alıcı reddetti; ihtilaflı (iki-yönlü çıkış açık)
}

enum CompanyOrderPaymentTiming {
  BEFORE_DELIVERY // ödeme teslimattan önce (satıcı onayından sonra açılır)
  AFTER_DELIVERY // ödeme teslimattan sonra (alıcı teslim aldıktan sonra açılır)
}

enum CompanyOrderPaymentStatus {
  AWAITING_CONFIRMATION // alıcı kaydetti, satıcı onayı bekliyor
  CONFIRMED // satıcı ödemeyi onayladı
  REJECTED // satıcı ödemeyi reddetti
}

enum CompanyDocType {
  DELIVERY // teslim belgesi — yurtiçi irsaliye / uluslararası konşimento (satıcı yükler)
  PAYMENT // ödeme dekontu (alıcı yükler)
  TEMINAT // teminat mektubu — teslim öncesi ödemede satıcı SİPARİŞ ONAYINDAN ÖNCE yükler
  LC // akreditif belgesi (küşat mektubu) — alıcı "Akreditif Açıldı" adımında yükler
  INVOICE // fatura belgesi — satıcı yükler (fatura no metadata'ya ek olarak PDF/görsel)
  PROFORMA // proforma fatura — satıcı yükler (ACCEPTED+); alıcı LC açmak/peşin ödemek için kullanır
  OTHER // diğer belgeler — her iki taraf, serbest ek belge (tek kutu)
}

model CompanyOrderDocument {
  id                  String         @id @default(cuid())
  orderId             String
  order               CompanyOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type                CompanyDocType
  key                 String // R2 object key
  fileName            String
  mimeType            String
  uploadedByCompanyId String
  createdAt           DateTime       @default(now())

  @@index([orderId])
  @@map("company_order_documents")
}

model CompanyOrder {
  id              String   @id @default(cuid())
  number          String?  @unique // ROT-ORD-NNNNNN (global sequence)
  // Bir ilandan kalem-bazlı kazandırmada birden çok sipariş çıkabilir → unique DEĞİL.
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  sellerCompanyId String
  // Restrict: bir firmanın siparişleri varken hard-delete engellenir — aksi
  // halde karşı taraf mevcut/ödemeli olsa bile finansal kayıt CASCADE ile
  // silinirdi. App zaten soft-delete kullanır (isActive/isBlocked/deletedAt).
  seller          Company  @relation("OrderSeller", fields: [sellerCompanyId], references: [id], onDelete: Restrict)
  buyerCompanyId  String
  buyer           Company  @relation("OrderBuyer", fields: [buyerCompanyId], references: [id], onDelete: Restrict)

  amount         Decimal                   @db.Decimal(18, 2)
  // Tutarın para birimi = KAZANAN TEKLİFİN birimi (çoklu-birim RFQ'da ilanın
  // ana biriminden farklı olabilir). Award anında yazılır; legacy → TRY.
  // Currency enum (String değil) — bid/approval/exchangeRate ile tutarlı,
  // DB-seviyesinde geçersiz değer ("try"/yazım hatası) engellenir.
  currency       Currency                  @default(TRY)
  status         CompanyOrderStatus        @default(PENDING)
  paymentTiming  CompanyOrderPaymentTiming @default(AFTER_DELIVERY)
  // Award anında ilandan snapshot — true ise satıcı onaydan önce teminat
  // mektubu yüklemek zorunda (accept guard'ı).
  requireGuaranteeLetter Boolean @default(false)
  // Award anında ilandan ödeme planı + teslim şekli snapshot'ı — ilan silinse
  // de (listing SetNull) sipariş kendi şartlarını bilir; Faz 3 adım motorunun
  // veri kaynağı. Legacy backfill: ilanı duranlar ilandan, öksüzler kendi
  // paymentTiming'inden (BEFORE→Peşin %100, AFTER→Açık Hesap).
  paymentCategory ListingPaymentCategory @default(OPEN_ACCOUNT)
  advancePercent  Int?
  paymentDays     Int?
  lcType          LcType?
  lcConfirmed     Boolean              @default(false)
  paymentNote     String?
  deliveryTerm    ListingDeliveryTerm?
  rejectedReason String?
  cancelReason   String?
  // Teslimat adresi snapshot'ı (award anında: ALIM→ilanın adresi, SATIS→kazanan
  // teklifin adresi). Adres defteri sonradan değişse de sipariş sabit kalır.
  // { title, contactName, phone, country, city, district, addressLine, postalCode }
  deliveryAddress Json?

  // ── Adım verileri (eski sistemle birebir) ──
  // KABUL (PENDING→ACCEPTED): satıcı tahmini teslim + banka + not girer.
  acceptedAt           DateTime?
  acceptedNote         String?
  bankAccountHolder    String?
  bankIban             String?
  expectedDeliveryDate DateTime?
  // AKREDİTİF adımları (paymentCategory=LETTER_OF_CREDIT, Faz 3): alıcı LC
  // açtırır (LC belgesi zorunlu) → satıcı kabul eder (gönderim kilidi açılır)
  // → satıcı "banka ödedi" der (sistem onaylı tam-tutar ödeme kaydı üretir).
  lcOpenedAt   DateTime?
  lcAcceptedAt DateTime?
  lcPaidAt     DateTime?
  // Vade hatırlatması idempotency (S7 cron): teslim + paymentDays yaklaşırken
  // alıcıya BİR KEZ bildirim.
  paymentDueReminderSentAt DateTime?
  // GÖNDER (ACCEPTED→IN_DELIVERY): satıcı fatura no (zorunlu) + gönderim notu.
  invoiceNumber        String?
  deliveryStartedAt    DateTime?
  deliveryNote         String?
  // TESLİM / TAMAMLA: alıcı teslim alır, tamamlar.
  deliveredAt          DateTime?
  completedAt          DateTime?
  completedNote        String?
  // Timeline için sonlandırma damgaları (sebepler ayrı alanlarda).
  rejectedAt           DateTime?
  cancelledAt          DateTime?
  // A1 — SATICI iptal talebi (yalnız ACCEPTED): satıcı çıkış talep eder, alıcı
  // onaylar (→CANCELLED) ya da reddeder (→DISPUTED). Açık talep işareti =
  // status===ACCEPTED && cancelRequestedAt!=null. Tam kanıt izi audit_logs'ta.
  cancelRequestedAt    DateTime?
  cancelRequestReason  String?
  cancelRequestById    String?
  // İhtilaf damgası (ACCEPTED→DISPUTED): saat durur, iki-yönlü çıkış açık.
  disputedAt           DateTime?
  // TTK 23 — ayıp ihbarı: alıcı teslimden sonra 8 gün içinde ayıp ihbar eder →
  // DISPUTED. defectNotifiedAt varlığı bu ihtilafı A1 (satıcı iptal talebi)
  // ihtilafından ayırır; disputePrevStatus geri çekmede önceki duruma (DELIVERED
  // veya COMPLETED) döndürür. Platform kaydeder; çözüm taraflar arasında.
  defectNotifiedAt     DateTime?
  defectReason         String?
  disputePrevStatus    CompanyOrderStatus?

  documents CompanyOrderDocument[]
  items     CompanyOrderItem[]
  payments  CompanyOrderPayment[]
  reviews   CompanyReview[]
  revisions OrderRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Perf: cron global-scan (where status) + dashboard/inbox per-firma status
  // filtreleri. FK-index'leri status'la GENİŞLETİLDİ (prefix eski kullanımı
  // karşılar → net yeni index yalnız [status]).
  @@index([status])
  @@index([sellerCompanyId, status])
  @@index([buyerCompanyId, status])
  @@index([listingId])
  @@map("company_orders")
}

enum OrderRevisionStatus {
  PENDING // satıcı önerdi, alıcı kararı bekleniyor
  APPROVED // alıcı onayladı → sipariş güncellendi
  REJECTED // alıcı reddetti (gerekçeli)
  CANCELLED // satıcı karar öncesi geri çekti
}

/**
 * Sipariş revizyonu — satıcı, ONAYLANMIŞ (ACCEPTED) siparişte kalem/teslim
 * tarihi değişikliği önerir, alıcı onaylar/reddeder (müzakere). Ayrı kayıt:
 * sipariş state machine'i tek-yönlü kalır, öneri snapshot + tur geçmişi burada
 * tutulur (CompanyOrderPayment deseniyle aynı). Onaylanınca CompanyOrder.amount/
 * expectedDeliveryDate + CompanyOrderItem satırları güncellenir.
 */
model OrderRevision {
  id                  String              @id @default(cuid())
  orderId             String
  order               CompanyOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Öneriyi yapan firma (satıcı) — audit; taraf servis seviyesinde doğrulanır.
  proposedByCompanyId String
  proposedByUserId    String?
  status              OrderRevisionStatus @default(PENDING)
  // Önerilen order-level değerler (snapshot). amount kalemlerden hesaplanır.
  amount               Decimal   @db.Decimal(18, 2)
  currency             Currency  @default(TRY)
  expectedDeliveryDate DateTime?
  note                 String? // satıcının revizyon açıklaması
  rejectReason         String? // alıcının ret gerekçesi
  decidedByUserId      String?
  decidedAt            DateTime?
  createdAt            DateTime  @default(now())

  items OrderRevisionItem[]

  @@index([orderId])
  @@map("order_revisions")
}

model OrderRevisionItem {
  id           String        @id @default(cuid())
  revisionId   String
  revision     OrderRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  name         String
  quantity     Decimal       @db.Decimal(18, 3)
  unit         String
  unitPrice    Decimal       @db.Decimal(18, 2)
  deliveryDate DateTime?
  note         String?

  @@index([revisionId])
  @@map("order_revision_items")
}

// Sipariş sonrası değerlendirme — alıcı, karşı tarafı (genelde satıcı) puanlar.
model CompanyReview {
  id                String       @id @default(cuid())
  orderId           String
  order             CompanyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewerCompanyId String
  reviewer          Company      @relation("ReviewsGiven", fields: [reviewerCompanyId], references: [id], onDelete: Cascade)
  targetCompanyId   String
  target            Company      @relation("ReviewsReceived", fields: [targetCompanyId], references: [id], onDelete: Cascade)
  rating            Int // 1-5 (servis doğrular)
  comment           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Çift yönlü: alıcı ve satıcı AYNI siparişte birbirini puanlar → sipariş
  // başına taraf-başına tek review (orderId tek başına unique DEĞİL).
  @@unique([orderId, reviewerCompanyId])
  @@index([targetCompanyId])
  @@map("company_reviews")
}

// Ödeme kaydı — alıcı kaydeder (manuel: havale/EFT vb.), satıcı onaylar/reddeder.
// Kısmi ödemeler mümkün; toplamlar (onaylı/bekleyen/kalan) UI'da hesaplanır.
model CompanyOrderPayment {
  id                  String                    @id @default(cuid())
  orderId             String
  order               CompanyOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount              Decimal                   @db.Decimal(18, 2)
  method              String? // "Havale/EFT", "Nakit", "Çek" vb. — serbest metin
  note                String?
  status              CompanyOrderPaymentStatus @default(AWAITING_CONFIRMATION)
  rejectReason        String?
  recordedByCompanyId String // ödemeyi kaydeden firma (alıcı)
  recordedByUserId    String?
  confirmedAt         DateTime?
  createdAt           DateTime                  @default(now())
  // Çek ödemesi detayları (method "Çek" ise doldurulur)
  chequeNo            String?
  chequeBank          String?
  chequeDueDate       DateTime?

  @@index([orderId])
  @@map("company_order_payments")
}

// Sipariş kalemi — kazandırma anındaki snapshot (ad/miktar/birim fiyat).
model CompanyOrderItem {
  id        String       @id @default(cuid())
  orderId   String
  order     CompanyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  quantity  Decimal      @db.Decimal(18, 3)
  unit      String
  unitPrice Decimal      @db.Decimal(18, 2)
  // Kalem-özel teslim tarihi — award anında kazanan teklifin kalem tarihinden
  // (ListingBidItem.deliveryDate) snapshot'lanır; boşsa order-level
  // expectedDeliveryDate geçerli. Kalem notu da teklifin kalem notundan gelir.
  deliveryDate DateTime?
  // Teslim SÜRESİ snapshot'ı (2026-08-02) — kazanan teklifin kalem süresi,
  // yoksa teklifin genel süresi award anında kopyalanır.
  deliveryTime BidDeliveryTime?
  note         String?

  @@index([orderId])
  @@map("company_order_items")
}

model ListingBid {
  id              String  @id @default(cuid())
  listingId       String
  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderCompanyId String
  bidderCompany   Company @relation("BidderCompany", fields: [bidderCompanyId], references: [id], onDelete: Cascade)

  // Toplam tutar (tek-tutar teklif VEYA kalem teklifleri toplamı).
  amount      Decimal          @db.Decimal(18, 2)
  currency    Currency         @default(TRY)
  note        String?
  // Hemen-Al ile verilen teklif (tavan fiyattan). Yine de sahip onaylar.
  isBuyNow    Boolean          @default(false)
  status      ListingBidStatus @default(SUBMITTED)
  round       Int              @default(1) // hangi turda verildi/güncellendi
  // Pazarlıkta AKTİF gönderimin yapıldığı tur — "turda tek teklif" hakkı bunu
  // sayar. Yeni-tur taşıması (carry-over) round'u ilerletir ama BUNA dokunmaz:
  // taşınan teklif hak yakmaz. NULL = kural öncesi legacy / hiç aktif gönderim.
  activeBidRound Int?
  createdById String // CompanyUser (teklifi veren kişi)

  // Zenginleştirme (eski Bid ile paralel).
  version              Int       @default(1) // taslak güncellemede artar
  submittedAt          DateTime? // SUBMITTED'a geçiş anı
  // ALIM: satıcının taahhüt ettiği teslim tarihi. SATIS: alıcının İSTEDİĞİ
  // teslim tarihi. LEGACY (2026-08-02'den önce) — yeni teklifler süre girer.
  deliveryDate         DateTime?
  // Teslim SÜRESİ (2026-08-02): tarih yerine merdiven (stoktan/1-2 hafta/…).
  // Gönderimde zorunlu (kalemlerin tamamı kendi süresini taşımıyorsa).
  deliveryTime         BidDeliveryTime?
  validityDays         Int? // teklif geçerlilik süresi (gönderimde zorunlu)
  exchangeRateSnapshot Decimal?  @db.Decimal(18, 6) // TRY dışı teklifte TCMB kuru
  eliminationReason    String? // alıcı eleme sebebi
  eliminatedAt         DateTime?

  // SATIS: alıcının teslimat adresi (kendi adres defterinden). Adrese-teslim
  // şartlarında (DOMESTIC_DELIVERED/ON_VEHICLE/CARRIER_COLLECT, DAP/DPU/DDP)
  // gönderimde zorunlu; award anında siparişe snapshot'lanır.
  deliveryAddressId String?
  deliveryAddress   CompanyAddress? @relation("BidDeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull)

  items     ListingBidItem[]
  documents ListingBidDocument[]
  answers   ListingBidAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, bidderCompanyId])
  @@index([listingId])
  // Perf: "tekliflerim" (where bidderCompanyId,status). FK-index GENİŞLETİLDİ
  // (yazma-yoğun tablo → yeni index yerine mevcudu genişlet).
  @@index([bidderCompanyId, status])
  @@index([listingId, status])
  @@map("listing_bids")
}

// Teklif belgesi — tedarikçinin teklifine eklediği dosya (R2 key).
// Teklif belgesi bölümü — tedarikçi/alıcı yüklerken kategoriye ayırır.
enum ListingBidDocKind {
  TEKLIF_MEKTUBU // teklif mektubu / kapak
  TEKNIK_DOKUMAN // teknik doküman / şartname yanıtı
  REFERANS // referans / iş bitirme
  KATALOG // katalog / ürün broşürü
  TEMINAT // teminat mektubu (teslim öncesi ödemede)
  DIGER // diğer
}

model ListingBidDocument {
  id                  String            @id @default(cuid())
  bidId               String
  bid                 ListingBid        @relation(fields: [bidId], references: [id], onDelete: Cascade)
  kind                ListingBidDocKind @default(DIGER)
  key                 String // R2 object key
  fileName            String
  mimeType            String
  uploadedByCompanyId String
  createdAt           DateTime          @default(now())

  @@index([bidId])
  @@map("listing_bid_documents")
}

// İngiliz Usulü tur geçmişi — yeni tur başlarken o anki tekliflerin snapshot'ı.
model ListingRoundSnapshot {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  round      Int
  bidderName String
  amount     Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  @@index([listingId])
  @@map("listing_round_snapshots")
}

// İhale dosyası bölümü — sahip yüklerken kategoriye ayırır.
enum ListingDocKind {
  IDARI_SARTNAME // idari şartname
  TEKNIK_SARTNAME // teknik şartname
  SOZLESME // sözleşme taslağı
  EK // ek / çizim
  NUMUNE // numune / görsel
  DIGER // diğer
}

// İhale dosyası — sahip yükler (şartname/teknik resim); görünür firmalar indirir.
model ListingDocument {
  id                  String         @id @default(cuid())
  listingId           String
  listing             Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  kind                ListingDocKind @default(DIGER)
  key                 String // R2 object key
  fileName            String
  mimeType            String
  uploadedByCompanyId String
  createdAt           DateTime       @default(now())

  @@index([listingId])
  @@map("listing_documents")
}

// Teklif teslim süresi merdiveni (2026-08-02) — teklifte tarih yerine süre
// seçilir; @rothern/shared BID_DELIVERY_TIMES ile birebir.
enum BidDeliveryTime {
  STOKTAN // stokta — hemen teslim
  W1_2 // 1-2 hafta
  W3_4 // 3-4 hafta
  W5_8 // 5-8 hafta
  M2_3 // 2-3 ay
  M3_PLUS // 3 aydan uzun
}

enum ListingPriceScope {
  TOPLU // ilan geneli tek taban + tek hemen-al
  KALEM // kalem başına taban/hemen-al birim fiyatlar
}

enum ListingStatus {
  DRAFT // taslak — düzenlenebilir, yayınlanmadı
  IN_APPROVAL // yayın onayı bekliyor (onay akışı varsa)
  OPEN // açık — teklif alınıyor
  CLOSED // yalnız ADMIN moderasyon kapatması (2026-07-13: normal kapanış doğrudan IN_AWARD; admin reopen ile açılır)
  IN_AWARD // değerlendirmede — teklif alımı kapandı (süre doldu / Değerlendirmeye Al), alıcı karar veriyor
  IN_AWARD_APPROVAL // kazandırma onayı bekliyor (onay akışı varsa)
  AWARDED // kazandırıldı, sipariş(ler) oluştu
  CLOSED_NO_AWARD // kazanan olmadan kapatıldı
  CANCELLED // iptal
}

enum ListingVisibility {
  PUBLIC // herkese açık — standart MASKELİ görür, premium tam
  CONNECTIONS // sadece bağlantılı firmalar
  PRIVATE // sadece açıkça davet edilenler (ileride)
}

enum ListingFormat {
  RFQ // kapalı zarf teklif toplama (ALIM)
  ENGLISH_AUCTION // İngiliz usulü açık eksiltme (ALIM)
}

// Teslim şekli (Incoterms + yurtiçi).
// Yurtiçi merdiveni (satıcı sorumluluğu artan sırada, EXW→DDP karşılığı):
// PICKUP → CARRIER_COLLECT → ON_VEHICLE → DELIVERED.
enum ListingDeliveryTerm {
  DOMESTIC_DELIVERED // yurtiçi adrese teslim — indirilmiş, nakliye satıcıya
  DOMESTIC_PICKUP // yurtiçi yerinden teslim — alıcı kendisi alır
  DOMESTIC_CARRIER_COLLECT // ambar/kargoya teslim — nakliye alıcıya (karşı ödemeli)
  DOMESTIC_ON_VEHICLE // adrese teslim araç üstü — nakliye satıcıya, indirme alıcıya
  EXW
  FCA
  CPT
  CIP
  DAP
  DPU
  DDP
  FAS
  FOB
  CFR
  CIF
}

// Ödeme şekli — ihale şartı olarak ilan sahibi belirler. Sipariş zamanlaması
// (paymentTiming) bu plandan TÜRETİLİR, kullanıcıya ayrıca sorulmaz (Faz 2).
enum ListingPaymentCategory {
  ADVANCE // peşin (+advancePercent; %100 = tam peşin, %<100 YALNIZ yurtiçi)
  DEFERRED // vadeli — teslimden paymentDays gün sonra (sabit vade ZORUNLU)
  OPEN_ACCOUNT // açık hesap — teslim sonrası, vadesiz (güven ilişkisi)
  MAL_MUKABILI // mal mukabili — malı teslim alınca öde; vade OPSİYONEL (dış ticaret usulü)
  CHEQUE // çek — vade = paymentDays
  SENET // senet/bono — vade = paymentDays (yurtiçi kıymetli evrak)
  LETTER_OF_CREDIT // akreditif — lcType (+USANCE'ta vade = paymentDays)
  CASH_AGAINST_DOCS // vesaik mukabili — belge karşılığı ödeme (dış ticaret)
  CUSTOM // özel — paymentNote zorunlu
}

// Akreditif alt tipi (ödeme zamanına göre). Devredilebilir/rotatif gibi
// yapısal türler ayrı alan DEĞİL — gerekirse paymentNote'a yazılır.
enum LcType {
  SIGHT // görüldüğünde ödemeli
  USANCE // vadeli — belge ibrazından paymentDays gün sonra
}

enum ListingPaymentTiming {
  BEFORE_DELIVERY
  AFTER_DELIVERY
}

// İngiliz Usulü — teklif görünürlüğü.
enum ListingBidVisibility {
  OWN_ONLY
  BEST_PRICE
  OWN_RANK
  BEST_AND_OWN_RANK
  ALL
}

enum ListingQuestionAnswerType {
  TEXT
  NUMBER
  YES_NO
  DATE
}

model Listing {
  id                    String            @id @default(cuid())
  // SİSTEM GENELİNDE benzersiz ilan numarası (ROT-NNNNNN). Global Postgres
  // sequence'tan üretilir → A ve B firmasının ilanı asla aynı numarayı almaz.
  // Sıra büyüdükçe hane sayısı kendiliğinden artar (çok-haneli destek).
  number                String?           @unique
  companyId             String // açan firma
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type                  ListingType
  // Yurtiçi (false) / Uluslararası (true).
  isInternational       Boolean           @default(false)
  // Sınır ötesi hedef ülkeler (ISO kodları). Boş + isInternational=true =
  // tüm yabancı ülkeler; dolu = yalnızca listelenen ülkeler görür.
  targetCountries       String[]          @default([])
  // ALIM için format (RFQ/İngiliz Usulü). SATIS'ta null (her zaman forward).
  format                ListingFormat?
  visibility            ListingVisibility @default(CONNECTIONS)
  // Kalem "hedef/istenen birim fiyat"ı (targetPrice) teklif verebilen karşı
  // tarafa gösterilsin mi? Varsayılan GİZLİ (opt-in) — açık göstermek fiyat
  // çıpalaması yaratır; sahip bilerek bütçe paylaşmak isterse açar.
  showTargetToSuppliers Boolean           @default(false)
  title                 String
  description           String?
  // SATIS fiyatlandırma kapsamı: TOPLU (ilan geneli taban/hemen-al) veya
  // KALEM (her kalemin kendi minUnitPrice/buyNowUnitPrice'ı). null = TOPLU
  // (legacy). ALIM'da anlamsız.
  priceScope            ListingPriceScope?
  // SATIS + TOPLU için: taban (min) fiyat + hemen-al fiyatı.
  minPrice              Decimal?          @db.Decimal(18, 2)
  buyNowPrice           Decimal?          @db.Decimal(18, 2)
  status                ListingStatus     @default(OPEN)
  closesAt              DateTime?
  cancelReason          String? // iptal/kazansız-kapatma gerekçesi
  // Teslimat/fatura adresi — CompanyAddress id (firma adres defterinden seçilir).
  deliveryAddressId     String?
  billingAddressId      String?
  createdById           String // CompanyUser id (açan kişi)
  // Yaşam döngüsü damgaları (eski Tender ile paralel).
  publishedAt           DateTime? // OPEN'a geçiş anı
  awardedAt             DateTime? // AWARDED anı
  closingReminderSentAt DateTime? // kapanış hatırlatma idempotency
  // Değerlendirme (IN_AWARD) uzarken "teklif geçerlilikleri dolmak üzere"
  // sahip hatırlatması idempotency damgası (cron bir kez gönderir).
  evaluationReminderSentAt DateTime?
  // İngiliz Usulü çok-turlu eksiltme — alıcı tur tur ilerletir (eski yeni-tur).
  currentRound          Int               @default(1)

  // İhale (ALIM) zenginleştirme — eski alıcı paneli kuralları.
  categoryIds        String[]   @default([]) // UNGM UNSPSC TR kategori kodları
  keywords           String[]   @default([]) // 0-10 arama/eşleştirme etiketi
  terms              String? // şartlar ve koşullar
  internalNotes      String? // yalnızca açan firma görür
  requireAllItems    Boolean    @default(false) // tüm kalemlere teklif zorunlu mu
  requireBidDocument Boolean    @default(false) // teklifte belge zorunlu mu
  primaryCurrency    Currency   @default(TRY)
  allowedCurrencies  Currency[] @default([])

  // Wizard zenginleştirme (eski tender wizard birebir) — hepsi opsiyonel/default.
  isSealedBid   Boolean              @default(true) // kapalı zarf
  isLogistics   Boolean              @default(false) // lojistik ihalesi katmanı
  logistics     Json? // taşıma modu/adres/kargo/ağırlık vb. (LogisticsFormData)
  deliveryTerm  ListingDeliveryTerm?
  // Ödeme planı — kategori + kategoriye göre koşullu alanlar. paymentDays tek
  // "vade günü" alanıdır: DEFERRED/CHEQUE vadesi, LC-USANCE vadesi ve kısmi
  // peşinde kalan tutarın vadesi (opsiyonel).
  paymentCategory ListingPaymentCategory @default(OPEN_ACCOUNT)
  advancePercent  Int? // yalnız ADVANCE (1-100); uluslararası ilanda hep 100
  paymentDays     Int?
  lcType          LcType? // yalnız LETTER_OF_CREDIT
  lcConfirmed     Boolean @default(false) // teyitli akreditif
  paymentNote     String? // serbest ödeme şartı notu — CUSTOM'da zorunlu
  // TÜRETİLMİŞ zamanlama (kullanıcıya sorulmaz): ADVANCE/LC → BEFORE_DELIVERY,
  // diğerleri → AFTER_DELIVERY (derivePaymentTiming, @rothern/shared). Belge
  // pencereleri/complete kapısı bunu okumaya devam eder (Faz 3'e köprü).
  paymentTiming ListingPaymentTiming @default(AFTER_DELIVERY)
  // Teslim öncesi ödemede satıcıdan teminat mektubu istensin mi? İlan sahibi
  // seçer (BEFORE_DELIVERY'de sistem önerir); yalnız BEFORE_DELIVERY'de anlamlı.
  requireGuaranteeLetter Boolean @default(false)
  bidsOpenAt    DateTime?
  // Açılış duyurusu damgası — gelecek-tarihli açılışta (embargo) ilan sahibi
  // dışında kimse İLANI GÖREMEZ ve yayın bildirimleri açılış anına ertelenir;
  // duyuruyu yapan (publish ya da açılış cron'u) bu alanı damgalar.
  openNotifiedAt DateTime?

  // İngiliz Usulü açık eksiltme ayarları.
  bidVisibility          ListingBidVisibility   @default(OWN_ONLY)
  decimalPlaces          Int                    @default(2)
  sendClosingReminder    Boolean                @default(false)
  reminderMinutesBefore  Int?
  autoExtendOnLateBid    Boolean                @default(false)
  autoExtendThresholdMin Int?
  autoExtendByMinutes    Int?
  // Açık eksiltme/artırma kur damgası — { "USD": 46.89, ... } (birim başına TRY,
  // TRY=1). Tur açılış günü TCMB kurundan bir kez yazılır ve ihale boyunca
  // sabittir: azaltma payının teklifçi birimine çevrimi ve birimler-arası
  // en-iyi/sıralama kıyasları hep bu damgayla yapılır (kur oynasa da adil).
  auctionRateSnapshot    Json?

  bids             ListingBid[]
  orders           CompanyOrder[]
  items            ListingItem[]
  invitations      ListingInvitation[]
  documents        ListingDocument[]
  roundSnapshots   ListingRoundSnapshot[]
  approvalRequests ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  // Perf: keşif açık-feed (where status=OPEN orderBy closesAt) + dashboard
  // (where companyId,type,status). Mevcut [status] ve [companyId,type]
  // GENİŞLETİLDİ (prefix eski kullanımı karşılar).
  @@index([status, closesAt])
  @@index([companyId, type, status])
  @@map("listings")
}

// İhale şablonu — wizard yapılandırmasını kaydet/kopyala (eski TenderTemplate).
model ListingTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  payload     Json // wizard config snapshot (başlık/format/kalemler/keywords/…)
  createdById String
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@map("listing_templates")
}

// Tedarikçi şablonu — sık birlikte davet edilen bağlı firma grubu (ihale
// sihirbazında tek tıkla davet). Üyeler bağlı firma id'leri (denormalize).
model SupplierTemplate {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  isPublic         Boolean  @default(true) // firmadaki herkes görebilir
  createdById      String
  memberCompanyIds String[] @default([]) // bağlı firma id'leri
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
  @@map("supplier_templates")
}

// İhale kalemi — bir ilanda birden çok satır (eski TenderItem).
model ListingItem {
  id              String    @id @default(cuid())
  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  lineNo          Int // sıra (1..n)
  name            String
  description     String?
  quantity        Decimal   @db.Decimal(18, 3)
  unit            String // adet, kg, m, paket…
  targetPrice     Decimal?  @db.Decimal(18, 2) // hedef birim fiyat (opsiyonel)
  // SATIS + kalem-bazlı fiyatlandırma: kalem taban / hemen-al BİRİM fiyatları.
  minUnitPrice    Decimal?  @db.Decimal(18, 2)
  buyNowUnitPrice Decimal?  @db.Decimal(18, 2)
  materialCode    String? // malzeme/stok kodu
  requiredByDate  DateTime? // istenen teslim tarihi
  awardedQuantity Decimal?  @db.Decimal(18, 3) // kısmi kazandırmada verilen miktar

  bidItems  ListingBidItem[]
  questions ListingItemQuestion[]

  createdAt DateTime @default(now())

  @@index([listingId])
  @@map("listing_items")
}

// Kalem başına tipli soru (eski item-question modal) — tedarikçi teklif verirken cevaplar.
model ListingItemQuestion {
  id         String                    @id @default(cuid())
  itemId     String
  item       ListingItem               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text       String
  answerType ListingQuestionAnswerType @default(TEXT)
  required   Boolean                   @default(false)

  createdAt DateTime @default(now())

  answers ListingBidAnswer[]

  @@index([itemId])
  @@map("listing_item_questions")
}

// Teklifin kalem sorusuna verdiği cevap (satıcı tarafı — Faz D).
model ListingBidAnswer {
  id         String              @id @default(cuid())
  bidId      String
  bid        ListingBid          @relation(fields: [bidId], references: [id], onDelete: Cascade)
  questionId String
  question   ListingItemQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String

  createdAt DateTime @default(now())

  @@unique([bidId, questionId])
  @@index([bidId])
  @@map("listing_bid_answers")
}

// Kayıtlı soru şablonu — firma kalem sorularını tekrar kullanmak için saklar.
model ListingQuestionTemplate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  items     Json // [{ text, answerType, required }]

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("listing_question_templates")
}

// İhale daveti — belirli bağlı tedarikçiyi ihaleye davet (eski TenderInvitation).
model ListingInvitation {
  id               String   @id @default(cuid())
  listingId        String
  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  invitedCompanyId String
  invitedCompany   Company  @relation("ListingInvitee", fields: [invitedCompanyId], references: [id], onDelete: Cascade)
  invitedById      String // CompanyUser (daveti gönderen)
  createdAt        DateTime @default(now())

  @@unique([listingId, invitedCompanyId])
  @@index([invitedCompanyId])
  @@map("listing_invitations")
}

// Kalem-bazlı teklif satırı — bir teklifin her kaleme verdiği birim fiyat.
model ListingBidItem {
  id        String      @id @default(cuid())
  bidId     String
  bid       ListingBid  @relation(fields: [bidId], references: [id], onDelete: Cascade)
  itemId    String
  item      ListingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitPrice Decimal     @db.Decimal(18, 2)
  note      String?
  // Kalem-özel teslim tarihi — LEGACY (2026-08-02'den önce); yeni teklifler süre girer.
  deliveryDate DateTime?
  // Kalem-özel teslim SÜRESİ (opsiyonel) — boşsa teklifin genel süresi geçerli.
  deliveryTime BidDeliveryTime?
  // Kalem para birimi (madde 9, 2026-08-02) — null = teklifin ana birimi.
  // Yalnız kapalı zarf ALIM ihalelerinde; award'da para birimi başına ayrı sipariş.
  currency Currency?
  // Kalem birimi → teklifin ana birimi çevrim damgası (submit anı, TCMB çaprazı).
  // null = 1 (aynı birim). S5 nöbetçisi bid.amount'u AYNI damgayla yeniden hesaplar.
  fxToBase Decimal? @db.Decimal(18, 6)

  @@unique([bidId, itemId])
  @@index([bidId])
  @@map("listing_bid_items")
}

model CompanyUser {
  id        String  @id @default(cuid())
  email     String  @unique
  authId    String? @unique // Supabase auth bridge
  firstName String
  lastName  String
  phone     String?

  roles CompanyRole[] @default([])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  isActive            Boolean   @default(true)
  emailVerifiedAt     DateTime?
  twoFactorEnabled    Boolean   @default(false)
  twoFactorEnabledAt  DateTime?
  // 2FA yöntemi: AUTHENTICATOR (TOTP uygulaması) veya EMAIL (girişte e-postaya kod).
  twoFactorMethod     TwoFactorMethod @default(AUTHENTICATOR)
  twoFactorSecret     String? // TOTP secret (base32) — AUTHENTICATOR yönteminde dolu
  // Kurtarma kodları (SHA-256 hash) — enable'da üretilir, BİR KEZ gösterilir;
  // her kod tek kullanımlık (girişte/kapatmada tüketilir).
  twoFactorRecoveryCodes String[] @default([])
  // Oturum sürümü — parola değişince artar; eski JWT'ler geçersizleşir
  // (strategy her istekte DB'den doğrular).
  tokenVersion Int @default(0)
  permissionsOverride Json? // { added?: string[], removed?: string[] }
  notificationPrefs   Json?
  invitedById         String?
  invitedAt           DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime? // iş çıkışı — soft delete (geçmiş korunur, KVKK)

  // Kayıt sözleşme/rıza kayıtları (KVKK denetim izi).
  termsAcceptedAt          DateTime? // kullanıcı sözleşmesi
  mediationAcceptedAt      DateTime? // platform aracılık ve kullanım sözleşmesi
  kvkkAcceptedAt           DateTime? // KVKK aydınlatma bilgilendirmesi
  marketingConsent         Boolean   @default(false) // pazarlama/analitik (ticari ileti)
  profileImprovementConsent Boolean  @default(false) // profil/hizmet iyileştirme

  passwordResetTokens   PasswordResetToken[]
  emailVerificationCodes EmailVerificationCode[]
  notifications         Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("company_users")
}

enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

/**
 * Token'lı kullanıcı daveti — hesap davet KABULÜNDE açılır (KVKK/consent:
 * kullanıcı adını/parolasını kendisi belirler, sözleşmeleri kendisi onaylar).
 * TTL 7 gün; süre dolunca okuma anında EXPIRED'a çekilir.
 */
model CompanyUserInvitation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email  String
  roles  CompanyRole[]           @default([])
  token  String                  @unique // crypto.randomBytes(32).hex — kabul linki
  status CompanyInvitationStatus @default(PENDING)

  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([email, status])
  @@map("company_user_invitations")
}

/**
 * Uygulama-içi bildirim (e-postaya ek). KULLANICI bazında — her aktif kullanıcı
 * kendi zilini/okundu durumunu görür. Bir firmaya bildirim = firmanın aktif
 * kullanıcılarına fan-out (tercihine göre filtrelenir). type, notification-prefs
 * anahtarına eşlenir (kapatılabilir olanlar pref'e saygı duyar).
 */
model Notification {
  id            String   @id @default(cuid())
  companyUserId String
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  companyId     String // denormalize — firma kapsamı/temizlik için

  type     String // ör. listing_category_match, listing_invitation, bid_awarded
  // Bildirim hangi portala ait: "satinalma" | "satis" | null (ortak — bağlantı
  // gibi). Zil/sayaç AKTİF portalı (+ ortak) gösterir; satış bildirimi saf
  // satın almacıya HİÇ oluşturulmaz (alıcı filtresi üretim anında uygular).
  portal   String?
  title    String
  body     String
  ctaUrl   String?
  ctaLabel String?
  listingId String? // bağlam referansı (opsiyonel)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyUserId, portal, readAt])
  @@index([companyUserId, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────
// Onay akışı (eski tenant-approval sisteminin birleşik Company karşılığı).
// Firma, ilan YAYIN ve KAZANDIRMA için çok-adımlı sıralı onay zinciri tanımlar.
// ─────────────────────────────────────────────────────────────────────────

enum ApprovalType {
  LISTING_PUBLISH // ilan yayını onayı
  LISTING_AWARD // kazandırma onayı
}

enum ApprovalFlowStatus {
  DRAFT // taslak — devrede değil
  ACTIVE // devrede
  PASSIVE // pasife alındı
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStepStatus {
  WAITING // sırası gelmedi
  PENDING // sırası geldi, onaycı bekleniyor
  APPROVED
  REJECTED
  SKIPPED // bütçe eşiği altı — atlandı
}

// Firma genelinde tanımlı onay kuralı (ALIM + SATIS).
model ApprovalFlow {
  id             String             @id @default(cuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  type           ApprovalType
  status         ApprovalFlowStatus @default(DRAFT)
  // Sadece bu ilan tipine uygulanır (null = her ikisi).
  listingType    ListingType?
  // Bu akışı başlatabilen roller (boşsa kısıt yok).
  initiatorRoles CompanyRole[]      @default([])
  steps          ApprovalFlowStep[]
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([companyId, type, status])
  @@map("approval_flows")
}

// Akıştaki sıralı bir onay adımı.
model ApprovalFlowStep {
  id                 String       @id @default(cuid())
  flowId             String
  flow               ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  order              Int // 1..n
  approverUserId     String // onaylayacak CompanyUser id
  // Diagramda gösterilen yumuşak etiket (örn. "Satınalma Müdürü").
  displayLabel       String?
  // Bu eşik ALTINDAysa adım atlanır (SKIPPED). null = her zaman gerekli.
  conditionMinAmount Decimal?     @db.Decimal(18, 2)
  createdAt          DateTime     @default(now())

  @@unique([flowId, order])
  @@index([flowId])
  @@map("approval_flow_steps")
}

// Çalışma anı onay isteği (ilan yayın/kazandırma anında oluşur).
model ApprovalRequest {
  id          String                @id @default(cuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listingId   String
  listing     Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type        ApprovalType
  status      ApprovalRequestStatus @default(PENDING)
  // İnsan-okur onay numarası: APR-YYYY-NNNN (firma bazında benzersiz).
  requestNo   String?
  amount      Decimal               @db.Decimal(18, 2) // snapshot (kural sonradan değişse de bağımsız)
  currency    Currency              @default(TRY)
  // Onaylanınca tetiklenecek işlemin verisi (örn. kazandırma seçimleri).
  payload     Json?
  // Başlatanın onaycılara notu (yayın/kazandırma anında girilir).
  initiatorNote String?
  steps       ApprovalRequestStep[]
  createdById String
  decidedAt   DateTime?
  // Bekleyen onay hatırlatması — günde-bir-kez dedup için son gönderim damgası.
  lastReminderAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([companyId, requestNo])
  @@index([companyId, status, type])
  @@index([listingId])
  @@map("approval_requests")
}

// İstek başına sıralı onay adımı.
model ApprovalRequestStep {
  id             String             @id @default(cuid())
  requestId      String
  request        ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order          Int
  approverUserId String
  // Akış adımından snapshot — kural sonradan değişse de görünen etiket sabit.
  displayLabel   String?
  status         ApprovalStepStatus @default(WAITING)
  note           String?
  decidedAt      DateTime?
  createdAt      DateTime           @default(now())

  @@unique([requestId, order])
  @@index([approverUserId, status])
  @@map("approval_request_steps")
}

// ─────────────────────────────────────────────────────────────────────────
// Adres defteri (eski firma-tercihleri) — FATURA / TESLIMAT adresleri.
// İhale wizard'ında fatura/teslimat adresi seçimine bağlanabilir.
// ─────────────────────────────────────────────────────────────────────────

enum CompanyAddressType {
  FATURA
  ILETISIM
  TESLIMAT
}

// Banka hesabı defteri — sipariş kabulünde IBAN elle yazılmaz, buradan seçilir
// (adres defteri deseni). Tek varsayılan hesap.
model CompanyBankAccount {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String // "TL Vadesiz — İş Bankası" vb.
  accountHolder String
  iban          String
  bankName      String?
  isDefault     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("company_bank_accounts")
}

/**
 * KYC A-modeli (Faz Y) — VERIFIED firmanın belge GÜNCELLEMESİ: firma VERIFIED
 * kalır, yeni belge burada PENDING bekler; admin onaylarsa key Company doc
 * kolonuna kopyalanır, reddederse ESKİ belge geçerliliğini korur. Kind başına
 * TEK bekleyen revizyon (kısmi unique index — migration'da elle, Prisma
 * partial index desteklemez).
 */
model CompanyKycRevision {
  id                String       @id @default(cuid())
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind              String // DocKind: taxPlate|tradeRegistry|signatureCircular|activityCert|idFront|idBack
  key               String // R2 private object key (public URL değil)
  status            KycDocStatus @default(PENDING)
  reason            String? // ret gerekçesi (REJECTED'da zorunlu — servis kuralı)
  submittedById     String?
  reviewedByAdminId String?
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([status, createdAt]) // admin kuyruğu (bekleyen revizyonlar)
  @@map("company_kyc_revisions")
}

model CompanyAddress {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        CompanyAddressType
  title       String // "Merkez", "Depo", "Şube" vb.
  contactName String?
  phone       String?
  country     String             @default("TR")
  city        String?
  district    String?
  addressLine String
  postalCode  String?
  // FATURA adresi için vergi bilgisi (opsiyonel).
  taxOffice   String?
  taxNumber   String?
  isDefault   Boolean            @default(false)

  bidDeliveries ListingBid[] @relation("BidDeliveryAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, type])
  @@map("company_addresses")
}

/// Zaman Tasarrufu hesap motoru parametreleri (dakika bazlı birim süreler).
/// companyId NULL = GLOBAL satır (tek adet, kısmi unique index migration'da);
/// dolu = firma override'ı. Kod içi varsayılanlar yalnız satır yokken fallback.
model TimeSavingsConfig {
  id        String   @id @default(cuid())
  /// NULL = global varsayılan; dolu = firma bazlı override.
  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// RFQ mailini hazırlama — dk × davet edilen tedarikçi.
  rfqMailPrepMin      Decimal @default(6) @db.Decimal(6, 2)
  /// Takip/hatırlatma — dk × tedarikçi × tur. NOT: hatırlatma turu takibi
  /// olmadığı için v1 hesabına KATILMAZ (parametre ileriye dönük durur).
  followupMin         Decimal @default(3) @db.Decimal(6, 2)
  /// Teklifi Excel'e işleme — dk × teklif (kalem katsayılı).
  bidToExcelMin       Decimal @default(4) @db.Decimal(6, 2)
  /// Kalem katsayısı: teklif başına süre × (1 + factor × (kalem-1)).
  bidItemFactor       Decimal @default(0.15) @db.Decimal(4, 2)
  /// Karşılaştırma tablosu — dk × ihale.
  comparisonTableMin  Decimal @default(15) @db.Decimal(6, 2)
  /// Revizyon turu — dk × tedarikçi × tur (round>1 + version>1 sinyali).
  revisionRoundMin    Decimal @default(5) @db.Decimal(6, 2)
  /// Onay mail döngüsü — dk × onaya düşen ihale.
  approvalLoopMin     Decimal @default(20) @db.Decimal(6, 2)
  /// PO hazırlama + gönderme — dk × sipariş.
  poPrepMin           Decimal @default(10) @db.Decimal(6, 2)
  /// Saatlik iş gücü maliyeti (₺) — NULL ise TL karşılığı hiç gösterilmez.
  hourlyLaborCost     Decimal? @db.Decimal(10, 2)

  updatedById String? // PlatformAdmin id (global) / CompanyUser id (override)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("time_savings_configs")
}
