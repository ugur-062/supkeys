// Supkeys/Rothern — birleşik Company sistemi şeması (eski Tenant/Supplier söküldü)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supavisor pooler (port 6543, transaction mode) — runtime sorgular.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — prisma migrate ve introspect için.
  // Supabase'e geçtikten sonra zorunlu; local Docker'da DATABASE_URL ile aynıdır.
  directUrl = env("DIRECT_URL")
}

model PasswordResetToken {
  id               String       @id @default(cuid())
  companyUserId    String?
  companyUser      CompanyUser? @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  tokenHash        String       @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime     @default(now())
  createdByAdminId String?

  @@index([companyUserId])
  @@map("password_reset_tokens")
}

model PlatformAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  // Supabase Auth bridge — `auth.users.id` (UUID).
  authId       String?   @unique
  passwordHash String?
  firstName    String
  lastName     String
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("platform_admins")
}

enum AdminRole {
  SUPER_ADMIN // her şey
  SALES // demo, tenant
  SUPPORT // sadece okuma + tenant impersonate
}

model EmailLog {
  id                String      @id @default(cuid())
  template          String
  toEmail           String
  toName            String?
  subject           String
  provider          String
  providerMessageId String?     @unique
  status            EmailStatus @default(QUEUED)
  errorMessage      String?
  payload           Json?
  attemptCount      Int         @default(0)
  queuedAt          DateTime    @default(now())
  sentAt            DateTime?
  failedAt          DateTime?

  // V2-1 — Resend webhook delivery tracking
  deliveredAt  DateTime?
  openedAt     DateTime? // ilk açılma
  clickedAt    DateTime? // ilk tıklama
  bouncedAt    DateTime?
  bounceType   String? // "hard" | "soft" | "undetermined"
  bounceReason String?   @db.Text
  complainedAt DateTime?

  events EmailEvent[]

  contextType String?
  contextId   String?

  @@index([status])
  @@index([toEmail])
  @@index([template])
  @@index([contextType, contextId])
  @@index([queuedAt])
  @@map("email_logs")
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  // V2-1 — Resend webhook tracking
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
}

model EmailEvent {
  id         String   @id @default(cuid())
  emailLogId String
  emailLog   EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  /// Webhook idempotency key (svix-id header). Aynı event 2 kez işlenmesin.
  eventId    String         @unique
  eventType  EmailEventType
  /// Resend payload'tan gelen orijinal timestamp.
  occurredAt DateTime
  payload    Json

  /// CLICKED event için tıklanan link.
  clickedUrl   String? @db.Text
  /// BOUNCED event için bounce detay.
  bounceType   String?
  bounceReason String? @db.Text

  createdAt DateTime @default(now())

  @@index([emailLogId, occurredAt])
  @@index([eventType])
  @@map("email_events")
}

enum EmailEventType {
  SENT
  DELIVERED
  DELIVERY_DELAYED
  BOUNCED
  COMPLAINED
  OPENED
  CLICKED
  FAILED
}

enum CompanyType {
  JOINT_STOCK
  LIMITED
  SOLE_PROPRIETOR
}

enum CompanyVerificationStatus {
  UNVERIFIED // belge yok / eksik
  PENDING // 6/6 belge yüklendi, admin onayı bekliyor
  VERIFIED // onaylandı — ihale/premium kapısı açık
  REJECTED // reddedildi (eksik/hatalı belge)
}

enum Currency {
  TRY
  USD
  EUR
  GBP
  CHF
  JPY
  AED
  CNY
}

model Category {
  id     String @id @default(cuid())
  /**
   * UNSPSC 8-haneli kod (10000000=segment, 10100000=family, 10101500=class, 10101501=commodity)
   */
  code   String @unique
  nameTr String
  /**
   * 1=Segment, 2=Family, 3=Class, 4=Commodity
   */
  level  Int

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")

  /**
   * Sadece level 1: PratisPro tarzı harf prefix (A, B, C...)
   */
  segmentLetter String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
  @@index([level, sortOrder])
  @@index([code])
  @@map("categories")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorType  String // "tenant" | "admin" | "supplier" | "system"
  actorId    String?
  actorEmail String?
  action     String // "auth.login", "auth.login_failed", "tender.awarded", ...
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

enum CompanyRole {
  YONETICI // hesap yönetimi: kullanıcı/rol, ayarlar, bağlantılar
  SATIN_ALMACI // alım operasyonu (🔵)
  SATISCI // satış operasyonu (🟢)
  ONAYLAYICI // onay zinciri
}

enum CompanyTier {
  STANDARD // bedava — pasif: sadece bağlantılı firmaların ilanına teklif; görünmez
  PAKET // paralı — aktif: ilan aç + keşfet + public + görünür
}

model Company {
  id        String  @id @default(cuid())
  supkeysId String? @unique
  slug      String? @unique // public profil URL'i (sadece PAKET)

  // Kimlik
  name        String // ticari ad
  legalName   String?
  companyType CompanyType?
  taxNumber   String?      @unique
  taxOffice   String?
  country     String       @default("TR")
  stateRegion String?

  // Adres (inline; ileride Address[] defteriyle zenginleşir)
  city         String?
  district     String?
  neighborhood String?
  addressLine  String?
  postalCode   String?

  // İletişim / fatura / kurumsal
  industry               String?
  website                String?
  billingTitle           String?
  billingEmail           String?
  billingPhone           String?
  billingPhoneVerifiedAt DateTime?
  authorizedTckn         String?
  authorizedTitle        String?
  mersisNo               String?
  tradeRegistryNo        String?
  kepAddress             String?
  iban                   String?
  ibanHolder             String?

  // Kategoriler — AYRI: ne alırım vs ne satarım
  buyerCategoryIds     String[] @default([])
  buyerSubCategoryIds  String[] @default([])
  sellerCategoryIds    String[] @default([])
  sellerSubCategoryIds String[] @default([])

  // Üyelik (koltuk yok; sınırsız kullanıcı)
  tier            CompanyTier @default(STANDARD)
  membershipEndAt DateTime?

  // KYC / doğrulama
  companyVerificationStatus CompanyVerificationStatus @default(UNVERIFIED)
  companyVerifiedAt         DateTime?
  docTaxPlateUrl            String?
  docTradeRegistryUrl       String?
  docSignatureCircularUrl   String?
  docActivityCertUrl        String?
  docIdFrontUrl             String?
  docIdBackUrl              String?
  onboardingCompletedAt     DateTime?

  // Public profil (sadece PAKET görünür)
  publicEnabled  Boolean  @default(false)
  aboutText      String?
  logoUrl        String?
  coverImageUrl  String?
  linkedinUrl    String?
  instagramUrl   String?
  services       String[] @default([])
  foundedYear    Int?
  employeeCount  String?
  certifications String[] @default([])

  // Durum
  isActive      Boolean   @default(true)
  isBlocked     Boolean   @default(false)
  blockedReason String?
  blockedAt     DateTime?

  // Sahiplik — tekil firma sahibi (CompanyUser.id). Sahip ⊇ Yönetici.
  ownerUserId String?

  users                CompanyUser[]
  listings             Listing[]
  bidsPlaced           ListingBid[]        @relation("BidderCompany")
  connectionsInitiated CompanyConnection[] @relation("ConnInviter")
  connectionsReceived  CompanyConnection[] @relation("ConnInvitee")
  ordersAsSeller       CompanyOrder[]      @relation("OrderSeller")
  ordersAsBuyer        CompanyOrder[]      @relation("OrderBuyer")
  blocksMade           CompanyBlock[]      @relation("BlockMade")
  blockedByOthers      CompanyBlock[]      @relation("BlockedBy")
  complaintsMade       CompanyComplaint[]  @relation("ComplaintBy")
  complaintsReceived   CompanyComplaint[]  @relation("ComplaintAgainst")
  listingInvitations   ListingInvitation[] @relation("ListingInvitee")
  listingTemplates     ListingTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

enum ComplaintStatus {
  OPEN // yeni — admin incelemesi bekliyor
  RESOLVED // çözüldü, aksiyon alındı (örn. askı)
  DISMISSED // geçersiz/reddedildi
}

model CompanyComplaint {
  id                   String          @id @default(cuid())
  complainantCompanyId String
  complainant          Company         @relation("ComplaintBy", fields: [complainantCompanyId], references: [id], onDelete: Cascade)
  againstCompanyId     String
  against              Company         @relation("ComplaintAgainst", fields: [againstCompanyId], references: [id], onDelete: Cascade)
  reason               String // başlık/kategori
  detail               String?
  status               ComplaintStatus @default(OPEN)
  adminNote            String?
  createdById          String // CompanyUser
  resolvedAt           DateTime?
  resolvedByAdminId    String?
  createdAt            DateTime        @default(now())

  @@index([againstCompanyId])
  @@index([status])
  @@map("company_complaints")
}

enum ConnectionStatus {
  PENDING // davet gönderildi, kabul bekliyor
  ACTIVE // kabul edildi, bağlı
}

enum ConnectionOrigin {
  INVITE // davet-kabul / referans kodu — premium düşüşünde KALICI
  PREMIUM // premium keşif üzerinden — premium düşüşünde PASİFE alınır
  ADMIN // platform bağladı
}

model CompanyConnection {
  id               String  @id @default(cuid())
  inviterCompanyId String
  inviter          Company @relation("ConnInviter", fields: [inviterCompanyId], references: [id], onDelete: Cascade)
  inviteeCompanyId String
  invitee          Company @relation("ConnInvitee", fields: [inviteeCompanyId], references: [id], onDelete: Cascade)

  status      ConnectionStatus @default(PENDING)
  origin      ConnectionOrigin @default(INVITE)
  invitedById String // CompanyUser (daveti atan kişi)
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inviterCompanyId, inviteeCompanyId])
  @@index([inviteeCompanyId])
  @@map("company_connections")
}

model CompanyBlock {
  id               String  @id @default(cuid())
  blockerCompanyId String
  blocker          Company @relation("BlockMade", fields: [blockerCompanyId], references: [id], onDelete: Cascade)
  blockedCompanyId String
  blocked          Company @relation("BlockedBy", fields: [blockedCompanyId], references: [id], onDelete: Cascade)
  reason           String?
  createdAt        DateTime @default(now())

  @@unique([blockerCompanyId, blockedCompanyId])
  @@index([blockedCompanyId])
  @@map("company_blocks")
}

enum ListingType {
  ALIM // alım ilanı (reverse — fiyat iner, en ucuz kazanır)
  SATIS // satış ilanı (forward — fiyat çıkar, en yüksek kazanır)
}

enum ListingBidStatus {
  SUBMITTED
  WITHDRAWN
  WON
  LOST
}

enum CompanyOrderStatus {
  CREATED // kazandırıldı, yeni sipariş
  IN_DELIVERY // kargoda
  DELIVERED // teslim alındı
  COMPLETED // tamamlandı (ödeme + teslim)
  CANCELLED
}

enum CompanyDocType {
  DELIVERY // teslim belgesi — yurtiçi irsaliye / uluslararası konşimento (satıcı yükler)
  PAYMENT // ödeme dekontu (alıcı yükler)
}

model CompanyOrderDocument {
  id                  String         @id @default(cuid())
  orderId             String
  order               CompanyOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type                CompanyDocType
  key                 String // R2 object key
  fileName            String
  mimeType            String
  uploadedByCompanyId String
  createdAt           DateTime       @default(now())

  @@index([orderId])
  @@map("company_order_documents")
}

model CompanyOrder {
  id              String   @id @default(cuid())
  number          String?  @unique // ROT-ORD-NNNNNN (global sequence)
  // Bir ilandan kalem-bazlı kazandırmada birden çok sipariş çıkabilir → unique DEĞİL.
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  sellerCompanyId String
  seller          Company  @relation("OrderSeller", fields: [sellerCompanyId], references: [id], onDelete: Cascade)
  buyerCompanyId  String
  buyer           Company  @relation("OrderBuyer", fields: [buyerCompanyId], references: [id], onDelete: Cascade)

  amount Decimal            @db.Decimal(18, 2)
  status CompanyOrderStatus @default(CREATED)

  documents CompanyOrderDocument[]
  items     CompanyOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerCompanyId])
  @@index([buyerCompanyId])
  @@index([listingId])
  @@map("company_orders")
}

// Sipariş kalemi — kazandırma anındaki snapshot (ad/miktar/birim fiyat).
model CompanyOrderItem {
  id        String       @id @default(cuid())
  orderId   String
  order     CompanyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  quantity  Decimal      @db.Decimal(18, 3)
  unit      String
  unitPrice Decimal      @db.Decimal(18, 2)

  @@index([orderId])
  @@map("company_order_items")
}

model ListingBid {
  id              String  @id @default(cuid())
  listingId       String
  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderCompanyId String
  bidderCompany   Company @relation("BidderCompany", fields: [bidderCompanyId], references: [id], onDelete: Cascade)

  // Toplam tutar (tek-tutar teklif VEYA kalem teklifleri toplamı).
  amount      Decimal          @db.Decimal(18, 2)
  currency    Currency         @default(TRY)
  note        String?
  // Hemen-Al ile verilen teklif (tavan fiyattan). Yine de sahip onaylar.
  isBuyNow    Boolean          @default(false)
  status      ListingBidStatus @default(SUBMITTED)
  createdById String // CompanyUser (teklifi veren kişi)

  items     ListingBidItem[]
  documents ListingBidDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, bidderCompanyId])
  @@index([listingId])
  @@index([bidderCompanyId])
  @@map("listing_bids")
}

// Teklif belgesi — tedarikçinin teklifine eklediği dosya (R2 key).
model ListingBidDocument {
  id                  String     @id @default(cuid())
  bidId               String
  bid                 ListingBid @relation(fields: [bidId], references: [id], onDelete: Cascade)
  key                 String // R2 object key
  fileName            String
  mimeType            String
  uploadedByCompanyId String
  createdAt           DateTime   @default(now())

  @@index([bidId])
  @@map("listing_bid_documents")
}

enum ListingStatus {
  DRAFT
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum ListingVisibility {
  PUBLIC // herkese açık — standart MASKELİ görür, premium tam
  CONNECTIONS // sadece bağlantılı firmalar
  PRIVATE // sadece açıkça davet edilenler (ileride)
}

enum ListingFormat {
  RFQ // kapalı zarf teklif toplama (ALIM)
  ENGLISH_AUCTION // İngiliz usulü açık eksiltme (ALIM)
}

model Listing {
  id          String        @id @default(cuid())
  // SİSTEM GENELİNDE benzersiz ilan numarası (ROT-NNNNNN). Global Postgres
  // sequence'tan üretilir → A ve B firmasının ilanı asla aynı numarayı almaz.
  // Sıra büyüdükçe hane sayısı kendiliğinden artar (çok-haneli destek).
  number      String?       @unique
  companyId   String // açan firma
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        ListingType
  // Yurtiçi (false) / Uluslararası (true).
  isInternational Boolean @default(false)
  // ALIM için format (RFQ/İngiliz Usulü). SATIS'ta null (her zaman forward).
  format      ListingFormat?
  visibility  ListingVisibility @default(CONNECTIONS)
  title       String
  description String?
  // SATIS için: taban (min) fiyat + hemen-al fiyatı.
  minPrice    Decimal?      @db.Decimal(18, 2)
  buyNowPrice Decimal?      @db.Decimal(18, 2)
  status      ListingStatus @default(OPEN)
  closesAt    DateTime?
  createdById String // CompanyUser id (açan kişi)

  // İhale (ALIM) zenginleştirme — eski alıcı paneli kuralları.
  categoryIds        String[]   @default([]) // UNGM UNSPSC TR kategori kodları
  keywords           String[]   @default([]) // 0-10 arama/eşleştirme etiketi
  terms              String? // şartlar ve koşullar
  internalNotes      String? // yalnızca açan firma görür
  requireAllItems    Boolean    @default(false) // tüm kalemlere teklif zorunlu mu
  requireBidDocument Boolean    @default(false) // teklifte belge zorunlu mu
  primaryCurrency    Currency   @default(TRY)
  allowedCurrencies  Currency[] @default([])

  bids        ListingBid[]
  orders      CompanyOrder[]
  items       ListingItem[]
  invitations ListingInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("listings")
}

// İhale şablonu — wizard yapılandırmasını kaydet/kopyala (eski TenderTemplate).
model ListingTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  payload     Json // wizard config snapshot (başlık/format/kalemler/keywords/…)
  createdById String
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@map("listing_templates")
}

// İhale kalemi — bir ilanda birden çok satır (eski TenderItem).
model ListingItem {
  id          String  @id @default(cuid())
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  lineNo      Int // sıra (1..n)
  name        String
  description String?
  quantity    Decimal @db.Decimal(18, 3)
  unit        String // adet, kg, m, paket…
  targetPrice Decimal? @db.Decimal(18, 2) // hedef birim fiyat (opsiyonel)

  bidItems ListingBidItem[]

  createdAt DateTime @default(now())

  @@index([listingId])
  @@map("listing_items")
}

// İhale daveti — belirli bağlı tedarikçiyi ihaleye davet (eski TenderInvitation).
model ListingInvitation {
  id               String  @id @default(cuid())
  listingId        String
  listing          Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  invitedCompanyId String
  invitedCompany   Company @relation("ListingInvitee", fields: [invitedCompanyId], references: [id], onDelete: Cascade)
  invitedById      String // CompanyUser (daveti gönderen)
  createdAt        DateTime @default(now())

  @@unique([listingId, invitedCompanyId])
  @@index([invitedCompanyId])
  @@map("listing_invitations")
}

// Kalem-bazlı teklif satırı — bir teklifin her kaleme verdiği birim fiyat.
model ListingBidItem {
  id        String      @id @default(cuid())
  bidId     String
  bid       ListingBid  @relation(fields: [bidId], references: [id], onDelete: Cascade)
  itemId    String
  item      ListingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitPrice Decimal     @db.Decimal(18, 2)
  note      String?

  @@unique([bidId, itemId])
  @@index([bidId])
  @@map("listing_bid_items")
}

model CompanyUser {
  id        String  @id @default(cuid())
  email     String  @unique
  authId    String? @unique // Supabase auth bridge
  firstName String
  lastName  String
  phone     String?

  roles CompanyRole[] @default([])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  isActive           Boolean   @default(true)
  emailVerifiedAt    DateTime?
  twoFactorEnabled   Boolean   @default(false)
  twoFactorEnabledAt DateTime?
  permissionsOverride Json? // { added?: string[], removed?: string[] }
  notificationPrefs   Json?
  invitedById         String?
  invitedAt           DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime? // iş çıkışı — soft delete (geçmiş korunur, KVKK)

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("company_users")
}
