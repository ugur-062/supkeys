// Supkeys/Rothern — birleşik Company sistemi şeması (eski Tenant/Supplier söküldü)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supavisor pooler (port 6543, transaction mode) — runtime sorgular.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — prisma migrate ve introspect için.
  // Supabase'e geçtikten sonra zorunlu; local Docker'da DATABASE_URL ile aynıdır.
  directUrl = env("DIRECT_URL")
}

model PasswordResetToken {
  id               String       @id @default(cuid())
  companyUserId    String?
  companyUser      CompanyUser? @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  tokenHash        String       @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime     @default(now())
  createdByAdminId String?

  @@index([companyUserId])
  @@map("password_reset_tokens")
}

/**
 * E-posta doğrulama kodu (6 hane) — kayıt sonrası e-posta sahipliğini kanıtlar.
 * Kod hash'lenmiş saklanır, tek kullanımlık, süreli. Resend ile gönderilir.
 */
model EmailVerificationCode {
  id            String      @id @default(cuid())
  companyUserId String
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  codeHash      String
  expiresAt     DateTime
  usedAt        DateTime?
  attempts      Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([companyUserId])
  @@map("email_verification_codes")
}

model PlatformAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  // Supabase Auth bridge — `auth.users.id` (UUID).
  authId       String?   @unique
  passwordHash String?
  firstName    String
  lastName     String
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("platform_admins")
}

enum AdminRole {
  SUPER_ADMIN // her şey
  SALES // demo, tenant
  SUPPORT // sadece okuma + tenant impersonate
}

model EmailLog {
  id                String      @id @default(cuid())
  template          String
  toEmail           String
  toName            String?
  subject           String
  provider          String
  providerMessageId String?     @unique
  status            EmailStatus @default(QUEUED)
  errorMessage      String?
  payload           Json?
  attemptCount      Int         @default(0)
  queuedAt          DateTime    @default(now())
  sentAt            DateTime?
  failedAt          DateTime?

  // V2-1 — Resend webhook delivery tracking
  deliveredAt  DateTime?
  openedAt     DateTime? // ilk açılma
  clickedAt    DateTime? // ilk tıklama
  bouncedAt    DateTime?
  bounceType   String? // "hard" | "soft" | "undetermined"
  bounceReason String?   @db.Text
  complainedAt DateTime?

  events EmailEvent[]

  contextType String?
  contextId   String?

  @@index([status])
  @@index([toEmail])
  @@index([template])
  @@index([contextType, contextId])
  @@index([queuedAt])
  @@map("email_logs")
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  // V2-1 — Resend webhook tracking
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
}

model EmailEvent {
  id         String   @id @default(cuid())
  emailLogId String
  emailLog   EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  /// Webhook idempotency key (svix-id header). Aynı event 2 kez işlenmesin.
  eventId    String         @unique
  eventType  EmailEventType
  /// Resend payload'tan gelen orijinal timestamp.
  occurredAt DateTime
  payload    Json

  /// CLICKED event için tıklanan link.
  clickedUrl   String? @db.Text
  /// BOUNCED event için bounce detay.
  bounceType   String?
  bounceReason String? @db.Text

  createdAt DateTime @default(now())

  @@index([emailLogId, occurredAt])
  @@index([eventType])
  @@map("email_events")
}

enum EmailEventType {
  SENT
  DELIVERED
  DELIVERY_DELAYED
  BOUNCED
  COMPLAINED
  OPENED
  CLICKED
  FAILED
}

enum CompanyType {
  JOINT_STOCK
  LIMITED
  SOLE_PROPRIETOR
}

enum CompanyVerificationStatus {
  UNVERIFIED // belge yok / eksik
  PENDING // 6/6 belge yüklendi, admin onayı bekliyor
  VERIFIED // onaylandı — ihale/premium kapısı açık
  REJECTED // reddedildi (eksik/hatalı belge)
}

enum Currency {
  TRY
  USD
  EUR
  GBP
  CHF
  JPY
  AED
  CNY
}

model Category {
  id     String @id @default(cuid())
  /**
   * UNSPSC 8-haneli kod (10000000=segment, 10100000=family, 10101500=class, 10101501=commodity)
   */
  code   String @unique
  nameTr String
  /**
   * 1=Segment, 2=Family, 3=Class, 4=Commodity
   */
  level  Int

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")

  /**
   * Sadece level 1: PratisPro tarzı harf prefix (A, B, C...)
   */
  segmentLetter String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
  @@index([level, sortOrder])
  @@index([code])
  @@map("categories")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorType  String // "tenant" | "admin" | "supplier" | "system"
  actorId    String?
  actorEmail String?
  action     String // "auth.login", "auth.login_failed", "tender.awarded", ...
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

enum CompanyRole {
  YONETICI // hesap yönetimi: kullanıcı/rol, ayarlar, bağlantılar
  SATIN_ALMACI // alım operasyonu (🔵)
  SATISCI // satış operasyonu (🟢)
  ONAYLAYICI // onay zinciri
}

enum CompanyTier {
  STANDARD // bedava — pasif: sadece bağlantılı firmaların ilanına teklif; görünmez
  PAKET // paralı — aktif: ilan aç + keşfet + public + görünür
}

model Company {
  id        String  @id @default(cuid())
  supkeysId String? @unique // genel kimlik (Rothern ID) — keşfet/istek için
  slug      String? @unique // public profil URL'i (sadece PAKET)

  // Kimlik
  name        String // ticari ad
  legalName   String?
  companyType CompanyType?
  taxNumber   String?      @unique
  taxOffice   String?
  country     String       @default("TR")
  stateRegion String?

  // Adres (inline; ileride Address[] defteriyle zenginleşir)
  city         String?
  district     String?
  neighborhood String?
  addressLine  String?
  postalCode   String?

  // İletişim / fatura / kurumsal
  industry               String?
  website                String?
  billingTitle           String?
  billingEmail           String?
  billingPhone           String?
  billingPhoneVerifiedAt DateTime?
  authorizedTckn         String?
  authorizedTitle        String?
  mersisNo               String?
  tradeRegistryNo        String?
  kepAddress             String?
  iban                   String?
  ibanHolder             String?

  // Kategoriler — AYRI: ne alırım vs ne satarım
  buyerCategoryIds     String[] @default([])
  buyerSubCategoryIds  String[] @default([])
  sellerCategoryIds    String[] @default([])
  sellerSubCategoryIds String[] @default([])

  // Üyelik (koltuk yok; sınırsız kullanıcı)
  tier            CompanyTier @default(STANDARD)
  membershipEndAt DateTime?

  // KYC / doğrulama
  companyVerificationStatus CompanyVerificationStatus @default(UNVERIFIED)
  companyVerifiedAt         DateTime?
  docTaxPlateUrl            String?
  docTradeRegistryUrl       String?
  docSignatureCircularUrl   String?
  docActivityCertUrl        String?
  docIdFrontUrl             String?
  docIdBackUrl              String?
  onboardingCompletedAt     DateTime?

  // Public profil (sadece PAKET görünür)
  publicEnabled     Boolean  @default(false)
  aboutText         String?
  logoUrl           String?
  coverImageUrl     String?
  linkedinUrl       String?
  instagramUrl      String?
  services          String[] @default([])
  photos            String[] @default([]) // herkese açık profil galeri görselleri
  certificateImages String[] @default([]) // sertifika belge/görselleri
  foundedYear       Int?
  employeeCount     String?
  certifications    String[] @default([])

  // Durum
  isActive      Boolean   @default(true)
  isBlocked     Boolean   @default(false)
  blockedReason String?
  blockedAt     DateTime?

  // Sahiplik — tekil firma sahibi (CompanyUser.id). Sahip ⊇ Yönetici.
  ownerUserId String?

  users                CompanyUser[]
  listings             Listing[]
  bidsPlaced           ListingBid[]              @relation("BidderCompany")
  connectionsInitiated CompanyConnection[]       @relation("ConnInviter")
  connectionsReceived  CompanyConnection[]       @relation("ConnInvitee")
  referralInvitesSent  CompanyReferralInvite[]   @relation("ReferralInviter")
  ordersAsSeller       CompanyOrder[]            @relation("OrderSeller")
  ordersAsBuyer        CompanyOrder[]            @relation("OrderBuyer")
  blocksMade           CompanyBlock[]            @relation("BlockMade")
  blockedByOthers      CompanyBlock[]            @relation("BlockedBy")
  complaintsMade       CompanyComplaint[]        @relation("ComplaintBy")
  complaintsReceived   CompanyComplaint[]        @relation("ComplaintAgainst")
  listingInvitations   ListingInvitation[]       @relation("ListingInvitee")
  listingTemplates     ListingTemplate[]
  supplierTemplates    SupplierTemplate[]
  threadsAsBuyer       MessageThread[]           @relation("ThreadBuyer")
  threadsAsSeller      MessageThread[]           @relation("ThreadSeller")
  messagesSent         Message[]                 @relation("MessageSender")
  questionTemplates    ListingQuestionTemplate[]
  approvalFlows        ApprovalFlow[]
  approvalRequests     ApprovalRequest[]
  userInvitations      CompanyUserInvitation[]
  addresses            CompanyAddress[]
  bankAccounts         CompanyBankAccount[]
  reviewsGiven         CompanyReview[]    @relation("ReviewsGiven")
  reviewsReceived      CompanyReview[]    @relation("ReviewsReceived")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier, isActive, country])
  @@map("companies")
}

/**
 * 1-1 mesajlaşma thread'i — her zaman bir ALICI ve bir SATICI firma arasında.
 * Bağımsız-per-portal: bir firma için buyer olduğu thread'ler Satınalma
 * inbox'ına, seller olduğu thread'ler Satış inbox'ına düşer. A→B (alış) ile
 * B→A (satış) ayrı thread'lerdir; bu yüzden iki portal birbirinden bağımsız.
 */
model MessageThread {
  id              String  @id @default(cuid())
  buyerCompanyId  String
  buyerCompany    Company @relation("ThreadBuyer", fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  sellerCompanyId String
  sellerCompany   Company @relation("ThreadSeller", fields: [sellerCompanyId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime?
  messages      Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerCompanyId, sellerCompanyId])
  @@index([buyerCompanyId])
  @@index([sellerCompanyId])
  @@map("message_threads")
}

model Message {
  id              String        @id @default(cuid())
  threadId        String
  thread          MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderCompanyId String
  senderCompany   Company       @relation("MessageSender", fields: [senderCompanyId], references: [id], onDelete: Cascade)
  senderUserId    String? // CompanyUser.id — mesajı yazan kişi
  senderName      String // gönderim anındaki ad (denormalize, geçmiş korunur)
  body            String
  readAt          DateTime? // karşı taraf okuduğunda set edilir

  createdAt DateTime @default(now())

  @@index([threadId])
  @@map("messages")
}

// V2-3 — TCMB günlük gösterge kurları (cron ile fetch + upsert).
model ExchangeRate {
  id        String   @id @default(cuid())
  currency  Currency
  rate      Decimal  @db.Decimal(15, 6) // 1 {currency} = X TRY
  rateDate  DateTime @db.Date // TCMB tarihi (gün-bazlı)
  source    String   @default("TCMB") // TCMB | MANUAL | FALLBACK
  fetchedAt DateTime @default(now())

  @@unique([currency, rateDate])
  @@index([rateDate])
  @@map("exchange_rates")
}

enum ComplaintStatus {
  OPEN // yeni — admin incelemesi bekliyor
  RESOLVED // çözüldü, aksiyon alındı (örn. askı)
  DISMISSED // geçersiz/reddedildi
}

model CompanyComplaint {
  id                   String          @id @default(cuid())
  complainantCompanyId String
  complainant          Company         @relation("ComplaintBy", fields: [complainantCompanyId], references: [id], onDelete: Cascade)
  againstCompanyId     String
  against              Company         @relation("ComplaintAgainst", fields: [againstCompanyId], references: [id], onDelete: Cascade)
  reason               String // başlık/kategori
  detail               String?
  status               ComplaintStatus @default(OPEN)
  adminNote            String?
  createdById          String // CompanyUser
  resolvedAt           DateTime?
  resolvedByAdminId    String?
  createdAt            DateTime        @default(now())

  @@index([againstCompanyId])
  @@index([status])
  @@map("company_complaints")
}

enum ConnectionStatus {
  PENDING // davet gönderildi, kabul bekliyor
  ACTIVE // kabul edildi, bağlı
}

enum ConnectionOrigin {
  INVITE // davet-kabul / referans kodu — premium düşüşünde KALICI
  PREMIUM // premium keşif üzerinden — premium düşüşünde PASİFE alınır
  ADMIN // platform bağladı
}

model CompanyConnection {
  id               String  @id @default(cuid())
  inviterCompanyId String
  inviter          Company @relation("ConnInviter", fields: [inviterCompanyId], references: [id], onDelete: Cascade)
  inviteeCompanyId String
  invitee          Company @relation("ConnInvitee", fields: [inviteeCompanyId], references: [id], onDelete: Cascade)

  status      ConnectionStatus @default(PENDING)
  origin      ConnectionOrigin @default(INVITE)
  invitedById String // CompanyUser (daveti atan kişi)
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inviterCompanyId, inviteeCompanyId])
  @@index([inviteeCompanyId])
  @@map("company_connections")
}

enum ReferralInviteStatus {
  PENDING // davet gönderildi, hedef henüz kayıt olmadı
  ACCEPTED // hedef kayıt oldu → INVITE bağlantısı kuruldu
}

/**
 * Kayıtlı OLMAYAN firmayı e-posta + referans ile davet. Hedef bu e-posta ile
 * kayıt olunca otomatik INVITE (kalıcı) bağlantı kurulur. Kayıtlı firmalar
 * doğrudan connect-by-referral / Rothern ID ile bağlanır (bu model değil).
 */
model CompanyReferralInvite {
  id               String  @id @default(cuid())
  inviterCompanyId String
  inviter          Company @relation("ReferralInviter", fields: [inviterCompanyId], references: [id], onDelete: Cascade)
  email            String
  invitedById      String // daveti atan CompanyUser
  token            String  @unique @default(cuid())

  status            ReferralInviteStatus @default(PENDING)
  acceptedCompanyId String?
  acceptedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inviterCompanyId, email])
  @@index([email])
  @@map("company_referral_invites")
}

model CompanyBlock {
  id               String   @id @default(cuid())
  blockerCompanyId String
  blocker          Company  @relation("BlockMade", fields: [blockerCompanyId], references: [id], onDelete: Cascade)
  blockedCompanyId String
  blocked          Company  @relation("BlockedBy", fields: [blockedCompanyId], references: [id], onDelete: Cascade)
  reason           String?
  createdAt        DateTime @default(now())

  @@unique([blockerCompanyId, blockedCompanyId])
  @@index([blockedCompanyId])
  @@map("company_blocks")
}

enum ListingType {
  ALIM // alım ilanı (reverse — fiyat iner, en ucuz kazanır)
  SATIS // satış ilanı (forward — fiyat çıkar, en yüksek kazanır)
}

enum ListingBidStatus {
  DRAFT // taslak teklif — henüz gönderilmedi
  SUBMITTED
  WITHDRAWN
  WON
  AWARDED_PARTIAL // kalem-bazlı kazandırmada kısmen kazandı
  LOST
}

enum CompanyOrderStatus {
  PENDING // kazandırıldı, satıcı onayı bekliyor
  ACCEPTED // satıcı siparişi onayladı
  CREATED // (legacy) eski kayıtlar — yeni akışta PENDING ile başlar
  IN_DELIVERY // kargoda
  DELIVERED // teslim alındı
  COMPLETED // tamamlandı (ödeme + teslim)
  REJECTED // satıcı siparişi reddetti
  CANCELLED
}

enum CompanyOrderPaymentTiming {
  BEFORE_DELIVERY // ödeme teslimattan önce (satıcı onayından sonra açılır)
  AFTER_DELIVERY // ödeme teslimattan sonra (alıcı teslim aldıktan sonra açılır)
}

enum CompanyOrderPaymentStatus {
  AWAITING_CONFIRMATION // alıcı kaydetti, satıcı onayı bekliyor
  CONFIRMED // satıcı ödemeyi onayladı
  REJECTED // satıcı ödemeyi reddetti
}

enum CompanyDocType {
  DELIVERY // teslim belgesi — yurtiçi irsaliye / uluslararası konşimento (satıcı yükler)
  PAYMENT // ödeme dekontu (alıcı yükler)
  TEMINAT // teminat mektubu — peşin (CASH) işte satıcı SİPARİŞ ONAYINDAN ÖNCE yükler
}

model CompanyOrderDocument {
  id                  String         @id @default(cuid())
  orderId             String
  order               CompanyOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type                CompanyDocType
  key                 String // R2 object key
  fileName            String
  mimeType            String
  uploadedByCompanyId String
  createdAt           DateTime       @default(now())

  @@index([orderId])
  @@map("company_order_documents")
}

model CompanyOrder {
  id              String   @id @default(cuid())
  number          String?  @unique // ROT-ORD-NNNNNN (global sequence)
  // Bir ilandan kalem-bazlı kazandırmada birden çok sipariş çıkabilir → unique DEĞİL.
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  sellerCompanyId String
  seller          Company  @relation("OrderSeller", fields: [sellerCompanyId], references: [id], onDelete: Cascade)
  buyerCompanyId  String
  buyer           Company  @relation("OrderBuyer", fields: [buyerCompanyId], references: [id], onDelete: Cascade)

  amount         Decimal                   @db.Decimal(18, 2)
  // Tutarın para birimi = KAZANAN TEKLİFİN birimi (çoklu-birim RFQ'da ilanın
  // ana biriminden farklı olabilir). Award anında yazılır; legacy → TRY.
  currency       String                    @default("TRY")
  status         CompanyOrderStatus        @default(PENDING)
  paymentTiming  CompanyOrderPaymentTiming @default(AFTER_DELIVERY)
  rejectedReason String?
  cancelReason   String?
  // Teslimat adresi snapshot'ı (award anında: ALIM→ilanın adresi, SATIS→kazanan
  // teklifin adresi). Adres defteri sonradan değişse de sipariş sabit kalır.
  // { title, contactName, phone, country, city, district, addressLine, postalCode }
  deliveryAddress Json?

  // ── Adım verileri (eski sistemle birebir) ──
  // KABUL (PENDING→ACCEPTED): satıcı tahmini teslim + banka + not girer.
  acceptedAt           DateTime?
  acceptedNote         String?
  bankAccountHolder    String?
  bankIban             String?
  expectedDeliveryDate DateTime?
  // GÖNDER (ACCEPTED→IN_DELIVERY): satıcı fatura no (zorunlu) + gönderim notu.
  invoiceNumber        String?
  deliveryStartedAt    DateTime?
  deliveryNote         String?
  // TESLİM / TAMAMLA: alıcı teslim alır, tamamlar.
  deliveredAt          DateTime?
  completedAt          DateTime?
  completedNote        String?
  // Timeline için sonlandırma damgaları (sebepler ayrı alanlarda).
  rejectedAt           DateTime?
  cancelledAt          DateTime?

  documents CompanyOrderDocument[]
  items     CompanyOrderItem[]
  payments  CompanyOrderPayment[]
  review    CompanyReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerCompanyId])
  @@index([buyerCompanyId])
  @@index([listingId])
  @@map("company_orders")
}

// Sipariş sonrası değerlendirme — alıcı, karşı tarafı (genelde satıcı) puanlar.
model CompanyReview {
  id                String       @id @default(cuid())
  orderId           String       @unique
  order             CompanyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewerCompanyId String
  reviewer          Company      @relation("ReviewsGiven", fields: [reviewerCompanyId], references: [id], onDelete: Cascade)
  targetCompanyId   String
  target            Company      @relation("ReviewsReceived", fields: [targetCompanyId], references: [id], onDelete: Cascade)
  rating            Int // 1-5 (servis doğrular)
  comment           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([targetCompanyId])
  @@map("company_reviews")
}

// Ödeme kaydı — alıcı kaydeder (manuel: havale/EFT vb.), satıcı onaylar/reddeder.
// Kısmi ödemeler mümkün; toplamlar (onaylı/bekleyen/kalan) UI'da hesaplanır.
model CompanyOrderPayment {
  id                  String                    @id @default(cuid())
  orderId             String
  order               CompanyOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount              Decimal                   @db.Decimal(18, 2)
  method              String? // "Havale/EFT", "Nakit", "Çek" vb. — serbest metin
  note                String?
  status              CompanyOrderPaymentStatus @default(AWAITING_CONFIRMATION)
  rejectReason        String?
  recordedByCompanyId String // ödemeyi kaydeden firma (alıcı)
  recordedByUserId    String?
  confirmedAt         DateTime?
  createdAt           DateTime                  @default(now())
  // Çek ödemesi detayları (method "Çek" ise doldurulur)
  chequeNo            String?
  chequeBank          String?
  chequeDueDate       DateTime?

  @@index([orderId])
  @@map("company_order_payments")
}

// Sipariş kalemi — kazandırma anındaki snapshot (ad/miktar/birim fiyat).
model CompanyOrderItem {
  id        String       @id @default(cuid())
  orderId   String
  order     CompanyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  quantity  Decimal      @db.Decimal(18, 3)
  unit      String
  unitPrice Decimal      @db.Decimal(18, 2)

  @@index([orderId])
  @@map("company_order_items")
}

model ListingBid {
  id              String  @id @default(cuid())
  listingId       String
  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderCompanyId String
  bidderCompany   Company @relation("BidderCompany", fields: [bidderCompanyId], references: [id], onDelete: Cascade)

  // Toplam tutar (tek-tutar teklif VEYA kalem teklifleri toplamı).
  amount      Decimal          @db.Decimal(18, 2)
  currency    Currency         @default(TRY)
  note        String?
  // Hemen-Al ile verilen teklif (tavan fiyattan). Yine de sahip onaylar.
  isBuyNow    Boolean          @default(false)
  status      ListingBidStatus @default(SUBMITTED)
  round       Int              @default(1) // hangi turda verildi/güncellendi
  createdById String // CompanyUser (teklifi veren kişi)

  // Zenginleştirme (eski Bid ile paralel).
  version              Int       @default(1) // taslak güncellemede artar
  submittedAt          DateTime? // SUBMITTED'a geçiş anı
  // ALIM: satıcının taahhüt ettiği teslim tarihi. SATIS: alıcının İSTEDİĞİ
  // teslim tarihi (teslim eden ilan sahibi satıcıdır). Gönderimde zorunlu.
  deliveryDate         DateTime?
  validityDays         Int? // teklif geçerlilik süresi (gönderimde zorunlu)
  exchangeRateSnapshot Decimal?  @db.Decimal(18, 6) // TRY dışı teklifte TCMB kuru
  eliminationReason    String? // alıcı eleme sebebi
  eliminatedAt         DateTime?

  // SATIS: alıcının teslimat adresi (kendi adres defterinden). Adrese-teslim
  // şartlarında (DOMESTIC_DELIVERED/ON_VEHICLE/CARRIER_COLLECT, DAP/DPU/DDP)
  // gönderimde zorunlu; award anında siparişe snapshot'lanır.
  deliveryAddressId String?
  deliveryAddress   CompanyAddress? @relation("BidDeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull)

  items     ListingBidItem[]
  documents ListingBidDocument[]
  answers   ListingBidAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, bidderCompanyId])
  @@index([listingId])
  @@index([bidderCompanyId])
  @@index([listingId, status])
  @@map("listing_bids")
}

// Teklif belgesi — tedarikçinin teklifine eklediği dosya (R2 key).
// Teklif belgesi bölümü — tedarikçi/alıcı yüklerken kategoriye ayırır.
enum ListingBidDocKind {
  TEKLIF_MEKTUBU // teklif mektubu / kapak
  TEKNIK_DOKUMAN // teknik doküman / şartname yanıtı
  REFERANS // referans / iş bitirme
  KATALOG // katalog / ürün broşürü
  TEMINAT // teminat mektubu (peşin ödemede)
  DIGER // diğer
}

model ListingBidDocument {
  id                  String            @id @default(cuid())
  bidId               String
  bid                 ListingBid        @relation(fields: [bidId], references: [id], onDelete: Cascade)
  kind                ListingBidDocKind @default(DIGER)
  key                 String // R2 object key
  fileName            String
  mimeType            String
  uploadedByCompanyId String
  createdAt           DateTime          @default(now())

  @@index([bidId])
  @@map("listing_bid_documents")
}

// İngiliz Usulü tur geçmişi — yeni tur başlarken o anki tekliflerin snapshot'ı.
model ListingRoundSnapshot {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  round      Int
  bidderName String
  amount     Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  @@index([listingId])
  @@map("listing_round_snapshots")
}

// İhale dosyası bölümü — sahip yüklerken kategoriye ayırır.
enum ListingDocKind {
  IDARI_SARTNAME // idari şartname
  TEKNIK_SARTNAME // teknik şartname
  SOZLESME // sözleşme taslağı
  EK // ek / çizim
  NUMUNE // numune / görsel
  DIGER // diğer
}

// İhale dosyası — sahip yükler (şartname/teknik resim); görünür firmalar indirir.
model ListingDocument {
  id                  String         @id @default(cuid())
  listingId           String
  listing             Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  kind                ListingDocKind @default(DIGER)
  key                 String // R2 object key
  fileName            String
  mimeType            String
  uploadedByCompanyId String
  createdAt           DateTime       @default(now())

  @@index([listingId])
  @@map("listing_documents")
}

enum ListingPriceScope {
  TOPLU // ilan geneli tek taban + tek hemen-al
  KALEM // kalem başına taban/hemen-al birim fiyatlar
}

enum ListingStatus {
  DRAFT // taslak — düzenlenebilir, yayınlanmadı
  IN_APPROVAL // yayın onayı bekliyor (onay akışı varsa)
  OPEN // açık — teklif alınıyor
  CLOSED // teklife kapalı (erken kapatma / süre doldu)
  IN_AWARD // kapandı, alıcı kazandırma kararı veriyor
  IN_AWARD_APPROVAL // kazandırma onayı bekliyor (onay akışı varsa)
  AWARDED // kazandırıldı, sipariş(ler) oluştu
  CLOSED_NO_AWARD // kazanan olmadan kapatıldı
  CANCELLED // iptal
}

enum ListingVisibility {
  PUBLIC // herkese açık — standart MASKELİ görür, premium tam
  CONNECTIONS // sadece bağlantılı firmalar
  PRIVATE // sadece açıkça davet edilenler (ileride)
}

enum ListingFormat {
  RFQ // kapalı zarf teklif toplama (ALIM)
  ENGLISH_AUCTION // İngiliz usulü açık eksiltme (ALIM)
}

// Teslim şekli (Incoterms + yurtiçi).
// Yurtiçi merdiveni (satıcı sorumluluğu artan sırada, EXW→DDP karşılığı):
// PICKUP → CARRIER_COLLECT → ON_VEHICLE → DELIVERED.
enum ListingDeliveryTerm {
  DOMESTIC_DELIVERED // yurtiçi adrese teslim — indirilmiş, nakliye satıcıya
  DOMESTIC_PICKUP // yurtiçi yerinden teslim — alıcı kendisi alır
  DOMESTIC_CARRIER_COLLECT // ambar/kargoya teslim — nakliye alıcıya (karşı ödemeli)
  DOMESTIC_ON_VEHICLE // adrese teslim araç üstü — nakliye satıcıya, indirme alıcıya
  EXW
  FCA
  CPT
  CIP
  DAP
  DPU
  DDP
  FAS
  FOB
  CFR
  CIF
}

enum ListingPaymentTerm {
  CASH // peşin
  DEFERRED // vadeli
}

enum ListingPaymentTiming {
  BEFORE_DELIVERY
  AFTER_DELIVERY
}

// İngiliz Usulü — teklif görünürlüğü.
enum ListingBidVisibility {
  OWN_ONLY
  BEST_PRICE
  OWN_RANK
  BEST_AND_OWN_RANK
  ALL
}

enum ListingDecrementType {
  AMOUNT
  PERCENT
}

enum ListingDecrementBasis {
  OWN_LAST_BID
  BEST_BID
}

enum ListingQuestionAnswerType {
  TEXT
  NUMBER
  YES_NO
  DATE
}

model Listing {
  id                    String            @id @default(cuid())
  // SİSTEM GENELİNDE benzersiz ilan numarası (ROT-NNNNNN). Global Postgres
  // sequence'tan üretilir → A ve B firmasının ilanı asla aynı numarayı almaz.
  // Sıra büyüdükçe hane sayısı kendiliğinden artar (çok-haneli destek).
  number                String?           @unique
  companyId             String // açan firma
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type                  ListingType
  // Yurtiçi (false) / Uluslararası (true).
  isInternational       Boolean           @default(false)
  // Sınır ötesi hedef ülkeler (ISO kodları). Boş + isInternational=true =
  // tüm yabancı ülkeler; dolu = yalnızca listelenen ülkeler görür.
  targetCountries       String[]          @default([])
  // ALIM için format (RFQ/İngiliz Usulü). SATIS'ta null (her zaman forward).
  format                ListingFormat?
  visibility            ListingVisibility @default(CONNECTIONS)
  title                 String
  description           String?
  // SATIS fiyatlandırma kapsamı: TOPLU (ilan geneli taban/hemen-al) veya
  // KALEM (her kalemin kendi minUnitPrice/buyNowUnitPrice'ı). null = TOPLU
  // (legacy). ALIM'da anlamsız.
  priceScope            ListingPriceScope?
  // SATIS + TOPLU için: taban (min) fiyat + hemen-al fiyatı.
  minPrice              Decimal?          @db.Decimal(18, 2)
  buyNowPrice           Decimal?          @db.Decimal(18, 2)
  status                ListingStatus     @default(OPEN)
  closesAt              DateTime?
  cancelReason          String? // iptal/kazansız-kapatma gerekçesi
  // Teslimat/fatura adresi — CompanyAddress id (firma adres defterinden seçilir).
  deliveryAddressId     String?
  billingAddressId      String?
  createdById           String // CompanyUser id (açan kişi)
  // Yaşam döngüsü damgaları (eski Tender ile paralel).
  publishedAt           DateTime? // OPEN'a geçiş anı
  awardedAt             DateTime? // AWARDED anı
  closingReminderSentAt DateTime? // kapanış hatırlatma idempotency
  // İngiliz Usulü çok-turlu eksiltme — alıcı tur tur ilerletir (eski yeni-tur).
  currentRound          Int               @default(1)

  // İhale (ALIM) zenginleştirme — eski alıcı paneli kuralları.
  categoryIds        String[]   @default([]) // UNGM UNSPSC TR kategori kodları
  keywords           String[]   @default([]) // 0-10 arama/eşleştirme etiketi
  terms              String? // şartlar ve koşullar
  internalNotes      String? // yalnızca açan firma görür
  requireAllItems    Boolean    @default(false) // tüm kalemlere teklif zorunlu mu
  requireBidDocument Boolean    @default(false) // teklifte belge zorunlu mu
  primaryCurrency    Currency   @default(TRY)
  allowedCurrencies  Currency[] @default([])

  // Wizard zenginleştirme (eski tender wizard birebir) — hepsi opsiyonel/default.
  isSealedBid   Boolean              @default(true) // kapalı zarf
  isLogistics   Boolean              @default(false) // lojistik ihalesi katmanı
  logistics     Json? // taşıma modu/adres/kargo/ağırlık vb. (LogisticsFormData)
  deliveryTerm  ListingDeliveryTerm?
  paymentTerm   ListingPaymentTerm   @default(CASH)
  paymentDays   Int?
  paymentTiming ListingPaymentTiming @default(AFTER_DELIVERY)
  bidsOpenAt    DateTime?

  // İngiliz Usulü açık eksiltme ayarları.
  bidVisibility          ListingBidVisibility   @default(OWN_ONLY)
  priceDecrementType     ListingDecrementType?
  priceDecrementValue    Decimal?               @db.Decimal(18, 4)
  priceDecrementBasis    ListingDecrementBasis?
  decimalPlaces          Int                    @default(2)
  sendClosingReminder    Boolean                @default(false)
  reminderMinutesBefore  Int?
  autoExtendOnLateBid    Boolean                @default(false)
  autoExtendThresholdMin Int?
  autoExtendByMinutes    Int?

  bids             ListingBid[]
  orders           CompanyOrder[]
  items            ListingItem[]
  invitations      ListingInvitation[]
  documents        ListingDocument[]
  roundSnapshots   ListingRoundSnapshot[]
  approvalRequests ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([companyId, type])
  @@map("listings")
}

// İhale şablonu — wizard yapılandırmasını kaydet/kopyala (eski TenderTemplate).
model ListingTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  payload     Json // wizard config snapshot (başlık/format/kalemler/keywords/…)
  createdById String
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@map("listing_templates")
}

// Tedarikçi şablonu — sık birlikte davet edilen bağlı firma grubu (ihale
// sihirbazında tek tıkla davet). Üyeler bağlı firma id'leri (denormalize).
model SupplierTemplate {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  isPublic         Boolean  @default(true) // firmadaki herkes görebilir
  createdById      String
  memberCompanyIds String[] @default([]) // bağlı firma id'leri
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
  @@map("supplier_templates")
}

// İhale kalemi — bir ilanda birden çok satır (eski TenderItem).
model ListingItem {
  id              String    @id @default(cuid())
  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  lineNo          Int // sıra (1..n)
  name            String
  description     String?
  quantity        Decimal   @db.Decimal(18, 3)
  unit            String // adet, kg, m, paket…
  targetPrice     Decimal?  @db.Decimal(18, 2) // hedef birim fiyat (opsiyonel)
  // SATIS + kalem-bazlı fiyatlandırma: kalem taban / hemen-al BİRİM fiyatları.
  minUnitPrice    Decimal?  @db.Decimal(18, 2)
  buyNowUnitPrice Decimal?  @db.Decimal(18, 2)
  materialCode    String? // malzeme/stok kodu
  requiredByDate  DateTime? // istenen teslim tarihi
  awardedQuantity Decimal?  @db.Decimal(18, 3) // kısmi kazandırmada verilen miktar

  bidItems  ListingBidItem[]
  questions ListingItemQuestion[]

  createdAt DateTime @default(now())

  @@index([listingId])
  @@map("listing_items")
}

// Kalem başına tipli soru (eski item-question modal) — tedarikçi teklif verirken cevaplar.
model ListingItemQuestion {
  id         String                    @id @default(cuid())
  itemId     String
  item       ListingItem               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text       String
  answerType ListingQuestionAnswerType @default(TEXT)
  required   Boolean                   @default(false)

  createdAt DateTime @default(now())

  answers ListingBidAnswer[]

  @@index([itemId])
  @@map("listing_item_questions")
}

// Teklifin kalem sorusuna verdiği cevap (satıcı tarafı — Faz D).
model ListingBidAnswer {
  id         String              @id @default(cuid())
  bidId      String
  bid        ListingBid          @relation(fields: [bidId], references: [id], onDelete: Cascade)
  questionId String
  question   ListingItemQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String

  createdAt DateTime @default(now())

  @@unique([bidId, questionId])
  @@index([bidId])
  @@map("listing_bid_answers")
}

// Kayıtlı soru şablonu — firma kalem sorularını tekrar kullanmak için saklar.
model ListingQuestionTemplate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  items     Json // [{ text, answerType, required }]

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("listing_question_templates")
}

// İhale daveti — belirli bağlı tedarikçiyi ihaleye davet (eski TenderInvitation).
model ListingInvitation {
  id               String   @id @default(cuid())
  listingId        String
  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  invitedCompanyId String
  invitedCompany   Company  @relation("ListingInvitee", fields: [invitedCompanyId], references: [id], onDelete: Cascade)
  invitedById      String // CompanyUser (daveti gönderen)
  createdAt        DateTime @default(now())

  @@unique([listingId, invitedCompanyId])
  @@index([invitedCompanyId])
  @@map("listing_invitations")
}

// Kalem-bazlı teklif satırı — bir teklifin her kaleme verdiği birim fiyat.
model ListingBidItem {
  id        String      @id @default(cuid())
  bidId     String
  bid       ListingBid  @relation(fields: [bidId], references: [id], onDelete: Cascade)
  itemId    String
  item      ListingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitPrice Decimal     @db.Decimal(18, 2)
  note      String?
  // Kalem-özel teslim tarihi (opsiyonel) — boşsa teklifin genel teslim tarihi geçerli.
  deliveryDate DateTime?

  @@unique([bidId, itemId])
  @@index([bidId])
  @@map("listing_bid_items")
}

model CompanyUser {
  id        String  @id @default(cuid())
  email     String  @unique
  authId    String? @unique // Supabase auth bridge
  firstName String
  lastName  String
  phone     String?

  roles CompanyRole[] @default([])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  isActive            Boolean   @default(true)
  emailVerifiedAt     DateTime?
  twoFactorEnabled    Boolean   @default(false)
  twoFactorEnabledAt  DateTime?
  twoFactorSecret     String? // TOTP secret (base32) — 2FA açıkken dolu
  // Kurtarma kodları (SHA-256 hash) — enable'da üretilir, BİR KEZ gösterilir;
  // her kod tek kullanımlık (girişte/kapatmada tüketilir).
  twoFactorRecoveryCodes String[] @default([])
  // Oturum sürümü — parola değişince artar; eski JWT'ler geçersizleşir
  // (strategy her istekte DB'den doğrular).
  tokenVersion Int @default(0)
  permissionsOverride Json? // { added?: string[], removed?: string[] }
  notificationPrefs   Json?
  invitedById         String?
  invitedAt           DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime? // iş çıkışı — soft delete (geçmiş korunur, KVKK)

  // Kayıt sözleşme/rıza kayıtları (KVKK denetim izi).
  termsAcceptedAt          DateTime? // kullanıcı sözleşmesi
  mediationAcceptedAt      DateTime? // platform aracılık ve kullanım sözleşmesi
  kvkkAcceptedAt           DateTime? // KVKK aydınlatma bilgilendirmesi
  marketingConsent         Boolean   @default(false) // pazarlama/analitik (ticari ileti)
  profileImprovementConsent Boolean  @default(false) // profil/hizmet iyileştirme

  passwordResetTokens   PasswordResetToken[]
  emailVerificationCodes EmailVerificationCode[]
  notifications         Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("company_users")
}

enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

/**
 * Token'lı kullanıcı daveti — hesap davet KABULÜNDE açılır (KVKK/consent:
 * kullanıcı adını/parolasını kendisi belirler, sözleşmeleri kendisi onaylar).
 * TTL 7 gün; süre dolunca okuma anında EXPIRED'a çekilir.
 */
model CompanyUserInvitation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email  String
  roles  CompanyRole[]           @default([])
  token  String                  @unique // crypto.randomBytes(32).hex — kabul linki
  status CompanyInvitationStatus @default(PENDING)

  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([email, status])
  @@map("company_user_invitations")
}

/**
 * Uygulama-içi bildirim (e-postaya ek). KULLANICI bazında — her aktif kullanıcı
 * kendi zilini/okundu durumunu görür. Bir firmaya bildirim = firmanın aktif
 * kullanıcılarına fan-out (tercihine göre filtrelenir). type, notification-prefs
 * anahtarına eşlenir (kapatılabilir olanlar pref'e saygı duyar).
 */
model Notification {
  id            String   @id @default(cuid())
  companyUserId String
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  companyId     String // denormalize — firma kapsamı/temizlik için

  type     String // ör. listing_category_match, listing_invitation, bid_awarded
  // Bildirim hangi portala ait: "satinalma" | "satis" | null (ortak — bağlantı
  // gibi). Zil/sayaç AKTİF portalı (+ ortak) gösterir; satış bildirimi saf
  // satın almacıya HİÇ oluşturulmaz (alıcı filtresi üretim anında uygular).
  portal   String?
  title    String
  body     String
  ctaUrl   String?
  ctaLabel String?
  listingId String? // bağlam referansı (opsiyonel)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyUserId, portal, readAt])
  @@index([companyUserId, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────
// Onay akışı (eski tenant-approval sisteminin birleşik Company karşılığı).
// Firma, ilan YAYIN ve KAZANDIRMA için çok-adımlı sıralı onay zinciri tanımlar.
// ─────────────────────────────────────────────────────────────────────────

enum ApprovalType {
  LISTING_PUBLISH // ilan yayını onayı
  LISTING_AWARD // kazandırma onayı
}

enum ApprovalFlowStatus {
  DRAFT // taslak — devrede değil
  ACTIVE // devrede
  PASSIVE // pasife alındı
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStepStatus {
  WAITING // sırası gelmedi
  PENDING // sırası geldi, onaycı bekleniyor
  APPROVED
  REJECTED
  SKIPPED // bütçe eşiği altı — atlandı
}

// Firma genelinde tanımlı onay kuralı (ALIM + SATIS).
model ApprovalFlow {
  id             String             @id @default(cuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  type           ApprovalType
  status         ApprovalFlowStatus @default(DRAFT)
  // Sadece bu ilan tipine uygulanır (null = her ikisi).
  listingType    ListingType?
  // Bu akışı başlatabilen roller (boşsa kısıt yok).
  initiatorRoles CompanyRole[]      @default([])
  steps          ApprovalFlowStep[]
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([companyId, type, status])
  @@map("approval_flows")
}

// Akıştaki sıralı bir onay adımı.
model ApprovalFlowStep {
  id                 String       @id @default(cuid())
  flowId             String
  flow               ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  order              Int // 1..n
  approverUserId     String // onaylayacak CompanyUser id
  // Diagramda gösterilen yumuşak etiket (örn. "Satınalma Müdürü").
  displayLabel       String?
  // Bu eşik ALTINDAysa adım atlanır (SKIPPED). null = her zaman gerekli.
  conditionMinAmount Decimal?     @db.Decimal(18, 2)
  createdAt          DateTime     @default(now())

  @@unique([flowId, order])
  @@index([flowId])
  @@map("approval_flow_steps")
}

// Çalışma anı onay isteği (ilan yayın/kazandırma anında oluşur).
model ApprovalRequest {
  id          String                @id @default(cuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listingId   String
  listing     Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type        ApprovalType
  status      ApprovalRequestStatus @default(PENDING)
  // İnsan-okur onay numarası: APR-YYYY-NNNN (firma bazında benzersiz).
  requestNo   String?
  amount      Decimal               @db.Decimal(18, 2) // snapshot (kural sonradan değişse de bağımsız)
  currency    Currency              @default(TRY)
  // Onaylanınca tetiklenecek işlemin verisi (örn. kazandırma seçimleri).
  payload     Json?
  // Başlatanın onaycılara notu (yayın/kazandırma anında girilir).
  initiatorNote String?
  steps       ApprovalRequestStep[]
  createdById String
  decidedAt   DateTime?
  // Bekleyen onay hatırlatması — günde-bir-kez dedup için son gönderim damgası.
  lastReminderAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([companyId, requestNo])
  @@index([companyId, status, type])
  @@index([listingId])
  @@map("approval_requests")
}

// İstek başına sıralı onay adımı.
model ApprovalRequestStep {
  id             String             @id @default(cuid())
  requestId      String
  request        ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order          Int
  approverUserId String
  // Akış adımından snapshot — kural sonradan değişse de görünen etiket sabit.
  displayLabel   String?
  status         ApprovalStepStatus @default(WAITING)
  note           String?
  decidedAt      DateTime?
  createdAt      DateTime           @default(now())

  @@unique([requestId, order])
  @@index([approverUserId, status])
  @@map("approval_request_steps")
}

// ─────────────────────────────────────────────────────────────────────────
// Adres defteri (eski firma-tercihleri) — FATURA / TESLIMAT adresleri.
// İhale wizard'ında fatura/teslimat adresi seçimine bağlanabilir.
// ─────────────────────────────────────────────────────────────────────────

enum CompanyAddressType {
  FATURA
  ILETISIM
  TESLIMAT
}

// Banka hesabı defteri — sipariş kabulünde IBAN elle yazılmaz, buradan seçilir
// (adres defteri deseni). Tek varsayılan hesap.
model CompanyBankAccount {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String // "TL Vadesiz — İş Bankası" vb.
  accountHolder String
  iban          String
  bankName      String?
  isDefault     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("company_bank_accounts")
}

model CompanyAddress {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        CompanyAddressType
  title       String // "Merkez", "Depo", "Şube" vb.
  contactName String?
  phone       String?
  country     String             @default("TR")
  city        String?
  district    String?
  addressLine String
  postalCode  String?
  // FATURA adresi için vergi bilgisi (opsiyonel).
  taxOffice   String?
  taxNumber   String?
  isDefault   Boolean            @default(false)

  bidDeliveries ListingBid[] @relation("BidDeliveryAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, type])
  @@map("company_addresses")
}
