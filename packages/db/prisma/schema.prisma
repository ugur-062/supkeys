generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supavisor pooler (port 6543, transaction mode) — runtime sorgular.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — prisma migrate ve introspect için.
  // Supabase'e geçtikten sonra zorunlu; local Docker'da DATABASE_URL ile aynıdır.
  directUrl = env("DIRECT_URL")
}

// ============================================================
// SUPKEYS — Çekirdek Şema
// ============================================================

// ---------- TENANT TARAFI (müşteri firmalar) ----------

model Tenant {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  // Faz 3 madde 6 — kalıcı "Supkeys ID" (Crockford Base32, ör. K7X9-3M2P).
  // Tedarikçiler bu ID ile alıcıyı bulup bağlantı isteği gönderebilir.
  // Legacy satırlarda NULL olabilir; backfill + creation'da set edilir.
  supkeysId String? @unique

  // Firma profili (registration sırasında dolar)
  industry    String?
  // Ülke — ISO 3166-1 alpha-2 (TR varsayılan). TR=strict VKN/TCKN + il/ilçe;
  // diğer ülkeler=gevşek vergi no + serbest adres (state/province).
  country     String  @default("TR")
  city        String?
  district    String?
  addressLine String?
  postalCode  String?
  // Yabancı firmalarda eyalet/bölge (TR'de boş; il/ilçe kullanılır).
  stateRegion String?
  taxNumber   String? @unique
  taxOffice   String?

  // ============================================================
  // Madde 29 — 3 aşamalı kayıt/onboarding/doğrulama (alıcı tarafı).
  // FAZ 2 (onboarding wizard) + FAZ 3 (panel-içi doğrulama) ortak alanları.
  // ============================================================
  // FAZ 2 — firma kimliği
  companyType  CompanyType?
  legalName    String? // yasal firma ünvanı (name = ticari ad)
  neighborhood String? // mahalle
  billingTitle String? // fatura ünvanı
  billingEmail String?
  // FAZ 2 — yetkili kişi (ad/soyad FAZ 1'den User'da)
  authorizedTckn  String? // 11 hane
  authorizedTitle String? // ünvan/rol (Yönetici, Müdür vb.)
  // FAZ 2 — faaliyet sektörü. sectorCategoryIds = ANA kategoriler (UNSPSC
  // segment ID'leri, en fazla 3). subCategoryIds = ALT kategoriler (family/
  // class/commodity, sınırsız). Tender eşleştirme/sıralaması ikisini kullanır.
  sectorCategoryIds String[] @default([])
  subCategoryIds    String[] @default([])
  // FAZ 3 — kurumsal kimlik (panel içinde sonradan doldurulur)
  mersisNo               String? // boş veya 16 hane
  tradeRegistryNo        String?
  kepAddress             String?
  iban                   String? // TR, 26 hane
  ibanHolder             String?
  billingPhone           String?
  billingPhoneVerifiedAt DateTime?
  // FAZ 3 — 6 zorunlu doğrulama belgesi (R2 key)
  docTaxPlateUrl          String? // Vergi Levhası
  docTradeRegistryUrl     String? // Ticaret Sicil Gazetesi
  docSignatureCircularUrl String? // İmza Sirküleri
  docActivityCertUrl      String? // Faaliyet Belgesi
  docIdFrontUrl           String? // Yetkili Kimlik — Ön
  docIdBackUrl            String? // Yetkili Kimlik — Arka
  // Durum
  onboardingCompletedAt     DateTime?
  companyVerificationStatus CompanyVerificationStatus @default(UNVERIFIED)
  companyVerifiedAt         DateTime?

  // Alıcı public profili — tedarikçilerin gördüğü herkese açık sayfa (/firma/[slug]).
  // publicEnabled=true ise profil + "Tedarikçi Ol" yayında; false ise 404.
  publicEnabled  Boolean  @default(false)
  aboutText      String?
  website        String?
  logoUrl        String? // R2 key (logo)
  coverImageUrl  String? // R2 key (kapak görseli)
  linkedinUrl    String?
  instagramUrl   String?
  /// Kısa hizmet/uzmanlık etiketleri (örn. ["Tekstil", "Lojistik"]). Max 20.
  services       String[] @default([])
  /// Firma kuruluş yılı (4 haneli).
  foundedYear    Int?
  /// Çalışan sayısı bandı — serbest metin (örn. "50-100").
  employeeCount  String?
  /// Sertifika/ödül etiketleri (örn. ["ISO 9001"]). Max 20.
  certifications String[] @default([])

  // V2-6.5 — Tenant başına BUYER (Satın Almacı) kontenjanı. Super-admin
  // yönetir. APPROVER ve COMPANY_ADMIN sayılmaz; sadece role = BUYER sayılır.
  buyerSeatLimit Int @default(2)

  // V2-6.5 — Üyelik bitiş tarihi. NULL = sınırsız (legacy/dev). Tarihten
  // sonra tenant kullanıcıları login olamaz; admin login etkilenmez.
  // Super-admin 1-12 ay opsiyonlarıyla uzatır.
  membershipEndAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  buyerApplication    BuyerApplication?        @relation("BuyerAppTenant")
  supplierInvitations SupplierInvitation[]
  supplierRelations   SupplierTenantRelation[]
  invitedSupplierApps SupplierApplication[]    @relation("SupplierAppInviter")
  tenders             Tender[]
  orders              Order[]
  userInvitations     UserInvitation[]
  addresses           TenantAddress[]
  approvalFlows       ApprovalFlow[]
  approvalRequests    ApprovalRequest[]
  /// V2-REVIEWS — Bu alıcı firmanın yazdığı tedarikçi değerlendirmeleri.
  supplierReviews     SupplierReview[]
  attachments         Attachment[]
  messageThreads      MessageThread[]          @relation("TenantMessageThreads")
  questionTemplates   QuestionTemplate[]
  supplierTemplates   SupplierTemplate[]
  tenderTemplates     TenderTemplate[]

  @@map("tenants")
}

model TenantAddress {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type  AddressType
  title String

  // Adres bilgileri
  country     String  @default("Türkiye")
  state       String?
  city        String
  district    String
  fullAddress String  @db.Text
  postalCode  String?

  // Sadece FATURA için (yine de optional — backend zorunlu kılar)
  taxOffice String?
  taxNumber String?

  // İletişim (opsiyonel)
  contactName  String?
  contactPhone String?
  contactEmail String?

  // Status
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, type, isActive])
  @@index([tenantId, type, isDefault])
  @@map("tenant_addresses")
}

enum AddressType {
  FATURA
  ILETISIM
  TESLIMAT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  // Supabase Auth bridge — `auth.users.id` (UUID). Migration sırasında nullable;
  // her aktif kullanıcı için zorunlu hâle gelecek (V2).
  authId       String?   @unique
  // Supabase Auth source-of-truth olduktan sonra bcrypt hash gereksiz; legacy
  // / migration kayıtları için nullable bırakıldı, V2'de DROP edilecek.
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  role         UserRole  @default(BUYER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  // Madde 29 — signup sonrası e-posta KOD doğrulaması (alıcı, davetle).
  // Doğrulanana kadar login engellenir. Mevcut kullanıcılar backfill edilir.
  emailVerifiedAt DateTime?

  // Madde 29 — FAZ 3: e-posta tabanlı 2 adımlı doğrulama. İhale kapısının
  // ikinci gereksinimi. (OTP challenge'ı login akışında transient üretilir.)
  twoFactorEnabled   Boolean   @default(false)
  twoFactorEnabledAt DateTime?

  // E.7.A — davetle eklenen kullanıcılar için
  invitedById String?
  invitedBy   User?     @relation("UserInvitedBy", fields: [invitedById], references: [id])
  invitees    User[]    @relation("UserInvitedBy")
  invitedAt   DateTime?

  // E.7.A — kategori bazlı bildirim tercihleri (key: boolean)
  notificationPrefs Json?

  // V2-6.5 — RBAC override: { added?: string[], removed?: string[] }
  // null = saf role default; dolu = role default'undan eklenen/eksiltilen permission'lar
  permissionsOverride Json?

  // V2-6.5 — Soft delete. Firma yöneticisi "Sil" deyince:
  // deletedAt=now, isActive=false, kişisel veriler anonimleştirilir
  // (KVKK/GDPR + e-posta tekrar kullanılabilir). Tender/Order referansları
  // KIRILMAZ; sadece kullanıcı listede gizli + login engelli.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sentSupplierInvitations SupplierInvitation[]
  tendersCreated          Tender[]             @relation("TendersCreated")
  sentUserInvitations     UserInvitation[]     @relation("UserInvitationInviter")

  // E.7.C — onay akışı reverse relations
  createdApprovalFlows ApprovalFlow[]          @relation("ApprovalFlowCreatedBy")
  initiatorOfFlows     ApprovalFlowInitiator[] @relation("ApprovalFlowInitiatorUser")
  approverOfFlows      ApprovalFlowStep[]      @relation("ApprovalFlowStepApprover")

  // E.7.D — onay request reverse relations
  initiatedApprovalRequests ApprovalRequest[]     @relation("InitiatedApprovalRequests")
  approverOfRequestSteps    ApprovalRequestStep[] @relation("ApproverOfRequestSteps")
  /// V2-REVIEWS — Bu kullanıcının yazdığı tedarikçi değerlendirmeleri.
  supplierReviewsCreated    SupplierReview[]      @relation("SupplierReviewsCreated")

  // V1.5 — sipariş workflow reverse relations
  ordersDeliveryStarted Order[] @relation("OrderDeliveryStarted")
  ordersCompleted       Order[] @relation("OrderCompleted")
  ordersCancelled       Order[] @relation("OrderCancelled")

  // V2-2 — R2 dosya yükleme
  uploadedAttachments Attachment[] @relation("UploadedAttachments")

  // V2-6.5 — Admin tarafından üretilen parola sıfırlama linkleri
  passwordResetTokens PasswordResetToken[]

  // V2-7+ — Şablon sahipliği (createdBy)
  createdQuestionTemplates QuestionTemplate[] @relation("QuestionTemplateCreatedBy")
  createdSupplierTemplates SupplierTemplate[] @relation("SupplierTemplateCreatedBy")
  createdTenderTemplates   TenderTemplate[]   @relation("TenderTemplateCreatedBy")

  @@index([tenantId])
  @@map("users")
}

// V2-6.5 — Admin destek operasyonları için tek-kullanımlık parola
// sıfırlama tokenleri. Token plain DB'de tutulmaz; sadece SHA-256
// hash'i saklanır. Süresi 1 saat (TTL service'te enforce edilir).
model PasswordResetToken {
  id               String        @id @default(cuid())
  // Alıcı (User) VEYA tedarikçi (SupplierUser) kullanıcısı — biri dolu.
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierUserId   String?
  supplierUser     SupplierUser? @relation(fields: [supplierUserId], references: [id], onDelete: Cascade)
  companyUserId    String?
  companyUser      CompanyUser?  @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  tokenHash        String        @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime      @default(now())
  createdByAdminId String?

  @@index([userId])
  @@index([supplierUserId])
  @@index([companyUserId])
  @@map("password_reset_tokens")
}

model UserInvitation {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        UserRole
  token       String               @unique
  invitedById String
  invitedBy   User                 @relation("UserInvitationInviter", fields: [invitedById], references: [id])
  status      UserInvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  cancelledAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([tenantId, email, status])
  @@index([token])
  @@map("user_invitations")
}

enum UserInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum UserRole {
  COMPANY_ADMIN
  BUYER
  APPROVER
}

// ---------- PLATFORM TARAFI (Supkeys ekibi) ----------

model PlatformAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  // Supabase Auth bridge — `auth.users.id` (UUID).
  authId       String?   @unique
  passwordHash String?
  firstName    String
  lastName     String
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedDemoRequests         DemoRequest[]
  reviewedBuyerApplications    BuyerApplication[]    @relation("BuyerAppReviewer")
  reviewedSupplierApplications SupplierApplication[] @relation("SupplierAppReviewer")

  @@map("platform_admins")
}

enum AdminRole {
  SUPER_ADMIN // her şey
  SALES // demo, tenant
  SUPPORT // sadece okuma + tenant impersonate
}

// ---------- LEAD / DEMO TALEPLERİ ----------

model DemoRequest {
  id           String            @id @default(cuid())
  companyName  String
  contactName  String
  email        String
  phone        String?
  jobTitle     String?
  companySize  String?
  message      String?
  status       DemoRequestStatus @default(NEW)
  source       String?
  notes        String?
  contactedAt  DateTime?
  closedAt     DateTime?
  closedReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  assignedToId String?
  assignedTo   PlatformAdmin? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  // ---------- DAVET (admin → demo görüşmesinden sonra kayıt linki) ----------
  inviteToken       String?   @unique // sha256 hash; ham token sadece e-postada
  inviteSentAt      DateTime?
  inviteSentToEmail String? // davet hangi e-postaya gönderildi (demo.email'den farklı olabilir)
  inviteSentMessage String? // admin'in kişisel notu
  inviteTokenExpAt  DateTime?
  inviteUsedAt      DateTime? // tek kullanımlık
  inviteSentCount   Int       @default(0)

  // Davetten kayıt akışı tamamlanınca bağlanan başvuru
  linkedApplicationId String?           @unique
  linkedApplication   BuyerApplication? @relation("DemoToBuyerApp", fields: [linkedApplicationId], references: [id])

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("demo_requests")
}

enum DemoRequestStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  DEMO_DONE
  WON
  LOST
  SPAM
}

// ---------- E-POSTA LOGLARI ----------

model EmailLog {
  id                String      @id @default(cuid())
  template          String
  toEmail           String
  toName            String?
  subject           String
  provider          String
  providerMessageId String?     @unique
  status            EmailStatus @default(QUEUED)
  errorMessage      String?
  payload           Json?
  attemptCount      Int         @default(0)
  queuedAt          DateTime    @default(now())
  sentAt            DateTime?
  failedAt          DateTime?

  // V2-1 — Resend webhook delivery tracking
  deliveredAt  DateTime?
  openedAt     DateTime? // ilk açılma
  clickedAt    DateTime? // ilk tıklama
  bouncedAt    DateTime?
  bounceType   String? // "hard" | "soft" | "undetermined"
  bounceReason String?   @db.Text
  complainedAt DateTime?

  events EmailEvent[]

  contextType String?
  contextId   String?

  @@index([status])
  @@index([toEmail])
  @@index([template])
  @@index([contextType, contextId])
  @@index([queuedAt])
  @@map("email_logs")
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  // V2-1 — Resend webhook tracking
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
}

// V2-1 — Resend webhook event audit trail
model EmailEvent {
  id         String   @id @default(cuid())
  emailLogId String
  emailLog   EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  /// Webhook idempotency key (svix-id header). Aynı event 2 kez işlenmesin.
  eventId    String         @unique
  eventType  EmailEventType
  /// Resend payload'tan gelen orijinal timestamp.
  occurredAt DateTime
  payload    Json

  /// CLICKED event için tıklanan link.
  clickedUrl   String? @db.Text
  /// BOUNCED event için bounce detay.
  bounceType   String?
  bounceReason String? @db.Text

  createdAt DateTime @default(now())

  @@index([emailLogId, occurredAt])
  @@index([eventType])
  @@map("email_events")
}

enum EmailEventType {
  SENT
  DELIVERED
  DELIVERY_DELAYED
  BOUNCED
  COMPLAINED
  OPENED
  CLICKED
  FAILED
}

// ============================================================
// REGISTRATION & APPLICATIONS
// ============================================================

model BuyerApplication {
  id String @id @default(cuid())

  companyName String
  companyType CompanyType
  taxNumber   String
  taxOffice   String
  taxCertUrl  String
  industry    String?
  website     String?

  city        String
  district    String
  addressLine String
  postalCode  String?

  adminFirstName String
  adminLastName  String
  adminEmail     String
  adminPhone     String?
  // Supabase Auth geçişi sonrası kullanılmıyor — onay anında Supabase
  // sendPasswordResetEmail tetikleniyor, applicant şifresini sıfırlama
  // linkiyle kuruyor. V2'de DROP edilecek.
  passwordHash   String?

  status ApplicationStatus @default(PENDING_EMAIL_VERIFICATION)

  // DEPRECATED — eski link-tabanlı e-posta doğrulama kaldırıldı (2026-06-24).
  // Canlı kayıt 6-haneli kod (TwoFactorChallenge) kullanır. Kolonlar inert;
  // ileride bir migration ile drop edilebilir.
  emailToken      String?   @unique
  emailTokenExp   DateTime?
  emailVerifiedAt DateTime?

  reviewedById    String?
  reviewedBy      PlatformAdmin? @relation("BuyerAppReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  tenantId String? @unique
  tenant   Tenant? @relation("BuyerAppTenant", fields: [tenantId], references: [id])

  // Demo görüşmesi sonrası gönderilen davetle mi geldi?
  fromDemoRequest DemoRequest? @relation("DemoToBuyerApp")

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminEmail, status])
  @@index([status])
  @@index([adminEmail])
  @@index([createdAt])
  @@map("buyer_applications")
}

model SupplierApplication {
  id String @id @default(cuid())

  companyName        String
  companyType        CompanyType
  taxNumber          String
  taxOffice          String
  taxCertUrl         String
  // G9 madde 27 — "Tedarikçi Ol" (CONNECT_REQUEST) başvurusunda zorunlu KYC
  // belgeleri. Admin KYC adımında incelenir. Normal başvuruda null kalır.
  ticariSicilUrl     String?
  imzaSirkuleriUrl   String?
  bankaOnayliIbanUrl String?
  industry           String?
  website            String?

  city        String
  district    String
  addressLine String
  postalCode  String?

  adminFirstName String
  adminLastName  String
  adminEmail     String
  adminPhone     String?
  // Supabase Auth geçişi sonrası kullanılmıyor — bkz. BuyerApplication.passwordHash.
  passwordHash   String?

  // V2-6 — register sırasında seçilen kategori ID'leri (Family seviyesi).
  // Admin onayında Supplier oluşturulurken SupplierCategory junction'a aktarılır.
  categoryIds Json?

  status ApplicationStatus @default(PENDING_EMAIL_VERIFICATION)
  // Başvuru kaynağı — CONNECT_REQUEST ise admin onayında ilişki PENDING_TENANT_APPROVAL kurulur.
  source ApplicationSource @default(SELF_REGISTER)

  // DEPRECATED — eski link-tabanlı e-posta doğrulama kaldırıldı (2026-06-24).
  // Canlı kayıt 6-haneli kod (TwoFactorChallenge) kullanır. Kolonlar inert;
  // ileride bir migration ile drop edilebilir.
  emailToken      String?   @unique
  emailTokenExp   DateTime?
  emailVerifiedAt DateTime?

  invitationId      String?             @unique
  invitation        SupplierInvitation? @relation(fields: [invitationId], references: [id])
  invitedByTenantId String?
  invitedByTenant   Tenant?             @relation("SupplierAppInviter", fields: [invitedByTenantId], references: [id])

  reviewedById    String?
  reviewedBy      PlatformAdmin? @relation("SupplierAppReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  supplierId String?   @unique
  supplier   Supplier? @relation("SupplierAppSupplier", fields: [supplierId], references: [id])

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([adminEmail])
  @@index([invitedByTenantId])
  @@index([createdAt])
  @@map("supplier_applications")
}

enum ApplicationStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Başvurunun kaynağı. CONNECT_REQUEST = alıcı public profilinden "Tedarikçi Ol".
enum ApplicationSource {
  SELF_REGISTER
  TENANT_INVITE
  CONNECT_REQUEST
}

/// Alıcı-tedarikçi ilişkisinin nasıl kurulduğu.
/// CONNECT_REQUEST = tedarikçi kendi isteğiyle başvurdu (alıcı onayı bekler).
enum RelationOrigin {
  ADMIN
  INVITE
  CONNECT_REQUEST
}

enum CompanyType {
  JOINT_STOCK
  LIMITED
  SOLE_PROPRIETOR
}

// Madde 29 — FAZ 3 panel-içi şirket doğrulaması (6 belge + KYC onayı).
// Hem Tenant (alıcı) hem Supplier (tedarikçi) için aynı durum makinesi.
enum CompanyVerificationStatus {
  UNVERIFIED // belge yok / eksik
  PENDING // 6/6 belge yüklendi, admin onayı bekliyor
  VERIFIED // onaylandı — ihale/premium kapısı açık
  REJECTED // reddedildi (eksik/hatalı belge)
}

// ============================================================
// SUPPLIER (gerçek tedarikçi entitysi)
// ============================================================

model Supplier {
  id                String             @id @default(cuid())
  // Faz 3 madde 6 — kalıcı "Supkeys ID"; alıcılar bu ID ile tedarikçiyi
  // bulup bağlantı kurabilir. Legacy NULL olabilir; backfill + creation'da set.
  supkeysId         String?            @unique
  companyName       String
  companyType       CompanyType
  // Madde 29 — hesap, şirket bilgisinden önce (signup) oluşur; taxNumber
  // onboarding'de doldurulur. unique + nullable (signup'ta boş; diğer zorunlu
  // string alanlar signup'ta "" placeholder, onboarding doldurur).
  taxNumber         String?            @unique
  // Vergi dairesi — TR'ye özgü; yabancı firmada boş (nullable).
  taxOffice         String?
  // Vergi levhası kayıttan çıktı → FAZ 3 (docTaxPlateUrl). Legacy alan nullable.
  taxCertUrl        String?
  industry          String?
  website           String?
  // Ülke — ISO 3166-1 alpha-2 (TR varsayılan). TR dışı = yabancı firma.
  country           String  @default("TR")
  city              String
  // İlçe — TR'ye özgü; yabancıda boş (eyalet/bölge kullanılır).
  district          String?
  addressLine       String
  postalCode        String?
  // Yabancı firmalarda eyalet/bölge (TR'de boş).
  stateRegion       String?

  // ============================================================
  // Madde 29 — 3 aşamalı kayıt/onboarding/doğrulama (tedarikçi tarafı).
  // FAZ 2 + FAZ 3 ortak alanları. (mersisNo aşağıda V2-TRUST bloğunda mevcut.)
  // ============================================================
  // FAZ 2 — firma kimliği
  legalName    String? // yasal firma ünvanı (companyName = ticari ad)
  neighborhood String? // mahalle
  billingTitle String? // fatura ünvanı
  billingEmail String?
  // FAZ 2 — yetkili kişi
  authorizedTckn  String?
  authorizedTitle String?
  // FAZ 2 — faaliyet sektörleri. sectors (kürasyonlu) DEPRECATED — UNSPSC'ye
  // geçildi. sectorCategoryIds = ANA kategoriler (UNSPSC segment, en fazla 3),
  // subCategoryIds = ALT kategoriler (sınırsız). Tender eşleştirme bunları kullanır.
  sectors           String[] @default([])
  sectorCategoryIds String[] @default([])
  subCategoryIds    String[] @default([])
  // FAZ 2 — teslimat adresi (fatura adresinden farklıysa). "Fatura adresimi
  // teslimat adresi yap" tiki ile fatura adresinden kopyalanabilir.
  deliveryCity         String?
  deliveryDistrict     String?
  deliveryNeighborhood String?
  deliveryAddressLine  String?
  deliveryPostalCode   String?
  // FAZ 3 — kurumsal kimlik
  tradeRegistryNo        String?
  kepAddress             String?
  iban                   String?
  ibanHolder             String?
  billingPhone           String?
  billingPhoneVerifiedAt DateTime?
  // FAZ 3 — 6 zorunlu doğrulama belgesi (R2 key)
  docTaxPlateUrl          String?
  docTradeRegistryUrl     String?
  docSignatureCircularUrl String?
  docActivityCertUrl      String?
  docIdFrontUrl           String?
  docIdBackUrl            String?
  // Durum
  onboardingCompletedAt     DateTime?
  companyVerificationStatus CompanyVerificationStatus @default(UNVERIFIED)
  companyVerifiedAt         DateTime?

  membership        SupplierMembership @default(STANDARD)
  isActive          Boolean            @default(true)
  isBlocked         Boolean            @default(false)
  // "Tedarikçi Ol" (self-request) ile bir alıcıya bağlanınca dolar — kota: ömür boyu 1 kez.
  selfRequestUsedAt DateTime?
  blockedReason     String?
  blockedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // ============================================================
  // V2-PUBLIC-PROFILE — PREMIUM tedarikçilerin herkese açık profili
  // ============================================================
  /// URL slug (örn. /t/abc-tekstil). Null ise public profil 404.
  /// PREMIUM upgrade akışında otomatik üretilir; editör'den değiştirilebilir.
  slug              String?  @unique
  /// Opt-out: PREMIUM olur olmaz default açık. Editor'den kapatılabilir.
  publicEnabled     Boolean  @default(true)
  coverImageUrl     String?
  /// Logo (profil resmi). Hero'da initials yerine gösterilir. R2 key.
  logoImageUrl      String?
  aboutText         String?
  linkedinUrl       String?
  instagramUrl      String?
  /// Kısa hizmet etiketleri (örn. ["Tekstil", "Hazır Giyim"]).
  services          String[] @default([])
  /// Firma kuruluş yılı (4 haneli, örn. 1995). Hero'da gösterilir.
  foundedYear       Int?
  /// Çalışan sayısı bandı — serbest metin (örn. "50-100", "100+", "10'dan az").
  employeeCount     String?
  /// Sertifika/ödül etiketleri (örn. ["ISO 9001", "OEKO-TEX"]).
  certifications    String[] @default([])
  /// V2-TRUST — MERSİS numarası (10 haneli). Sadece kurumsal firmalar girer.
  mersisNo          String?
  /// V2-TRUST — Vergi no + vergi dairesi public profilde gözüksün mü.
  /// SOLE_PROPRIETOR (şahıs) için backend reddeder (TC kimlik = KVKK kişisel veri).
  publicShowTaxInfo Boolean  @default(false)
  /// V2-TRUST — MERSİS no public profilde gözüksün mü. SOLE_PROPRIETOR'da yok.
  publicShowMersis  Boolean  @default(false)

  users               SupplierUser[]
  tenantRelations     SupplierTenantRelation[]
  application         SupplierApplication?     @relation("SupplierAppSupplier")
  invitationsAccepted SupplierInvitation[]     @relation("AcceptedBySupplier")
  tenderInvitations   TenderInvitation[]
  bids                Bid[]
  orders              Order[]
  messageThreads      MessageThread[]          @relation("SupplierMessageThreads")
  categories          SupplierCategory[]
  // V2-7+ — Tedarikçi şablonu üyelikleri
  templateMemberships SupplierTemplateMember[]
  // V2-PUBLIC-PROFILE — galeri fotoğrafları
  photos              SupplierPhoto[]
  // V2-REVIEWS — alıcılardan gelen değerlendirmeler
  reviews             SupplierReview[]
  // Ekip — firma kullanıcı davetleri
  userInvitations     SupplierUserInvitation[]
  // G6 madde 20 — kayıtlı banka hesapları
  banks               SupplierBank[]
  // G9 madde 26 — sertifika/belgeler (ISO vb.), public profilde görünür
  certificates        SupplierCertificate[]

  @@index([taxNumber])
  @@index([membership])
  @@map("suppliers")
}

/// G9 madde 26 — Tedarikçi sertifika/belgeleri (ISO vb.). Tedarikçi serbestçe
/// yükler; herkese açık profilde görünür.
model SupplierCertificate {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  name    String
  fileUrl String

  createdAt DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_certificates")
}

/// G6 madde 20 — Tedarikçinin kayıtlı banka hesapları. Sipariş onayında
/// seçilir (otomatik doldurur). Yalnızca yönetici (isManager) düzenler.
model SupplierBank {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  accountHolder String
  iban          String
  bankName      String?
  label         String?
  isDefault     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@map("supplier_banks")
}

/// Ekip — tedarikçi firmasına yeni çalışan davet (rolsüz, herkes eşit).
model SupplierUserInvitation {
  id          String               @id @default(cuid())
  supplierId  String
  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  email       String
  token       String               @unique
  invitedById String
  invitedBy   SupplierUser         @relation("SupplierUserInvitationInviter", fields: [invitedById], references: [id])
  status      UserInvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  cancelledAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([supplierId, email, status])
  @@index([token])
  @@map("supplier_user_invitations")
}

/// V2-PUBLIC-PROFILE — Tedarikçi profil galerisi (R2'da host edilen fotolar).
model SupplierPhoto {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_photos")
}

/// V2-REVIEWS — Sipariş-sonu alıcı değerlendirmesi (1-5 yıldız + opsiyonel metin).
/// Tek sipariş için tek değerlendirme (idempotent — orderId unique).
/// 30 günlük düzenleme penceresi servis seviyesinde uygulanır.
model SupplierReview {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Yazan kullanıcı silinirse review kalır (anonim olur).
  createdById String?
  createdBy   User?    @relation("SupplierReviewsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  /// 1-5; servis seviyesinde validasyon.
  rating      Int
  reviewText  String?
  /// Buyer "gizli" işaretlerse aggregate'a girer ama liste'de görünmez.
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId])
  @@index([tenantId])
  @@map("supplier_reviews")
}

enum SupplierMembership {
  STANDARD // Davet ile veya self-register, ücretsiz (eski adı: BRONZE)
  PREMIUM // Havuza açık, ücretli (V2'de aktif olur, eski adı: SILVER)
}

model SupplierUser {
  id                String    @id @default(cuid())
  email             String    @unique
  // Supabase Auth bridge — `auth.users.id` (UUID).
  authId            String?   @unique
  passwordHash      String?
  firstName         String
  lastName          String
  phone             String?
  isActive          Boolean   @default(true)
  // Madde 29 — signup sonrası e-posta KOD doğrulaması; doğrulanana kadar login
  // engellenir. Mevcut kullanıcılar migration'da backfill edilir.
  emailVerifiedAt   DateTime?
  // G6 madde 20 — firma yöneticisi. Kuran (ilk kayıt) = true. Yönetici ek
  // olarak kullanıcı yönetimi + banka hesaplarını kontrol eder.
  isManager         Boolean   @default(false)
  // Madde 29 — FAZ 3: e-posta tabanlı 2 adımlı doğrulama.
  twoFactorEnabled   Boolean   @default(false)
  twoFactorEnabledAt DateTime?
  // Ayarlar — e-posta bildirim tercihleri (key: boolean). null = tüm varsayılan açık.
  notificationPrefs Json?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  bidsSubmitted Bid[]

  // V2-2 — R2 dosya yükleme
  uploadedAttachments Attachment[] @relation("UploadedAttachmentsSupplier")

  // Ekip — bu kullanıcının gönderdiği davetler
  sentInvitations SupplierUserInvitation[] @relation("SupplierUserInvitationInviter")

  passwordResetTokens PasswordResetToken[]

  @@index([supplierId])
  @@map("supplier_users")
}

model SupplierTenantRelation {
  id            String         @id @default(cuid())
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status        RelationStatus @default(ACTIVE)
  // İlişkinin kaynağı — CONNECT_REQUEST + PENDING_TENANT_APPROVAL = alıcı onayı bekleyen "Tedarikçi Ol" isteği.
  origin        RelationOrigin @default(INVITE)
  requestedAt   DateTime?
  decidedAt     DateTime?
  decidedById   String?
  blockedAt     DateTime?
  blockedReason String?
  createdAt     DateTime       @default(now())

  @@unique([supplierId, tenantId])
  @@index([tenantId, status, origin])
  @@index([tenantId])
  @@index([supplierId])
  @@map("supplier_tenant_relations")
}

enum RelationStatus {
  ACTIVE
  PENDING_TENANT_APPROVAL
  BLOCKED
}

// ============================================================
// SUPPLIER INVITATIONS (alıcı → tedarikçi davetleri)
// ============================================================

model SupplierInvitation {
  id              String @id @default(cuid())
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedByUserId String
  invitedByUser   User   @relation(fields: [invitedByUserId], references: [id])

  email       String
  contactName String?
  message     String?

  tokenHash String   @unique
  expiresAt DateTime

  status               InvitationStatus @default(PENDING)
  acceptedAt           DateTime?
  cancelledAt          DateTime?
  acceptedBySupplierId String?
  acceptedBySupplier   Supplier?        @relation("AcceptedBySupplier", fields: [acceptedBySupplierId], references: [id])

  // V2-7 — Davet belirli bir ihaleye bağlıysa: kabul edilince (kayıtlı tedarikçi
  // direkt, yeni tedarikçi admin onayı sonrası) otomatik TenderInvitation oluşur.
  // Tender silinirse davet kalır ama bağ kopar (SetNull).
  tenderId String?
  tender   Tender? @relation(fields: [tenderId], references: [id], onDelete: SetNull)

  sentCount  Int      @default(1)
  lastSentAt DateTime @default(now())

  // Multi-tenant tedarikçi davet kabul akışı (D.2.B)
  // Davet oluşturulurken: e-posta zaten aktif bir SupplierUser'a aitse true.
  // Mevcut tedarikçi /supplier/profil üzerinden, yeni tedarikçi /register/supplier üzerinden kabul eder.
  isExistingSupplier Boolean   @default(false)
  // Kullanıcının e-posta dışında manuel girebilmesi için kısa kod (Crockford Base32 4-4: K7X9-3M2P).
  // Legacy satırlarda NULL kalabilir; yeni davetlerde her zaman üretilir.
  shortCode          String?   @unique
  // Davet linki ilk açıldığında set edilir; alıcı tarafa "açıldı/açılmadı" göstergesi için.
  openedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application SupplierApplication?

  @@index([tenantId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([tenderId])
  @@map("supplier_invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// ============================================================
// TENDER MODULE — Aşama E
// ============================================================

enum TenderType {
  RFQ // Request for Quotation (kapalı teklif)
  ENGLISH_AUCTION // İngiliz usulü açık eksiltme (V2)
}

enum TenderVisibility {
  PRIVATE // Sadece davetli tedarikçiler görür/teklif verir (mevcut model)
  PUBLIC // Herkese açık — premium tedarikçiler davet olmadan teklif verebilir
}

enum TenderStatus {
  DRAFT // Taslak (henüz yayınlanmadı)
  IN_APPROVAL // E.7.D — yayın için onay bekliyor
  OPEN_FOR_BIDS // Yayında, teklif alıyor
  IN_AWARD // Süre doldu, alıcı kazandırma yapıyor
  IN_AWARD_APPROVAL // E.7.D — kazandırma için onay bekliyor
  AWARDED // Kazandırıldı, sipariş oluştu
  CANCELLED // İptal edildi
  CLOSED_NO_AWARD // Süre doldu, kazandırma yapılmadı
}

enum Currency {
  TRY
  USD
  EUR
  GBP
  CHF
  JPY
  AED
  CNY
}

enum DeliveryTerm {
  // Yurtiçi (sade) — isInternational=false ihalelerde gösterilir.
  DOMESTIC_DELIVERED // Nakliye dahil (satıcı teslim eder)
  DOMESTIC_PICKUP // Fabrika/Depo teslim (alıcı alır)
  // Uluslararası Incoterms — isInternational=true ihalelerde gösterilir.
  EXW
  FCA
  CPT
  CIP
  DAP
  DPU
  DDP
  FAS
  FOB
  CFR
  CIF
}

enum PaymentTerm {
  CASH // Peşin
  DEFERRED // Vadeli
}

// Faz 3 madde 16 — Direkt ödeme şekli (sipariş ödeme kaydı bazında).
enum PaymentMethod {
  CASH // Nakit
  CHEQUE // Çek
}

// Faz 3 madde 16 — Ödemenin teslime göre zamanı (ihalede alıcı belirler).
// Sipariş ekranında ödeme bölümünün ne zaman görüneceğini belirler.
enum PaymentTiming {
  BEFORE_DELIVERY // Teslim öncesi (tedarikçi onayından sonra "ödeme bekleniyor")
  AFTER_DELIVERY // Teslim sonrası (sipariş tamamlanınca görünür)
}

// Faz 3 madde 16 — Sipariş ödeme kaydının durumu.
enum OrderPaymentStatus {
  AWAITING_CONFIRMATION // Alıcı ödediğini kaydetti, tedarikçi onayı bekleniyor
  CONFIRMED // Tedarikçi ödemeyi/çeki aldığını onayladı
  REJECTED // Tedarikçi almadığını bildirdi (sebep ile)
}

enum TenderInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum BidStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
  REJECTED
  AWARDED_PARTIAL
  AWARDED_FULL
  LOST
}

// V2-7 — İngiliz Usulü açık eksiltme: tedarikçiye gösterilecek bilgi seviyesi.
// Hiçbir modda tedarikçi başka tedarikçinin İSMİNİ göremez; sadece agrega.
enum BidVisibility {
  OWN_ONLY // Sadece kendi teklifini görür (sealed-bid gibi)
  BEST_PRICE // Sadece şu anki en iyi teklif tutarını görür
  OWN_RANK // Sadece kendi sıralamasını görür
  BEST_AND_OWN_RANK // En iyi teklif + kendi sıralaması
  ALL // Tüm teklifler (anonim) + sıralama
}

// V2-7 — Açık eksiltmede minimum azaltma kuralının cinsi.
enum DecrementType {
  AMOUNT // Sabit tutar (primaryCurrency cinsinden)
  PERCENT // Yüzde (önceki teklif × oran)
}

// V2-7 — Decrement'in baz alınacağı referans.
// V2-7'de sadece OWN_LAST_BID aktif; BEST_BID enum'da hazır.
enum DecrementBasis {
  OWN_LAST_BID // Tedarikçinin kendi son teklifi
  BEST_BID // İhaledeki en iyi teklif (V3)
}

enum OrderStatus {
  PENDING // Sipariş açıldı, tedarikçi onayı bekleniyor
  ACCEPTED // Tedarikçi siparişi onayladı + bilgileri (teslim tarihi, banka, fatura) girdi
  IN_DELIVERY // Tedarikçi gönderim başlattı
  COMPLETED // Alıcı teslim aldı
  REJECTED // Tedarikçi siparişi reddetti (sebep ile)
  CANCELLED // Alıcı iptal etti (sebep ile)
  IN_PROGRESS // (legacy, kullanılmıyor — eski kayıtlar için)
  DELIVERED // (legacy, kullanılmıyor — eski kayıtlar için)
}

model Tender {
  id String @id @default(cuid())

  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  createdById String
  createdBy   User   @relation("TendersCreated", fields: [createdById], references: [id])

  tenderNumber String       @unique
  type         TenderType   @default(RFQ)
  // Faz: Açık İhale — PRIVATE = sadece davetli tedarikçiler; PUBLIC = herkese
  // açık, premium tedarikçiler davet olmadan teklif verebilir.
  visibility   TenderVisibility @default(PRIVATE)
  status       TenderStatus @default(DRAFT)

  title              String
  description        String?
  /**
   * V2-7 — Tedarikçilere ihale listesinde arama/eşleştirme için anahtar kelimeler. 0-10 adet, her biri ≤50 karakter.
   */
  keywords           String[] @default([])
  termsAndConditions String?
  internalNotes      String?

  isSealedBid        Boolean @default(true)
  requireAllItems    Boolean @default(false)
  requireBidDocument Boolean @default(false)

  primaryCurrency   Currency   @default(TRY)
  /**
   * V2-6 — Kabul edilen para birimleri (1-8); primaryCurrency listenin başı (TRY equivalent base).
   */
  allowedCurrencies Currency[] @default([])

  // V2-7 — İngiliz Usulü açık eksiltme ayarları.
  // type=RFQ ise bidVisibility=OWN_ONLY zorunlu, decrement alanları null.
  // type=ENGLISH_AUCTION ise bidVisibility + decrement zorunlu.
  bidVisibility          BidVisibility   @default(OWN_ONLY)
  priceDecrementType     DecrementType?
  priceDecrementValue    Decimal?        @db.Decimal(15, 4)
  priceDecrementBasis    DecrementBasis?
  /**
   * Fiyat gösteriminde kullanılacak ondalık basamak sayısı (0-4).
   */
  decimalPlaces          Int             @default(2)
  /**
   * Kapanış öncesi tedarikçilere hatırlatma e-postası gönderilsin mi?
   */
  sendClosingReminder    Boolean         @default(false)
  /**
   * Kapanışa X dk kala hatırlatma (sendClosingReminder=true iken).
   */
  reminderMinutesBefore  Int             @default(60)
  /**
   * ENGLISH_AUCTION: son dakika gelen teklif ile bidsCloseAt otomatik uzatılır.
   */
  autoExtendOnLateBid    Boolean         @default(true)
  /**
   * Son dakika eşiği (dk) — daha az süre kala teklif gelirse uzatılır.
   */
  autoExtendThresholdMin Int             @default(2)
  /**
   * Her uzatmada eklenecek dakika.
   */
  autoExtendByMinutes    Int             @default(2)
  /**
   * Sistem tarafından gönderilen "kapanış hatırlatma" e-postasının zamanı (idempotency).
   */
  closingReminderSentAt  DateTime?

  // V2-7 — Yeni Tur (round) zinciri. Round #1 → previousTenderId=null, roundNumber=1.
  // Sonraki turlar previousTenderId=öncekinin id, roundNumber=öncekinin+1.
  previousTenderId String?
  previousTender   Tender?  @relation("TenderRounds", fields: [previousTenderId], references: [id])
  nextRounds       Tender[] @relation("TenderRounds")
  roundNumber      Int      @default(1)

  // Yurtiçi (false) / Uluslararası (true). Uluslararası ihaleyi alıcının
  // ülkesinden FARKLI ülkedeki tedarikçiler görür (sınır-ötesi); yurtiçini
  // aynı ülkedekiler. Teslim şekli + para + belge bu seçime göre değişir.
  isInternational         Boolean      @default(false)
  deliveryTerm            DeliveryTerm?
  // E.7.B'den önce: free-text. E.7.B sonrası: backward-compat fallback —
  // yeni tender'larda deliveryAddressSnapshot'tan formatlı string yazılır.
  deliveryAddress         String?
  // E.7.B — tender oluşturma anında TenantAddress'in JSON snapshot'ı.
  // Adres sonradan değişse/silinse bile tender bu kaydı korur.
  billingAddressSnapshot  Json?
  deliveryAddressSnapshot Json?

  // Lojistik İhalesi — RFQ üstüne yapılandırılmış lojistik bilgi katmanı.
  // isLogistics=true ise logisticsDetails dolu olur (mod, çıkış/varış, kargo, vb.).
  isLogistics      Boolean @default(false)
  logisticsDetails Json?

  paymentTerm   PaymentTerm   @default(CASH)
  paymentDays   Int?
  // Faz 3 madde 16 — Ödeme teslim öncesi mi sonrası mı? Sipariş ödeme akışını belirler.
  paymentTiming PaymentTiming @default(AFTER_DELIVERY)

  // Tahmini toplam tutar (primaryCurrency'de) — tüm items targetUnitPrice
  // ve quantity'sinden hesaplanır. Bir item targetUnitPrice'ı yoksa null.
  // List filter (tutar aralığı) için denormalize, createDraft/updateDraft
  // sırasında güncellenir.
  estimatedTotal Decimal? @db.Decimal(20, 4)

  publishedAt  DateTime?
  bidsOpenAt   DateTime?
  bidsCloseAt  DateTime
  awardedAt    DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // V2-6 — Birden fazla UNSPSC kategorisi (Class veya Commodity). Junction tablo.
  categories TenderCategory[]

  items               TenderItem[]
  invitations         TenderInvitation[]
  bids                Bid[]
  orders              Order[]
  attachments         TenderAttachment[]
  approvalRequests    ApprovalRequest[]
  // V2-7 — E-posta ile (kayıtsız/bağlantısız) tedarikçiyi doğrudan bu ihaleye davet.
  supplierInvitations SupplierInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([status, bidsCloseAt])
  @@map("tenders")
}

model TenderItem {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  orderIndex  Int
  name        String
  description String?

  quantity Decimal @db.Decimal(15, 4)
  unit     String

  materialCode    String?
  requiredByDate  DateTime?
  targetUnitPrice Decimal?  @db.Decimal(15, 4)

  // V2-7+ — Kalem başına çoklu + tipli soru: [{ id, text, answerType, required }]
  // answerType: TEXT | NUMBER | YES_NO | DATE. Legacy tek soru `customQuestion`'da
  // kalır; okuma katmanı questions boşsa ona fallback yapar.
  customQuestion String?
  questions      Json?

  bidItems BidItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenderId, orderIndex])
  @@map("tender_items")
}

model TenderInvitation {
  id         String   @id @default(cuid())
  tenderId   String
  tender     Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  status      TenderInvitationStatus @default(PENDING)
  invitedAt   DateTime               @default(now())
  respondedAt DateTime?

  emailSentAt   DateTime?
  emailOpenedAt DateTime?

  @@unique([tenderId, supplierId])
  @@index([supplierId, status])
  @@map("tender_invitations")
}

model Bid {
  id            String       @id @default(cuid())
  tenderId      String
  tender        Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier     @relation(fields: [supplierId], references: [id])
  submittedById String
  submittedBy   SupplierUser @relation(fields: [submittedById], references: [id])

  status BidStatus @default(DRAFT)

  currency    Currency
  totalAmount Decimal  @db.Decimal(20, 4)

  notes        String?
  // G4 — teslim tarihi (madde 8) + teklif geçerlilik gün sayısı (madde 10).
  // Nullable: taslakta boş olabilir; gönderde zorunluluk serviste uygulanır.
  deliveryDate DateTime?
  validityDays Int?
  version      Int       @default(1)

  submittedAt DateTime?
  withdrawnAt DateTime?

  // Eleme alanları (E.5) — alıcı SUBMITTED bid'i LOST'a çevirdiğinde dolar.
  eliminationReason String?
  eliminatedAt      DateTime?

  // V2-3 — submit anındaki TCMB kuru snapshot'ı.
  // Shape: { rate: number, fetchedAt: ISO, source: "TCMB"|"MANUAL"|"FALLBACK", rateDate: ISO }
  // bid.currency=TRY ise null kalır (gerek yok).
  exchangeRateSnapshot Json?

  items       BidItem[]
  attachments BidAttachment[]
  orders      Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenderId, supplierId])
  @@index([tenderId, status])
  @@map("bids")
}

model BidItem {
  id           String     @id @default(cuid())
  bidId        String
  bid          Bid        @relation(fields: [bidId], references: [id], onDelete: Cascade)
  tenderItemId String
  tenderItem   TenderItem @relation(fields: [tenderItemId], references: [id])

  unitPrice  Decimal? @db.Decimal(15, 4)
  totalPrice Decimal? @db.Decimal(20, 4)
  currency   Currency

  // V2-7+ — Kalemin çoklu sorularına cevaplar: [{ questionId, value }].
  // Legacy tek cevap `customAnswer`'da kalır (fallback).
  customAnswer String?
  answers      Json?

  isWinner        Boolean  @default(false)
  awardedQuantity Decimal? @db.Decimal(15, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bidId, tenderItemId])
  @@map("bid_items")
}

model BidAttachment {
  id    String @id @default(cuid())
  bidId String
  bid   Bid    @relation(fields: [bidId], references: [id], onDelete: Cascade)

  fileName String
  fileSize Int
  mimeType String
  fileUrl  String

  uploadedAt DateTime @default(now())

  @@map("bid_attachments")
}

model TenderAttachment {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  fileName String
  fileSize Int
  mimeType String
  fileUrl  String

  uploadedAt DateTime @default(now())

  @@map("tender_attachments")
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  tenderId   String
  tender     Tender   @relation(fields: [tenderId], references: [id])
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  bidId      String
  bid        Bid      @relation(fields: [bidId], references: [id])

  status OrderStatus @default(PENDING)

  currency    Currency
  totalAmount Decimal  @db.Decimal(20, 4)

  expectedDeliveryAt DateTime? // (legacy, V1.5'ten önce kullanılan)
  deliveredAt        DateTime? // (legacy)

  notes String?

  // Tedarikçi onay aşaması (PENDING → ACCEPTED). Onay anında tahmini teslim
  // tarihi, banka/fatura bilgileri ve isteğe bağlı not girer.
  acceptedAt        DateTime?
  acceptedNote      String?   @db.Text
  bankAccountHolder String?
  bankIban          String?

  // Tedarikçi red aşaması (PENDING → REJECTED). Sebep zorunlu.
  rejectedAt   DateTime?
  rejectReason String?   @db.Text

  // Gönderim aşaması (ACCEPTED → IN_DELIVERY). expectedDeliveryDate ACCEPT
  // adımında girilir; bu blokta tedarikçinin gönderim notu + fatura no.
  deliveryStartedAt    DateTime?
  deliveryStartedById  String?
  deliveryStartedBy    User?     @relation("OrderDeliveryStarted", fields: [deliveryStartedById], references: [id])
  deliveryNote         String?   @db.Text
  // G5 madde 12/14 — "Gönderildi"ye geçişte tedarikçi fatura no girer (zorunlu).
  invoiceNumber        String?
  expectedDeliveryDate DateTime?

  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("OrderCompleted", fields: [completedById], references: [id])
  completedNote String?   @db.Text

  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("OrderCancelled", fields: [cancelledById], references: [id])
  cancelReason  String?   @db.Text

  // V2-REVIEWS — Sipariş tamamlanınca alıcı 1-5 yıldız + opsiyonel yorum bırakır.
  review SupplierReview?

  // Faz 3 madde 16 — Direkt ödeme kayıtları (çoklu/kısmi: nakit/çek).
  payments OrderPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([supplierId, status])
  @@map("orders")
}

// Faz 3 madde 16 — Direkt ödeme kaydı. Bir siparişte birden çok kayıt olabilir
// (kısmi ödemeler, ayrı çekler). Alıcı kaydı oluşturur ("ödedim"), tedarikçi
// onaylar ("aldım") veya reddeder ("almadım"). Aktör id'leri FK ilişkisi yerine
// düz alan tutulur (audit-light; User/SupplierUser modellerini şişirmemek için).
model OrderPayment {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId   String
  supplierId String

  method   PaymentMethod
  amount   Decimal       @db.Decimal(20, 4)
  currency Currency

  // Çek detayları (method = CHEQUE iken doldurulur).
  chequeNo      String?
  chequeBank    String?
  chequeDueDate DateTime?

  note String? @db.Text

  status OrderPaymentStatus @default(AWAITING_CONFIRMATION)

  // Alıcı "ödedim" olarak kaydetti.
  markedPaidAt       DateTime @default(now())
  markedPaidByUserId String?

  // Tedarikçi onayı / reddi.
  confirmedAt               DateTime?
  confirmedBySupplierUserId String?
  rejectedAt                DateTime?
  rejectReason              String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([tenantId])
  @@index([supplierId])
  @@map("order_payments")
}

// ============================================================
// APPROVAL FLOW MODULE — Aşama E.7.C (config only; runtime E.7.D'de)
// ============================================================

model ApprovalFlow {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  flowNumber  Int // tenant-wide counter, 10001+
  name        String
  description String?
  type        ApprovalFlowType
  status      ApprovalFlowStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("ApprovalFlowCreatedBy", fields: [createdById], references: [id])

  initiators ApprovalFlowInitiator[]
  steps      ApprovalFlowStep[]
  requests   ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, flowNumber])
  @@index([tenantId, type, status])
  @@index([tenantId, status])
  @@map("approval_flows")
}

model ApprovalFlowInitiator {
  id     String       @id @default(cuid())
  flowId String
  flow   ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation("ApprovalFlowInitiatorUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([flowId, userId])
  @@index([userId])
  @@map("approval_flow_initiators")
}

model ApprovalFlowStep {
  id     String       @id @default(cuid())
  flowId String
  flow   ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  orderIndex     Int // 1, 2, 3 — sıralı onay
  approverUserId String
  approver       User   @relation("ApprovalFlowStepApprover", fields: [approverUserId], references: [id], onDelete: Cascade)

  // Bütçe eşiği — null = her zaman aktif; değer = X ve üstü tutarlarda devreye girer
  conditionMinAmount Decimal? @db.Decimal(20, 2)
  conditionCurrency  String?  @default("TRY")

  // Diagram'da gösterilecek soft etiket (örn "Satınalma Müdürü")
  displayLabel String?

  requestSteps ApprovalRequestStep[]

  createdAt DateTime @default(now())

  @@unique([flowId, orderIndex])
  @@index([approverUserId])
  @@map("approval_flow_steps")
}

enum ApprovalFlowType {
  TENDER_PUBLISH
  TENDER_AWARD
}

enum ApprovalFlowStatus {
  DRAFT
  ACTIVE
  PASSIVE
}

// ============================================================
// APPROVAL REQUEST RUNTIME — Aşama E.7.D
// ============================================================

model ApprovalRequest {
  id             String @id @default(cuid())
  approvalNumber String @unique // APR-YYYY-NNNN

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  flowId String
  flow   ApprovalFlow @relation(fields: [flowId], references: [id])

  // Polymorphic — V1'de sadece tender. V2'de orderId/purchaseRequestId gelecek.
  type     ApprovalFlowType
  tenderId String
  tender   Tender           @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  status ApprovalRequestStatus @default(PENDING)

  // Match anında hesaplanan bütçe (snapshot — rule değişse bile request bağımsız)
  amount   Decimal @db.Decimal(20, 2)
  currency String  @default("TRY")

  initiatedById String
  initiatedBy   User    @relation("InitiatedApprovalRequests", fields: [initiatedById], references: [id])
  initiatorNote String?

  steps ApprovalRequestStep[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // V1.5 Oturum 2 — onay reminder cron idempotency
  lastReminderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, type])
  @@index([tenantId, status])
  @@index([tenderId])
  @@index([initiatedById, status])
  @@map("approval_requests")
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequestStep {
  id        String          @id @default(cuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  flowStepId String
  flowStep   ApprovalFlowStep @relation(fields: [flowStepId], references: [id])

  approverUserId String
  approver       User   @relation("ApproverOfRequestSteps", fields: [approverUserId], references: [id])

  status     ApprovalStepStatus @default(WAITING)
  orderIndex Int

  // Snapshot (rule değişebilir, request bağımsız)
  conditionMinAmount Decimal? @db.Decimal(20, 2)
  displayLabel       String?

  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())

  @@index([approverUserId, status])
  @@index([requestId, orderIndex])
  @@map("approval_request_steps")
}

enum ApprovalStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

// ---------- V2-2: DOSYA YÜKLEME (Cloudflare R2) ----------
//
// Polymorphic attachment — scope + scopeRefId ile sahip kaynağa bağlanır.
// (Legacy BidAttachment/TenderAttachment base64 modelleri korunuyor; yeni
// uploadlar buraya yazılır, FE/BE yeni model üzerinden çalışır.)

model Attachment {
  id String @id @default(cuid())

  // Sahibi her zaman bir tenant. BID_RESPONSE'da tedarikçi yükler ama scope
  // hedefi (tender'ın) tenant'ı; ORDER_INVOICE'da order tenantı.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Yükleyen — tenant veya supplier kullanıcısı (sadece biri set olur).
  uploadedByUserId         String?
  uploadedByUser           User?         @relation("UploadedAttachments", fields: [uploadedByUserId], references: [id])
  uploadedBySupplierUserId String?
  uploadedBySupplierUser   SupplierUser? @relation("UploadedAttachmentsSupplier", fields: [uploadedBySupplierUserId], references: [id])

  scope      AttachmentScope
  scopeRefId String // tender.id | bid.id | order.id

  // R2 storage key — `{env}/{tenantId}/{attachmentId}-{sanitizedFilename}`
  key              String @unique
  originalFilename String
  mimeType         String
  fileSize         Int // bytes

  status AttachmentStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  finalizedAt DateTime?

  @@index([tenantId, scope, scopeRefId])
  @@index([tenantId, status])
  @@index([uploadedByUserId])
  @@index([uploadedBySupplierUserId])
  @@map("attachments")
}

enum AttachmentScope {
  TENDER_DOC
  BID_RESPONSE
  ORDER_INVOICE
  MESSAGE_ATTACHMENT // V2-4 — mesaj eki (scopeRefId = order veya tender id)
  // G5 madde 19/21 — sipariş belge kategorileri (scopeRefId = order id).
  ORDER_PROFORMA // proforma (baştan)
  ORDER_TECHNICAL // teknik doküman (baştan)
  ORDER_DELIVERY // Teslimat Evrakları (yurtiçi — gönderim sonrası, alıcı imzalı irsaliye)
  ORDER_BILL_OF_LADING // Konşimento (uluslararası siparişte irsaliye yerine)
  ORDER_PAYMENT_PROOF // Faz 3 madde 16 — ödeme dekontu (alıcı yükler, ikisi de görür)
  ORDER_GUARANTEE_LETTER // Madde 33 — teminat mektubu (nakit ödemede tedarikçi yükler, ikisi de görür)
}

enum AttachmentStatus {
  PENDING // Presigned URL üretildi, R2'ye henüz yüklenmedi
  UPLOADED // R2'de mevcut, kullanılabilir
}

// ---------- V2-3: ÇOKLU PARA BİRİMİ + TCMB KUR CACHE ----------
//
// TCMB (Türkiye Cumhuriyet Merkez Bankası) günlük gösterge kurları.
// Hafta içi 15:30 civarı yayınlar; cron 16:00 İstanbul saatinde fetch eder.
// TRY için kayıt YOK (rate=1 sabit). Sadece USD/EUR.

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  Currency
  rate      Decimal  @db.Decimal(15, 6) // 1 {currency} = X TRY
  rateDate  DateTime @db.Date // TCMB tarihi (gün-bazlı)
  source    String   @default("TCMB") // TCMB | MANUAL | FALLBACK
  fetchedAt DateTime @default(now())

  @@unique([currency, rateDate])
  @@index([rateDate])
  @@map("exchange_rates")
}

// ---------- V2-4: 1-ON-1 MESAJLAŞMA ----------
//
// Polymorphic thread — context (ORDER veya TENDER) + contextRefId.
// 1 alıcı-tedarikçi-context kombinasyonu için tek thread.
// Tedarikçiler birbirini görmez (kapalı zarf gereği).

/// V2-4.2 — Unified thread per (tenant, supplier). Tender/order/direct
/// ayrımı artık thread seviyesinde değil, mesaj seviyesindeki context tag'inde.
model MessageThread {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation("TenantMessageThreads", fields: [tenantId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation("SupplierMessageThreads", fields: [supplierId], references: [id], onDelete: Cascade)

  messages Message[]

  lastMessageAt      DateTime?
  lastMessagePreview String?   @db.VarChar(200)
  tenantLastReadAt   DateTime?
  supplierLastReadAt DateTime?

  createdAt DateTime @default(now())

  @@unique([tenantId, supplierId])
  @@index([tenantId, lastMessageAt])
  @@index([supplierId, lastMessageAt])
  @@map("message_threads")
}

model Message {
  id       String        @id @default(cuid())
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// V2-4.2 — Her mesaj bir context taşır. NULL = legacy / tarif edilmeyen.
  /// DIRECT için contextRefId = null. TENDER: tenderId. ORDER: orderId.
  context      MessageContext?
  contextRefId String?

  senderType           MessageSenderType
  senderUserId         String? // User.id (TENANT_USER ise)
  senderSupplierUserId String? // SupplierUser.id (SUPPLIER_USER ise)

  content       String @db.Text
  /**
   * R2 Attachment.id'lerinin array'i (MESSAGE_ATTACHMENT scope'lu).
   */
  attachmentIds Json   @default("[]")

  emailNotifiedAt DateTime?

  sentAt DateTime @default(now())

  @@index([threadId, sentAt])
  @@index([emailNotifiedAt, sentAt])
  @@index([context, contextRefId])
  @@map("messages")
}

enum MessageContext {
  ORDER
  TENDER
  // V2-4.1 — Şirket-bazlı doğrudan sohbet. Tender/Order'a bağlı değil.
  // contextRefId = supplierId (tenant->supplier yönünde başlatıldıysa) veya
  // tenantId (supplier->tenant yönünde başlatıldıysa). Thread uniqueness
  // (tenantId, supplierId, context, contextRefId) garantili, çakışmaz.
  DIRECT
}

enum MessageSenderType {
  TENANT_USER
  SUPPLIER_USER
}

// ---------- V2-6: KATEGORİ SİSTEMİ (UNSPSC tabanlı, 2 seviye) ----------
//
// Self-referencing tek tablo, 4 seviye UNSPSC:
//   level 1 = Segment   (XX000000)
//   level 2 = Family    (XXXX0000)
//   level 3 = Class     (XXXXXX00)
//   level 4 = Commodity (XXXXXXXX)
// Tedarikçi (many) ve Tender (single) Level 3 veya 4'e bağlanır.
// Level 1+2 sadece UI accordion grup başlığıdır — seçilemez.

model Category {
  id     String @id @default(cuid())
  /**
   * UNSPSC 8-haneli kod (10000000=segment, 10100000=family, 10101500=class, 10101501=commodity)
   */
  code   String @unique
  nameTr String
  /**
   * 1=Segment, 2=Family, 3=Class, 4=Commodity
   */
  level  Int

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")

  /**
   * Sadece level 1: PratisPro tarzı harf prefix (A, B, C...)
   */
  segmentLetter String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  supplierCategories SupplierCategory[]
  tenderCategories   TenderCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
  @@index([level, sortOrder])
  @@index([code])
  @@map("categories")
}

model SupplierCategory {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([supplierId, categoryId])
  @@index([categoryId])
  @@map("supplier_categories")
}

model TenderCategory {
  id         String   @id @default(cuid())
  tenderId   String
  tender     Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([tenderId, categoryId])
  @@index([categoryId])
  @@index([tenderId])
  @@map("tender_categories")
}

// ============================================================
// V2-7+ — ŞABLONLAR
// Alıcı kendi sık kullandığı kalem soruları + tedarikçi grupları için
// şablonlar tanımlar; ihale wizard'ında tek tıkla uygulanır.
// ============================================================

model QuestionTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  // Herkese Açık (true) — tenant içindeki tüm BUYER/ADMIN kullanır;
  // Özel (false) — sadece createdBy görür.
  isPublic  Boolean @default(true)
  // "Bu şablondaki soruların tamamı ihalelere otomatik olarak eklensin"
  autoApply Boolean @default(false)

  createdById String
  createdBy   User   @relation("QuestionTemplateCreatedBy", fields: [createdById], references: [id])

  items QuestionTemplateItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([createdById])
  @@map("question_templates")
}

model QuestionTemplateItem {
  id         String           @id @default(cuid())
  templateId String
  template   QuestionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  text       String
  // Cevaplama Zorunluluğu: REQUIRED / OPTIONAL
  required   Boolean            @default(false)
  // Cevap Türü: TEXT, NUMBER, YES_NO, DATE
  answerType QuestionAnswerType
  orderIndex Int                @default(0)

  createdAt DateTime @default(now())

  @@index([templateId])
  @@map("question_template_items")
}

enum QuestionAnswerType {
  TEXT
  NUMBER
  YES_NO
  DATE
}

model SupplierTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  isPublic Boolean @default(true)

  createdById String
  createdBy   User   @relation("SupplierTemplateCreatedBy", fields: [createdById], references: [id])

  members SupplierTemplateMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([createdById])
  @@map("supplier_templates")
}

model SupplierTemplateMember {
  templateId String
  template   SupplierTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([templateId, supplierId])
  @@index([supplierId])
  @@map("supplier_template_members")
}

// Madde 34 — İhale şablonu. Tekrarlayan alımlar için isimli, kayıtlı ihale
// taslağı. `data` = wizard form verisi (kalemler + sorular + kategoriler + tür +
// scope + teslim/ödeme/para + ayarlar). Kapanış tarihi + davetli tedarikçiler +
// adresler şablona girmez (her ihalede ayrı).
model TenderTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  data Json

  createdById String
  createdBy   User   @relation("TenderTemplateCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([createdById])
  @@map("tender_templates")
}

// V2-7+ — Güvenlik denetim izi (OWASP A09). Append-only: servis katmanı
// yalnızca create yapar; update/delete yok. Aktör sistemde olmayabilir
// (başarısız login) → actorId/tenantId nullable.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorType  String // "tenant" | "admin" | "supplier" | "system"
  actorId    String?
  actorEmail String?
  action     String // "auth.login", "auth.login_failed", "tender.awarded", ...
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// Madde 29 — FAZ 3.3: e-posta 2FA OTP challenge (transient).
// userId VEYA supplierUserId dolu (biri). purpose: LOGIN | ENABLE.
model TwoFactorChallenge {
  id             String    @id @default(cuid())
  userId         String?
  supplierUserId String?
  purpose        String
  codeHash       String
  expiresAt      DateTime
  attempts       Int       @default(0)
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([supplierUserId])
  @@map("two_factor_challenges")
}

// ─────────────────────────────────────────────────────────────────────────────
// BİRLEŞİK SİSTEM (Faz 1) — Tek Company hesabı. Eski Tenant + Supplier birleşir.
// docs/birlesik-sistem-plani.md. Bu tablolar ADDITIVE: henüz hiçbir şey referans
// vermez, eski Tenant/Supplier çalışmaya devam eder (köprü geçiş).
// ─────────────────────────────────────────────────────────────────────────────

enum CompanyRole {
  YONETICI // hesap yönetimi: kullanıcı/rol, ayarlar, bağlantılar
  SATIN_ALMACI // alım operasyonu (🔵)
  SATISCI // satış operasyonu (🟢)
  ONAYLAYICI // onay zinciri
}

enum CompanyTier {
  STANDARD // bedava — pasif: sadece bağlantılı firmaların ilanına teklif; görünmez
  PAKET // paralı — aktif: ilan aç + keşfet + public + görünür
}

model Company {
  id        String  @id @default(cuid())
  supkeysId String? @unique
  slug      String? @unique // public profil URL'i (sadece PAKET)

  // Kimlik
  name        String // ticari ad
  legalName   String?
  companyType CompanyType?
  taxNumber   String?      @unique
  taxOffice   String?
  country     String       @default("TR")
  stateRegion String?

  // Adres (inline; ileride Address[] defteriyle zenginleşir)
  city         String?
  district     String?
  neighborhood String?
  addressLine  String?
  postalCode   String?

  // İletişim / fatura / kurumsal
  industry               String?
  website                String?
  billingTitle           String?
  billingEmail           String?
  billingPhone           String?
  billingPhoneVerifiedAt DateTime?
  authorizedTckn         String?
  authorizedTitle        String?
  mersisNo               String?
  tradeRegistryNo        String?
  kepAddress             String?
  iban                   String?
  ibanHolder             String?

  // Kategoriler — AYRI: ne alırım vs ne satarım
  buyerCategoryIds     String[] @default([])
  buyerSubCategoryIds  String[] @default([])
  sellerCategoryIds    String[] @default([])
  sellerSubCategoryIds String[] @default([])

  // Üyelik (koltuk yok; sınırsız kullanıcı)
  tier            CompanyTier @default(STANDARD)
  membershipEndAt DateTime?

  // KYC / doğrulama
  companyVerificationStatus CompanyVerificationStatus @default(UNVERIFIED)
  companyVerifiedAt         DateTime?
  docTaxPlateUrl            String?
  docTradeRegistryUrl       String?
  docSignatureCircularUrl   String?
  docActivityCertUrl        String?
  docIdFrontUrl             String?
  docIdBackUrl              String?
  onboardingCompletedAt     DateTime?

  // Public profil (sadece PAKET görünür)
  publicEnabled  Boolean  @default(false)
  aboutText      String?
  logoUrl        String?
  coverImageUrl  String?
  linkedinUrl    String?
  instagramUrl   String?
  services       String[] @default([])
  foundedYear    Int?
  employeeCount  String?
  certifications String[] @default([])

  // Durum
  isActive      Boolean   @default(true)
  isBlocked     Boolean   @default(false)
  blockedReason String?
  blockedAt     DateTime?

  // Sahiplik — tekil firma sahibi (CompanyUser.id). Sahip ⊇ Yönetici.
  ownerUserId String?

  users                CompanyUser[]
  listings             Listing[]
  bidsPlaced           ListingBid[]        @relation("BidderCompany")
  connectionsInitiated CompanyConnection[] @relation("ConnInviter")
  connectionsReceived  CompanyConnection[] @relation("ConnInvitee")
  ordersAsSeller       CompanyOrder[]      @relation("OrderSeller")
  ordersAsBuyer        CompanyOrder[]      @relation("OrderBuyer")
  blocksMade           CompanyBlock[]      @relation("BlockMade")
  blockedByOthers      CompanyBlock[]      @relation("BlockedBy")
  complaintsMade       CompanyComplaint[]  @relation("ComplaintBy")
  complaintsReceived   CompanyComplaint[]  @relation("ComplaintAgainst")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

enum ComplaintStatus {
  OPEN // yeni — admin incelemesi bekliyor
  RESOLVED // çözüldü, aksiyon alındı (örn. askı)
  DISMISSED // geçersiz/reddedildi
}

// Birleşik sistem — firma→firma şikayet (moderasyon §14). Admin inceler;
// çok şikayet alan firma askıya alınabilir (Company.isBlocked).
model CompanyComplaint {
  id                   String          @id @default(cuid())
  complainantCompanyId String
  complainant          Company         @relation("ComplaintBy", fields: [complainantCompanyId], references: [id], onDelete: Cascade)
  againstCompanyId     String
  against              Company         @relation("ComplaintAgainst", fields: [againstCompanyId], references: [id], onDelete: Cascade)
  reason               String // başlık/kategori
  detail               String?
  status               ComplaintStatus @default(OPEN)
  adminNote            String?
  createdById          String // CompanyUser
  resolvedAt           DateTime?
  resolvedByAdminId    String?
  createdAt            DateTime        @default(now())

  @@index([againstCompanyId])
  @@index([status])
  @@map("company_complaints")
}

enum ConnectionStatus {
  PENDING // davet gönderildi, kabul bekliyor
  ACTIVE // kabul edildi, bağlı
}

enum ConnectionOrigin {
  INVITE // davet-kabul / referans kodu — premium düşüşünde KALICI
  PREMIUM // premium keşif üzerinden — premium düşüşünde PASİFE alınır
  ADMIN // platform bağladı
}

// Birleşik sistem — firma↔firma bağlantı. Bir firma davet atar (inviter),
// diğeri kabul eder (invitee). Bağlanınca birbirinin "bağlantılara açık"
// ilanlarını görür (alış+satış). origin=INVITE kalıcı; PREMIUM premium-gated.
model CompanyConnection {
  id               String  @id @default(cuid())
  inviterCompanyId String
  inviter          Company @relation("ConnInviter", fields: [inviterCompanyId], references: [id], onDelete: Cascade)
  inviteeCompanyId String
  invitee          Company @relation("ConnInvitee", fields: [inviteeCompanyId], references: [id], onDelete: Cascade)

  status      ConnectionStatus @default(PENDING)
  origin      ConnectionOrigin @default(INVITE)
  invitedById String // CompanyUser (daveti atan kişi)
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inviterCompanyId, inviteeCompanyId])
  @@index([inviteeCompanyId])
  @@map("company_connections")
}

// Birleşik sistem — firma engelleme. A, B'yi engellerse karşılıklı görünmezlik:
// keşif/browse/davet'te ikisi birbirini bulamaz. Engelleyen kaldırabilir.
model CompanyBlock {
  id               String  @id @default(cuid())
  blockerCompanyId String
  blocker          Company @relation("BlockMade", fields: [blockerCompanyId], references: [id], onDelete: Cascade)
  blockedCompanyId String
  blocked          Company @relation("BlockedBy", fields: [blockedCompanyId], references: [id], onDelete: Cascade)
  reason           String?
  createdAt        DateTime @default(now())

  @@unique([blockerCompanyId, blockedCompanyId])
  @@index([blockedCompanyId])
  @@map("company_blocks")
}

enum ListingType {
  ALIM // alım ilanı (reverse — fiyat iner, en ucuz kazanır)
  SATIS // satış ilanı (forward — fiyat çıkar, en yüksek kazanır)
}

enum ListingBidStatus {
  SUBMITTED
  WITHDRAWN
  WON
  LOST
}

enum CompanyOrderStatus {
  CREATED // kazandırıldı, yeni sipariş
  IN_DELIVERY // kargoda
  DELIVERED // teslim alındı
  COMPLETED // tamamlandı (ödeme + teslim)
  CANCELLED
}

enum CompanyDocType {
  DELIVERY // teslim belgesi — yurtiçi irsaliye / uluslararası konşimento (satıcı yükler)
  PAYMENT // ödeme dekontu (alıcı yükler)
}

// Sipariş belgesi — R2'da saklanan dosya metası.
model CompanyOrderDocument {
  id                  String         @id @default(cuid())
  orderId             String
  order               CompanyOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type                CompanyDocType
  key                 String // R2 object key
  fileName            String
  mimeType            String
  uploadedByCompanyId String
  createdAt           DateTime       @default(now())

  @@index([orderId])
  @@map("company_order_documents")
}

// Birleşik sistem — sipariş. İlan kazandırılınca oluşur ve HER ZAMAN
// satıcı→alıcı'ya normalleşir: ALIM ilanı → satıcı=kazanan teklifçi;
// SATIS ilanı → satıcı=ilanı açan. Böylece kargo/ödeme akışı tek yön.
model CompanyOrder {
  id              String   @id @default(cuid())
  number          String?  @unique // ROT-ORD-NNNNNN (global sequence)
  listingId       String?  @unique
  listing         Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  sellerCompanyId String
  seller          Company  @relation("OrderSeller", fields: [sellerCompanyId], references: [id], onDelete: Cascade)
  buyerCompanyId  String
  buyer           Company  @relation("OrderBuyer", fields: [buyerCompanyId], references: [id], onDelete: Cascade)

  amount Decimal            @db.Decimal(18, 2)
  status CompanyOrderStatus @default(CREATED)

  documents CompanyOrderDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerCompanyId])
  @@index([buyerCompanyId])
  @@map("company_orders")
}

// Birleşik sistem — bir firmanın bir ilana teklifi. Bir firma bir ilana TEK
// teklif verir (güncellenebilir). Yön ilan tipine göre: ALIM→düşük iyi,
// SATIS→yüksek iyi. Kapalı zarf: teklif verenler birbirini görmez; ilan
// sahibi hepsini görür.
model ListingBid {
  id              String  @id @default(cuid())
  listingId       String
  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderCompanyId String
  bidderCompany   Company @relation("BidderCompany", fields: [bidderCompanyId], references: [id], onDelete: Cascade)

  amount      Decimal          @db.Decimal(18, 2)
  note        String?
  // Hemen-Al ile verilen teklif (tavan fiyattan). Yine de sahip onaylar.
  isBuyNow    Boolean          @default(false)
  status      ListingBidStatus @default(SUBMITTED)
  createdById String // CompanyUser (teklifi veren kişi)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, bidderCompanyId])
  @@index([listingId])
  @@index([bidderCompanyId])
  @@map("listing_bids")
}

enum ListingStatus {
  DRAFT
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum ListingVisibility {
  PUBLIC // herkese açık — standart MASKELİ görür, premium tam
  CONNECTIONS // sadece bağlantılı firmalar
  PRIVATE // sadece açıkça davet edilenler (ileride)
}

enum ListingFormat {
  RFQ // kapalı zarf teklif toplama (ALIM)
  ENGLISH_AUCTION // İngiliz usulü açık eksiltme (ALIM)
}

// Birleşik sistem — İlan (eski Tender'ın Company-native, sade karşılığı).
// Kalemler/teklif/sipariş sonraki chunk'larda eklenecek.
model Listing {
  id          String        @id @default(cuid())
  // SİSTEM GENELİNDE benzersiz ilan numarası (ROT-NNNNNN). Global Postgres
  // sequence'tan üretilir → A ve B firmasının ilanı asla aynı numarayı almaz.
  // Sıra büyüdükçe hane sayısı kendiliğinden artar (çok-haneli destek).
  number      String?       @unique
  companyId   String // açan firma
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        ListingType
  // Yurtiçi (false) / Uluslararası (true).
  isInternational Boolean @default(false)
  // ALIM için format (RFQ/İngiliz Usulü). SATIS'ta null (her zaman forward).
  format      ListingFormat?
  visibility  ListingVisibility @default(CONNECTIONS)
  title       String
  description String?
  // SATIS için: taban (min) fiyat + hemen-al fiyatı.
  minPrice    Decimal?      @db.Decimal(18, 2)
  buyNowPrice Decimal?      @db.Decimal(18, 2)
  status      ListingStatus @default(OPEN)
  closesAt    DateTime?
  createdById String // CompanyUser id (açan kişi)

  bids  ListingBid[]
  order CompanyOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("listings")
}

model CompanyUser {
  id        String  @id @default(cuid())
  email     String  @unique
  authId    String? @unique // Supabase auth bridge
  firstName String
  lastName  String
  phone     String?

  roles CompanyRole[] @default([])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  isActive           Boolean   @default(true)
  emailVerifiedAt    DateTime?
  twoFactorEnabled   Boolean   @default(false)
  twoFactorEnabledAt DateTime?
  permissionsOverride Json? // { added?: string[], removed?: string[] }
  notificationPrefs   Json?
  invitedById         String?
  invitedAt           DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime? // iş çıkışı — soft delete (geçmiş korunur, KVKK)

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("company_users")
}
