generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supavisor pooler (port 6543, transaction mode) — runtime sorgular.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — prisma migrate ve introspect için.
  // Supabase'e geçtikten sonra zorunlu; local Docker'da DATABASE_URL ile aynıdır.
  directUrl = env("DIRECT_URL")
}

// ============================================================
// SUPKEYS — Çekirdek Şema
// ============================================================

// ---------- TENANT TARAFI (müşteri firmalar) ----------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)

  // Firma profili (registration sırasında dolar)
  industry    String?
  city        String?
  district    String?
  addressLine String?
  postalCode  String?
  taxNumber   String? @unique
  taxOffice   String?

  // V2-6.5 — Tenant başına BUYER (Satın Almacı) kontenjanı. Super-admin
  // yönetir. APPROVER ve COMPANY_ADMIN sayılmaz; sadece role = BUYER sayılır.
  buyerSeatLimit Int @default(2)

  // V2-6.5 — Üyelik bitiş tarihi. NULL = sınırsız (legacy/dev). Tarihten
  // sonra tenant kullanıcıları login olamaz; admin login etkilenmez.
  // Super-admin 1-12 ay opsiyonlarıyla uzatır.
  membershipEndAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  buyerApplication     BuyerApplication?       @relation("BuyerAppTenant")
  supplierInvitations  SupplierInvitation[]
  supplierRelations    SupplierTenantRelation[]
  invitedSupplierApps  SupplierApplication[]   @relation("SupplierAppInviter")
  tenders              Tender[]
  orders               Order[]
  userInvitations      UserInvitation[]
  addresses            TenantAddress[]
  approvalFlows        ApprovalFlow[]
  approvalRequests     ApprovalRequest[]
  attachments          Attachment[]
  messageThreads       MessageThread[] @relation("TenantMessageThreads")

  @@map("tenants")
}

model TenantAddress {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type        AddressType
  title       String

  // Adres bilgileri
  country     String      @default("Türkiye")
  state       String?
  city        String
  district    String
  fullAddress String      @db.Text
  postalCode  String?

  // Sadece FATURA için (yine de optional — backend zorunlu kılar)
  taxOffice   String?
  taxNumber   String?

  // İletişim (opsiyonel)
  contactName  String?
  contactPhone String?
  contactEmail String?

  // Status
  isActive    Boolean     @default(true)
  isDefault   Boolean     @default(false)

  notes       String?     @db.Text

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tenantId, type, isActive])
  @@index([tenantId, type, isDefault])
  @@map("tenant_addresses")
}

enum AddressType {
  FATURA
  ILETISIM
  TESLIMAT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  // Supabase Auth bridge — `auth.users.id` (UUID). Migration sırasında nullable;
  // her aktif kullanıcı için zorunlu hâle gelecek (V2).
  authId       String?   @unique
  // Supabase Auth source-of-truth olduktan sonra bcrypt hash gereksiz; legacy
  // / migration kayıtları için nullable bırakıldı, V2'de DROP edilecek.
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  role         UserRole  @default(BUYER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // E.7.A — davetle eklenen kullanıcılar için
  invitedById String?
  invitedBy   User?   @relation("UserInvitedBy", fields: [invitedById], references: [id])
  invitees    User[]  @relation("UserInvitedBy")
  invitedAt   DateTime?

  // E.7.A — kategori bazlı bildirim tercihleri (key: boolean)
  notificationPrefs Json?

  // V2-6.5 — RBAC override: { added?: string[], removed?: string[] }
  // null = saf role default; dolu = role default'undan eklenen/eksiltilen permission'lar
  permissionsOverride Json?

  // V2-6.5 — Soft delete. Firma yöneticisi "Sil" deyince:
  // deletedAt=now, isActive=false, kişisel veriler anonimleştirilir
  // (KVKK/GDPR + e-posta tekrar kullanılabilir). Tender/Order referansları
  // KIRILMAZ; sadece kullanıcı listede gizli + login engelli.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sentSupplierInvitations SupplierInvitation[]
  tendersCreated          Tender[]                  @relation("TendersCreated")
  sentUserInvitations     UserInvitation[]          @relation("UserInvitationInviter")

  // E.7.C — onay akışı reverse relations
  createdApprovalFlows ApprovalFlow[]            @relation("ApprovalFlowCreatedBy")
  initiatorOfFlows     ApprovalFlowInitiator[]   @relation("ApprovalFlowInitiatorUser")
  approverOfFlows      ApprovalFlowStep[]        @relation("ApprovalFlowStepApprover")

  // E.7.D — onay request reverse relations
  initiatedApprovalRequests ApprovalRequest[]      @relation("InitiatedApprovalRequests")
  approverOfRequestSteps    ApprovalRequestStep[]  @relation("ApproverOfRequestSteps")

  // V1.5 — sipariş workflow reverse relations
  ordersDeliveryStarted Order[] @relation("OrderDeliveryStarted")
  ordersCompleted       Order[] @relation("OrderCompleted")
  ordersCancelled       Order[] @relation("OrderCancelled")

  // V2-2 — R2 dosya yükleme
  uploadedAttachments   Attachment[] @relation("UploadedAttachments")

  // V2-6.5 — Admin tarafından üretilen parola sıfırlama linkleri
  passwordResetTokens   PasswordResetToken[]

  @@index([tenantId])
  @@map("users")
}

// V2-6.5 — Admin destek operasyonları için tek-kullanımlık parola
// sıfırlama tokenleri. Token plain DB'de tutulmaz; sadece SHA-256
// hash'i saklanır. Süresi 1 saat (TTL service'te enforce edilir).
model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  createdByAdminId String?

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserInvitation {
  id          String                 @id @default(cuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        UserRole
  token       String                 @unique
  invitedById String
  invitedBy   User                   @relation("UserInvitationInviter", fields: [invitedById], references: [id])
  status      UserInvitationStatus   @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  cancelledAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([tenantId, email, status])
  @@index([token])
  @@map("user_invitations")
}

enum UserInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum UserRole {
  COMPANY_ADMIN
  BUYER
  APPROVER
}

// ---------- PLATFORM TARAFI (Supkeys ekibi) ----------

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  // Supabase Auth bridge — `auth.users.id` (UUID).
  authId       String?  @unique
  passwordHash String?
  firstName    String
  lastName     String
  role         AdminRole @default(SUPPORT)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedDemoRequests         DemoRequest[]
  reviewedBuyerApplications    BuyerApplication[]    @relation("BuyerAppReviewer")
  reviewedSupplierApplications SupplierApplication[] @relation("SupplierAppReviewer")

  @@map("platform_admins")
}

enum AdminRole {
  SUPER_ADMIN  // her şey
  SALES        // demo, tenant
  SUPPORT      // sadece okuma + tenant impersonate
}

// ---------- LEAD / DEMO TALEPLERİ ----------

model DemoRequest {
  id           String            @id @default(cuid())
  companyName  String
  contactName  String
  email        String
  phone        String?
  jobTitle     String?
  companySize  String?
  message      String?
  status       DemoRequestStatus @default(NEW)
  source       String?
  notes        String?
  contactedAt  DateTime?
  closedAt     DateTime?
  closedReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  assignedToId String?
  assignedTo   PlatformAdmin? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  // ---------- DAVET (admin → demo görüşmesinden sonra kayıt linki) ----------
  inviteToken       String?   @unique // sha256 hash; ham token sadece e-postada
  inviteSentAt      DateTime?
  inviteSentToEmail String? // davet hangi e-postaya gönderildi (demo.email'den farklı olabilir)
  inviteSentMessage String? // admin'in kişisel notu
  inviteTokenExpAt  DateTime?
  inviteUsedAt      DateTime? // tek kullanımlık
  inviteSentCount   Int       @default(0)

  // Davetten kayıt akışı tamamlanınca bağlanan başvuru
  linkedApplicationId String?           @unique
  linkedApplication   BuyerApplication? @relation("DemoToBuyerApp", fields: [linkedApplicationId], references: [id])

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("demo_requests")
}

enum DemoRequestStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  DEMO_DONE
  WON
  LOST
  SPAM
}

// ---------- E-POSTA LOGLARI ----------

model EmailLog {
  id                String      @id @default(cuid())
  template          String
  toEmail           String
  toName            String?
  subject           String
  provider          String
  providerMessageId String?     @unique
  status            EmailStatus @default(QUEUED)
  errorMessage      String?
  payload           Json?
  attemptCount      Int         @default(0)
  queuedAt          DateTime    @default(now())
  sentAt            DateTime?
  failedAt          DateTime?

  // V2-1 — Resend webhook delivery tracking
  deliveredAt   DateTime?
  openedAt      DateTime?     // ilk açılma
  clickedAt     DateTime?     // ilk tıklama
  bouncedAt     DateTime?
  bounceType    String?       // "hard" | "soft" | "undetermined"
  bounceReason  String?       @db.Text
  complainedAt  DateTime?

  events        EmailEvent[]

  contextType String?
  contextId   String?

  @@index([status])
  @@index([toEmail])
  @@index([template])
  @@index([contextType, contextId])
  @@index([queuedAt])
  @@map("email_logs")
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  // V2-1 — Resend webhook tracking
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
}

// V2-1 — Resend webhook event audit trail
model EmailEvent {
  id          String    @id @default(cuid())
  emailLogId  String
  emailLog    EmailLog  @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  /// Webhook idempotency key (svix-id header). Aynı event 2 kez işlenmesin.
  eventId     String    @unique
  eventType   EmailEventType
  /// Resend payload'tan gelen orijinal timestamp.
  occurredAt  DateTime
  payload     Json

  /// CLICKED event için tıklanan link.
  clickedUrl  String?   @db.Text
  /// BOUNCED event için bounce detay.
  bounceType  String?
  bounceReason String?  @db.Text

  createdAt   DateTime  @default(now())

  @@index([emailLogId, occurredAt])
  @@index([eventType])
  @@map("email_events")
}

enum EmailEventType {
  SENT
  DELIVERED
  DELIVERY_DELAYED
  BOUNCED
  COMPLAINED
  OPENED
  CLICKED
  FAILED
}

// ============================================================
// REGISTRATION & APPLICATIONS
// ============================================================

model BuyerApplication {
  id              String              @id @default(cuid())

  companyName     String
  companyType     CompanyType
  taxNumber       String
  taxOffice       String
  taxCertUrl      String
  industry        String?
  website         String?

  city            String
  district        String
  addressLine     String
  postalCode      String?

  adminFirstName  String
  adminLastName   String
  adminEmail      String
  adminPhone      String?
  // Supabase Auth geçişi sonrası kullanılmıyor — onay anında Supabase
  // sendPasswordResetEmail tetikleniyor, applicant şifresini sıfırlama
  // linkiyle kuruyor. V2'de DROP edilecek.
  passwordHash    String?

  status          ApplicationStatus   @default(PENDING_EMAIL_VERIFICATION)

  emailToken      String?             @unique
  emailTokenExp   DateTime?
  emailVerifiedAt DateTime?

  reviewedById    String?
  reviewedBy      PlatformAdmin?      @relation("BuyerAppReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  tenantId        String?             @unique
  tenant          Tenant?             @relation("BuyerAppTenant", fields: [tenantId], references: [id])

  // Demo görüşmesi sonrası gönderilen davetle mi geldi?
  fromDemoRequest DemoRequest?        @relation("DemoToBuyerApp")

  ipAddress       String?
  userAgent       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([adminEmail, status])
  @@index([status])
  @@index([adminEmail])
  @@index([createdAt])
  @@map("buyer_applications")
}

model SupplierApplication {
  id              String              @id @default(cuid())

  companyName     String
  companyType     CompanyType
  taxNumber       String
  taxOffice       String
  taxCertUrl      String
  industry        String?
  website         String?

  city            String
  district        String
  addressLine     String
  postalCode      String?

  adminFirstName  String
  adminLastName   String
  adminEmail      String
  adminPhone      String?
  // Supabase Auth geçişi sonrası kullanılmıyor — bkz. BuyerApplication.passwordHash.
  passwordHash    String?

  // V2-6 — register sırasında seçilen kategori ID'leri (Family seviyesi).
  // Admin onayında Supplier oluşturulurken SupplierCategory junction'a aktarılır.
  categoryIds     Json?

  status          ApplicationStatus   @default(PENDING_EMAIL_VERIFICATION)

  emailToken      String?             @unique
  emailTokenExp   DateTime?
  emailVerifiedAt DateTime?

  invitationId      String?             @unique
  invitation        SupplierInvitation? @relation(fields: [invitationId], references: [id])
  invitedByTenantId String?
  invitedByTenant   Tenant?             @relation("SupplierAppInviter", fields: [invitedByTenantId], references: [id])

  reviewedById    String?
  reviewedBy      PlatformAdmin?      @relation("SupplierAppReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  supplierId      String?             @unique
  supplier        Supplier?           @relation("SupplierAppSupplier", fields: [supplierId], references: [id])

  ipAddress       String?
  userAgent       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([adminEmail])
  @@index([invitedByTenantId])
  @@index([createdAt])
  @@map("supplier_applications")
}

enum ApplicationStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CompanyType {
  JOINT_STOCK
  LIMITED
  SOLE_PROPRIETOR
}

// ============================================================
// SUPPLIER (gerçek tedarikçi entitysi)
// ============================================================

model Supplier {
  id            String             @id @default(cuid())
  companyName   String
  companyType   CompanyType
  taxNumber     String             @unique
  taxOffice     String
  taxCertUrl    String
  industry      String?
  website       String?
  city          String
  district      String
  addressLine   String
  postalCode    String?
  membership    SupplierMembership @default(STANDARD)
  isActive      Boolean            @default(true)
  isBlocked     Boolean            @default(false)
  blockedReason String?
  blockedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  users               SupplierUser[]
  tenantRelations     SupplierTenantRelation[]
  application         SupplierApplication?      @relation("SupplierAppSupplier")
  invitationsAccepted SupplierInvitation[]      @relation("AcceptedBySupplier")
  tenderInvitations   TenderInvitation[]
  bids                Bid[]
  orders              Order[]
  messageThreads      MessageThread[] @relation("SupplierMessageThreads")
  categories          SupplierCategory[]

  @@index([taxNumber])
  @@index([membership])
  @@map("suppliers")
}

enum SupplierMembership {
  STANDARD // Davet ile veya self-register, ücretsiz (eski adı: BRONZE)
  PREMIUM  // Havuza açık, ücretli (V2'de aktif olur, eski adı: SILVER)
}

model SupplierUser {
  id           String    @id @default(cuid())
  email        String    @unique
  // Supabase Auth bridge — `auth.users.id` (UUID).
  authId       String?   @unique
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  bidsSubmitted Bid[]

  // V2-2 — R2 dosya yükleme
  uploadedAttachments Attachment[] @relation("UploadedAttachmentsSupplier")

  @@index([supplierId])
  @@map("supplier_users")
}

model SupplierTenantRelation {
  id            String         @id @default(cuid())
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status        RelationStatus @default(ACTIVE)
  blockedAt     DateTime?
  blockedReason String?
  createdAt     DateTime       @default(now())

  @@unique([supplierId, tenantId])
  @@index([tenantId])
  @@index([supplierId])
  @@map("supplier_tenant_relations")
}

enum RelationStatus {
  ACTIVE
  PENDING_TENANT_APPROVAL
  BLOCKED
}

// ============================================================
// SUPPLIER INVITATIONS (alıcı → tedarikçi davetleri)
// ============================================================

model SupplierInvitation {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedByUserId String
  invitedByUser   User             @relation(fields: [invitedByUserId], references: [id])

  email           String
  contactName     String?
  message         String?

  tokenHash       String           @unique
  expiresAt       DateTime

  status          InvitationStatus @default(PENDING)
  acceptedAt      DateTime?
  cancelledAt     DateTime?
  acceptedBySupplierId String?
  acceptedBySupplier   Supplier?  @relation("AcceptedBySupplier", fields: [acceptedBySupplierId], references: [id])

  sentCount  Int      @default(1)
  lastSentAt DateTime @default(now())

  // Multi-tenant tedarikçi davet kabul akışı (D.2.B)
  // Davet oluşturulurken: e-posta zaten aktif bir SupplierUser'a aitse true.
  // Mevcut tedarikçi /supplier/profil üzerinden, yeni tedarikçi /register/supplier üzerinden kabul eder.
  isExistingSupplier Boolean @default(false)
  // Kullanıcının e-posta dışında manuel girebilmesi için kısa kod (Crockford Base32 4-4: K7X9-3M2P).
  // Legacy satırlarda NULL kalabilir; yeni davetlerde her zaman üretilir.
  shortCode  String?  @unique
  // Davet linki ilk açıldığında set edilir; alıcı tarafa "açıldı/açılmadı" göstergesi için.
  openedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application SupplierApplication?

  @@index([tenantId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("supplier_invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// ============================================================
// TENDER MODULE — Aşama E
// ============================================================

enum TenderType {
  RFQ                  // Request for Quotation (kapalı teklif)
  ENGLISH_AUCTION      // İngiliz usulü açık eksiltme (V2)
}

enum TenderStatus {
  DRAFT                // Taslak (henüz yayınlanmadı)
  IN_APPROVAL          // E.7.D — yayın için onay bekliyor
  OPEN_FOR_BIDS        // Yayında, teklif alıyor
  IN_AWARD             // Süre doldu, alıcı kazandırma yapıyor
  IN_AWARD_APPROVAL    // E.7.D — kazandırma için onay bekliyor
  AWARDED              // Kazandırıldı, sipariş oluştu
  CANCELLED            // İptal edildi
  CLOSED_NO_AWARD      // Süre doldu, kazandırma yapılmadı
}

enum Currency {
  TRY
  USD
  EUR
  GBP
  CHF
  JPY
  AED
  CNY
}

enum DeliveryTerm {
  EXW
  FCA
  CPT
  CIP
  DAP
  DPU
  DDP
  FAS
  FOB
  CFR
  CIF
}

enum PaymentTerm {
  CASH                 // Peşin
  DEFERRED             // Vadeli
}

enum TenderInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum BidStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
  REJECTED
  AWARDED_PARTIAL
  AWARDED_FULL
  LOST
}

enum OrderStatus {
  PENDING        // Sipariş açıldı, tedarikçi onayı bekleniyor
  ACCEPTED       // Tedarikçi siparişi onayladı + bilgileri (teslim tarihi, banka, fatura) girdi
  IN_DELIVERY    // Tedarikçi gönderim başlattı
  COMPLETED      // Alıcı teslim aldı
  REJECTED       // Tedarikçi siparişi reddetti (sebep ile)
  CANCELLED      // Alıcı iptal etti (sebep ile)
  IN_PROGRESS    // (legacy, kullanılmıyor — eski kayıtlar için)
  DELIVERED      // (legacy, kullanılmıyor — eski kayıtlar için)
}

model Tender {
  id                  String          @id @default(cuid())

  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  createdById         String
  createdBy           User            @relation("TendersCreated", fields: [createdById], references: [id])

  tenderNumber        String          @unique
  type                TenderType      @default(RFQ)
  status              TenderStatus    @default(DRAFT)

  title               String
  description         String?
  termsAndConditions  String?
  internalNotes       String?

  isSealedBid         Boolean         @default(true)
  requireAllItems     Boolean         @default(false)
  requireBidDocument  Boolean         @default(false)

  primaryCurrency     Currency        @default(TRY)
  /** V2-6 — Kabul edilen para birimleri (1-8); primaryCurrency listenin başı (TRY equivalent base). */
  allowedCurrencies   Currency[]      @default([])

  deliveryTerm        DeliveryTerm?
  // E.7.B'den önce: free-text. E.7.B sonrası: backward-compat fallback —
  // yeni tender'larda deliveryAddressSnapshot'tan formatlı string yazılır.
  deliveryAddress     String?
  // E.7.B — tender oluşturma anında TenantAddress'in JSON snapshot'ı.
  // Adres sonradan değişse/silinse bile tender bu kaydı korur.
  billingAddressSnapshot  Json?
  deliveryAddressSnapshot Json?

  paymentTerm         PaymentTerm     @default(CASH)
  paymentDays         Int?

  // Tahmini toplam tutar (primaryCurrency'de) — tüm items targetUnitPrice
  // ve quantity'sinden hesaplanır. Bir item targetUnitPrice'ı yoksa null.
  // List filter (tutar aralığı) için denormalize, createDraft/updateDraft
  // sırasında güncellenir.
  estimatedTotal      Decimal?        @db.Decimal(20, 4)

  publishedAt         DateTime?
  bidsOpenAt          DateTime?
  bidsCloseAt         DateTime
  awardedAt           DateTime?
  cancelledAt         DateTime?
  cancelReason        String?

  // V2-6 — Birden fazla UNSPSC kategorisi (Class veya Commodity). Junction tablo.
  categories          TenderCategory[]

  items               TenderItem[]
  invitations         TenderInvitation[]
  bids                Bid[]
  orders              Order[]
  attachments         TenderAttachment[]
  approvalRequests    ApprovalRequest[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([status, bidsCloseAt])
  @@map("tenders")
}

model TenderItem {
  id                  String          @id @default(cuid())
  tenderId            String
  tender              Tender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  orderIndex          Int
  name                String
  description         String?

  quantity            Decimal         @db.Decimal(15, 4)
  unit                String

  materialCode        String?
  requiredByDate      DateTime?
  targetUnitPrice     Decimal?        @db.Decimal(15, 4)

  customQuestion      String?

  bidItems            BidItem[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([tenderId, orderIndex])
  @@map("tender_items")
}

model TenderInvitation {
  id                  String                @id @default(cuid())
  tenderId            String
  tender              Tender                @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  supplierId          String
  supplier            Supplier              @relation(fields: [supplierId], references: [id])

  status              TenderInvitationStatus @default(PENDING)
  invitedAt           DateTime              @default(now())
  respondedAt         DateTime?

  emailSentAt         DateTime?
  emailOpenedAt       DateTime?

  @@unique([tenderId, supplierId])
  @@index([supplierId, status])
  @@map("tender_invitations")
}

model Bid {
  id                  String          @id @default(cuid())
  tenderId            String
  tender              Tender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  supplierId          String
  supplier            Supplier        @relation(fields: [supplierId], references: [id])
  submittedById       String
  submittedBy         SupplierUser    @relation(fields: [submittedById], references: [id])

  status              BidStatus       @default(DRAFT)

  currency            Currency
  totalAmount         Decimal         @db.Decimal(20, 4)

  notes               String?
  version             Int             @default(1)

  submittedAt         DateTime?
  withdrawnAt         DateTime?

  // Eleme alanları (E.5) — alıcı SUBMITTED bid'i LOST'a çevirdiğinde dolar.
  eliminationReason   String?
  eliminatedAt        DateTime?

  // V2-3 — submit anındaki TCMB kuru snapshot'ı.
  // Shape: { rate: number, fetchedAt: ISO, source: "TCMB"|"MANUAL"|"FALLBACK", rateDate: ISO }
  // bid.currency=TRY ise null kalır (gerek yok).
  exchangeRateSnapshot Json?

  items               BidItem[]
  attachments         BidAttachment[]
  orders              Order[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([tenderId, supplierId])
  @@index([tenderId, status])
  @@map("bids")
}

model BidItem {
  id                  String          @id @default(cuid())
  bidId               String
  bid                 Bid             @relation(fields: [bidId], references: [id], onDelete: Cascade)
  tenderItemId        String
  tenderItem          TenderItem      @relation(fields: [tenderItemId], references: [id])

  unitPrice           Decimal?        @db.Decimal(15, 4)
  totalPrice          Decimal?        @db.Decimal(20, 4)
  currency            Currency

  customAnswer        String?

  isWinner            Boolean         @default(false)
  awardedQuantity     Decimal?        @db.Decimal(15, 4)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([bidId, tenderItemId])
  @@map("bid_items")
}

model BidAttachment {
  id                  String          @id @default(cuid())
  bidId               String
  bid                 Bid             @relation(fields: [bidId], references: [id], onDelete: Cascade)

  fileName            String
  fileSize            Int
  mimeType            String
  fileUrl             String

  uploadedAt          DateTime        @default(now())

  @@map("bid_attachments")
}

model TenderAttachment {
  id                  String          @id @default(cuid())
  tenderId            String
  tender              Tender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  fileName            String
  fileSize            Int
  mimeType            String
  fileUrl             String

  uploadedAt          DateTime        @default(now())

  @@map("tender_attachments")
}

model Order {
  id                  String          @id @default(cuid())
  orderNumber         String          @unique

  tenderId            String
  tender              Tender          @relation(fields: [tenderId], references: [id])
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  supplierId          String
  supplier            Supplier        @relation(fields: [supplierId], references: [id])
  bidId               String
  bid                 Bid             @relation(fields: [bidId], references: [id])

  status              OrderStatus     @default(PENDING)

  currency            Currency
  totalAmount         Decimal         @db.Decimal(20, 4)

  expectedDeliveryAt  DateTime?       // (legacy, V1.5'ten önce kullanılan)
  deliveredAt         DateTime?       // (legacy)

  notes               String?

  // Tedarikçi onay aşaması (PENDING → ACCEPTED). Onay anında tahmini teslim
  // tarihi, banka/fatura bilgileri ve isteğe bağlı not girer.
  acceptedAt          DateTime?
  acceptedNote        String?         @db.Text
  bankAccountHolder   String?
  bankIban            String?
  invoiceDate         DateTime?

  // Tedarikçi red aşaması (PENDING → REJECTED). Sebep zorunlu.
  rejectedAt          DateTime?
  rejectReason        String?         @db.Text

  // Gönderim aşaması (ACCEPTED → IN_DELIVERY). expectedDeliveryDate ACCEPT
  // adımında girilir; bu blokta tedarikçinin gönderim notu kalır.
  deliveryStartedAt   DateTime?
  deliveryStartedById String?
  deliveryStartedBy   User?           @relation("OrderDeliveryStarted", fields: [deliveryStartedById], references: [id])
  deliveryNote        String?         @db.Text
  expectedDeliveryDate DateTime?

  completedAt         DateTime?
  completedById       String?
  completedBy         User?           @relation("OrderCompleted", fields: [completedById], references: [id])
  completedNote       String?         @db.Text

  cancelledAt         DateTime?
  cancelledById       String?
  cancelledBy         User?           @relation("OrderCancelled", fields: [cancelledById], references: [id])
  cancelReason        String?         @db.Text

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([supplierId, status])
  @@map("orders")
}

// ============================================================
// APPROVAL FLOW MODULE — Aşama E.7.C (config only; runtime E.7.D'de)
// ============================================================

model ApprovalFlow {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  flowNumber   Int                 // tenant-wide counter, 10001+
  name         String
  description  String?
  type         ApprovalFlowType
  status       ApprovalFlowStatus  @default(DRAFT)

  createdById  String
  createdBy    User                @relation("ApprovalFlowCreatedBy", fields: [createdById], references: [id])

  initiators   ApprovalFlowInitiator[]
  steps        ApprovalFlowStep[]
  requests     ApprovalRequest[]

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([tenantId, flowNumber])
  @@index([tenantId, type, status])
  @@index([tenantId, status])
  @@map("approval_flows")
}

model ApprovalFlowInitiator {
  id        String       @id @default(cuid())
  flowId    String
  flow      ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("ApprovalFlowInitiatorUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime     @default(now())

  @@unique([flowId, userId])
  @@index([userId])
  @@map("approval_flow_initiators")
}

model ApprovalFlowStep {
  id                 String       @id @default(cuid())
  flowId             String
  flow               ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  orderIndex         Int          // 1, 2, 3 — sıralı onay
  approverUserId     String
  approver           User         @relation("ApprovalFlowStepApprover", fields: [approverUserId], references: [id], onDelete: Cascade)

  // Bütçe eşiği — null = her zaman aktif; değer = X ve üstü tutarlarda devreye girer
  conditionMinAmount Decimal?     @db.Decimal(20, 2)
  conditionCurrency  String?      @default("TRY")

  // Diagram'da gösterilecek soft etiket (örn "Satınalma Müdürü")
  displayLabel       String?

  requestSteps       ApprovalRequestStep[]

  createdAt          DateTime     @default(now())

  @@unique([flowId, orderIndex])
  @@index([approverUserId])
  @@map("approval_flow_steps")
}

enum ApprovalFlowType {
  TENDER_PUBLISH
  TENDER_AWARD
}

enum ApprovalFlowStatus {
  DRAFT
  ACTIVE
  PASSIVE
}

// ============================================================
// APPROVAL REQUEST RUNTIME — Aşama E.7.D
// ============================================================

model ApprovalRequest {
  id              String   @id @default(cuid())
  approvalNumber  String   @unique // APR-YYYY-NNNN

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  flowId          String
  flow            ApprovalFlow @relation(fields: [flowId], references: [id])

  // Polymorphic — V1'de sadece tender. V2'de orderId/purchaseRequestId gelecek.
  type            ApprovalFlowType
  tenderId        String
  tender          Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  status          ApprovalRequestStatus @default(PENDING)

  // Match anında hesaplanan bütçe (snapshot — rule değişse bile request bağımsız)
  amount          Decimal  @db.Decimal(20, 2)
  currency        String   @default("TRY")

  initiatedById   String
  initiatedBy     User     @relation("InitiatedApprovalRequests", fields: [initiatedById], references: [id])
  initiatorNote   String?

  steps           ApprovalRequestStep[]

  startedAt       DateTime @default(now())
  completedAt     DateTime?

  // V1.5 Oturum 2 — onay reminder cron idempotency
  lastReminderAt  DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status, type])
  @@index([tenantId, status])
  @@index([tenderId])
  @@index([initiatedById, status])
  @@map("approval_requests")
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequestStep {
  id              String   @id @default(cuid())
  requestId       String
  request         ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  flowStepId      String
  flowStep        ApprovalFlowStep @relation(fields: [flowStepId], references: [id])

  approverUserId  String
  approver        User     @relation("ApproverOfRequestSteps", fields: [approverUserId], references: [id])

  status          ApprovalStepStatus @default(WAITING)
  orderIndex      Int

  // Snapshot (rule değişebilir, request bağımsız)
  conditionMinAmount  Decimal? @db.Decimal(20, 2)
  displayLabel    String?

  decidedAt       DateTime?
  decisionNote    String?

  createdAt       DateTime @default(now())

  @@index([approverUserId, status])
  @@index([requestId, orderIndex])
  @@map("approval_request_steps")
}

enum ApprovalStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

// ---------- V2-2: DOSYA YÜKLEME (Cloudflare R2) ----------
//
// Polymorphic attachment — scope + scopeRefId ile sahip kaynağa bağlanır.
// (Legacy BidAttachment/TenderAttachment base64 modelleri korunuyor; yeni
// uploadlar buraya yazılır, FE/BE yeni model üzerinden çalışır.)

model Attachment {
  id                       String           @id @default(cuid())

  // Sahibi her zaman bir tenant. BID_RESPONSE'da tedarikçi yükler ama scope
  // hedefi (tender'ın) tenant'ı; ORDER_INVOICE'da order tenantı.
  tenantId                 String
  tenant                   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Yükleyen — tenant veya supplier kullanıcısı (sadece biri set olur).
  uploadedByUserId         String?
  uploadedByUser           User?            @relation("UploadedAttachments", fields: [uploadedByUserId], references: [id])
  uploadedBySupplierUserId String?
  uploadedBySupplierUser   SupplierUser?    @relation("UploadedAttachmentsSupplier", fields: [uploadedBySupplierUserId], references: [id])

  scope                    AttachmentScope
  scopeRefId               String           // tender.id | bid.id | order.id

  // R2 storage key — `{env}/{tenantId}/{attachmentId}-{sanitizedFilename}`
  key                      String           @unique
  originalFilename         String
  mimeType                 String
  fileSize                 Int              // bytes

  status                   AttachmentStatus @default(PENDING)

  createdAt                DateTime         @default(now())
  finalizedAt              DateTime?

  @@index([tenantId, scope, scopeRefId])
  @@index([tenantId, status])
  @@index([uploadedByUserId])
  @@index([uploadedBySupplierUserId])
  @@map("attachments")
}

enum AttachmentScope {
  TENDER_DOC
  BID_RESPONSE
  ORDER_INVOICE
  MESSAGE_ATTACHMENT  // V2-4 — mesaj eki (scopeRefId = order veya tender id)
}

enum AttachmentStatus {
  PENDING   // Presigned URL üretildi, R2'ye henüz yüklenmedi
  UPLOADED  // R2'de mevcut, kullanılabilir
}

// ---------- V2-3: ÇOKLU PARA BİRİMİ + TCMB KUR CACHE ----------
//
// TCMB (Türkiye Cumhuriyet Merkez Bankası) günlük gösterge kurları.
// Hafta içi 15:30 civarı yayınlar; cron 16:00 İstanbul saatinde fetch eder.
// TRY için kayıt YOK (rate=1 sabit). Sadece USD/EUR.

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  Currency
  rate      Decimal  @db.Decimal(15, 6) // 1 {currency} = X TRY
  rateDate  DateTime @db.Date           // TCMB tarihi (gün-bazlı)
  source    String   @default("TCMB")   // TCMB | MANUAL | FALLBACK
  fetchedAt DateTime @default(now())

  @@unique([currency, rateDate])
  @@index([rateDate])
  @@map("exchange_rates")
}

// ---------- V2-4: 1-ON-1 MESAJLAŞMA ----------
//
// Polymorphic thread — context (ORDER veya TENDER) + contextRefId.
// 1 alıcı-tedarikçi-context kombinasyonu için tek thread.
// Tedarikçiler birbirini görmez (kapalı zarf gereği).

model MessageThread {
  id           String          @id @default(cuid())

  context      MessageContext
  contextRefId String           // orderId veya tenderId

  tenantId     String
  tenant       Tenant           @relation("TenantMessageThreads", fields: [tenantId], references: [id], onDelete: Cascade)

  supplierId   String
  supplier     Supplier         @relation("SupplierMessageThreads", fields: [supplierId], references: [id], onDelete: Cascade)

  messages     Message[]

  lastMessageAt      DateTime?
  lastMessagePreview String?    @db.VarChar(200) // V2-4 — son mesaj preview (header dropdown + thread list için cached)
  tenantLastReadAt   DateTime?
  supplierLastReadAt DateTime?

  createdAt    DateTime         @default(now())

  @@unique([context, contextRefId, tenantId, supplierId])
  @@index([tenantId, lastMessageAt])
  @@index([supplierId, lastMessageAt])
  @@index([context, contextRefId])
  @@map("message_threads")
}

model Message {
  id                   String              @id @default(cuid())
  threadId             String
  thread               MessageThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderType           MessageSenderType
  senderUserId         String?             // User.id (TENANT_USER ise)
  senderSupplierUserId String?             // SupplierUser.id (SUPPLIER_USER ise)

  content              String              @db.Text
  /** R2 Attachment.id'lerinin array'i (MESSAGE_ATTACHMENT scope'lu). */
  attachmentIds        Json                @default("[]")

  emailNotifiedAt      DateTime?

  sentAt               DateTime            @default(now())

  @@index([threadId, sentAt])
  @@index([emailNotifiedAt, sentAt])
  @@map("messages")
}

enum MessageContext {
  ORDER
  TENDER
  // V2-4.1 — Şirket-bazlı doğrudan sohbet. Tender/Order'a bağlı değil.
  // contextRefId = supplierId (tenant->supplier yönünde başlatıldıysa) veya
  // tenantId (supplier->tenant yönünde başlatıldıysa). Thread uniqueness
  // (tenantId, supplierId, context, contextRefId) garantili, çakışmaz.
  DIRECT
}

enum MessageSenderType {
  TENANT_USER
  SUPPLIER_USER
}

// ---------- V2-6: KATEGORİ SİSTEMİ (UNSPSC tabanlı, 2 seviye) ----------
//
// Self-referencing tek tablo, 4 seviye UNSPSC:
//   level 1 = Segment   (XX000000)
//   level 2 = Family    (XXXX0000)
//   level 3 = Class     (XXXXXX00)
//   level 4 = Commodity (XXXXXXXX)
// Tedarikçi (many) ve Tender (single) Level 3 veya 4'e bağlanır.
// Level 1+2 sadece UI accordion grup başlığıdır — seçilemez.

model Category {
  id              String              @id @default(cuid())
  /** UNSPSC 8-haneli kod (10000000=segment, 10100000=family, 10101500=class, 10101501=commodity) */
  code            String              @unique
  nameTr          String
  /** 1=Segment, 2=Family, 3=Class, 4=Commodity */
  level           Int

  parentId        String?
  parent          Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        Category[]          @relation("CategoryHierarchy")

  /** Sadece level 1: PratisPro tarzı harf prefix (A, B, C...) */
  segmentLetter   String?
  sortOrder       Int                 @default(0)
  isActive        Boolean             @default(true)

  supplierCategories SupplierCategory[]
  tenderCategories   TenderCategory[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([parentId, sortOrder])
  @@index([level, sortOrder])
  @@index([code])
  @@map("categories")
}

model SupplierCategory {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([supplierId, categoryId])
  @@index([categoryId])
  @@map("supplier_categories")
}

model TenderCategory {
  id          String   @id @default(cuid())
  tenderId   String
  tender     Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([tenderId, categoryId])
  @@index([categoryId])
  @@index([tenderId])
  @@map("tender_categories")
}
