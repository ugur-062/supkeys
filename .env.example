# ============================================================================
# Rothern .env şablonu — değerleri kendi Supabase/Resend/R2 hesabınızla doldurun.
# Docker yok, lokal servis yok.
# ============================================================================

# ---- Database (Supabase Postgres) -----------------------------------------
# Dashboard → Settings → Database → Connection string
# DIRECT_URL = Session pooler (port 5432) — Prisma migrate için
DIRECT_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL = Transaction pooler (port 6543) — runtime query'leri için
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20

# ---- Supabase Auth ---------------------------------------------------------
# Dashboard → Settings → API
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<anon JWT>
SUPABASE_SERVICE_ROLE_KEY=<service_role JWT — server-side only, asla browser'a sızmasın>
# Dashboard → Settings → API → JWT Settings → JWT Secret

# ---- API -------------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
# Üretmek için: openssl rand -base64 48
JWT_SECRET=change_me_minimum_32_chars
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# httpOnly oturum cookie'sinin Domain'i. PROD'da subdomain'ler arası (app/admin/
# api → .rothern.com) paylaşım için ".rothern.com" ver. DEV'de BOŞ bırak
# (localhost host-only; portlar same-site). Prod ayrıca NODE_ENV=production ile
# Secure bayrağını açar.
COOKIE_DOMAIN=
NODE_ENV=development

# ---- Web (tenant) ----------------------------------------------------------
WEB_PORT=3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# SEO kanonik kök URL (sitemap/robots/og + /firma/<slug> canonical). Prod'da set ŞART.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pazar yeri (herkese açık vitrin) ---------------------------------------
# İKİ anahtar, İKİ platform; ikisi de fail-closed (env yoksa KAPALI, yalnız
# tam olarak "true" açar). Biri eksikse pazar yeri BOŞ görünür — görünür bir
# hata, sessiz sızıntının tersi.
#   MARKETPLACE_LIVE            → API uçları (/public/listings*, /directory*)
#   NEXT_PUBLIC_MARKETPLACE_LIVE→ web sayfaları + robots + sitemap (BUILD zamanı)
# Açılış GERİ ALINAMAZ (indeksten düşme süresi arama motorunun elinde) —
# bkz. docs/launch-checklist.md § Pazar yeri açılışı.
MARKETPLACE_LIVE=false
NEXT_PUBLIC_MARKETPLACE_LIVE=false


# ---- Admin -----------------------------------------------------------------
ADMIN_PORT=3001
ADMIN_URL=http://localhost:3001

# ---- Seed (Initial Platform Admin) ----------------------------------------
INITIAL_ADMIN_EMAIL=admin@rothern.com
INITIAL_ADMIN_PASSWORD=changeme
INITIAL_ADMIN_FIRST_NAME=Rothern
INITIAL_ADMIN_LAST_NAME=Admin

# ---- E-posta (Resend) ------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=<re_...>
EMAIL_FROM_NAME=Rothern
# Dev için onboarding@resend.dev kullanılabilir; prod için kendi domain'inizi
# Resend Dashboard → Domains'te doğrulayın (SPF + DKIM + DMARC).
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_REPLY_TO=

# ---- File Storage (Cloudflare R2) -----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# İKİ BUCKET AYRIMI (güvenlik): public erişim R2'da bucket seviyesindedir.
# - PRIVATE bucket → KYC/ihale/teklif/sipariş belgeleri. Public access ASLA.
# - PUBLIC bucket  → yalnız profil görselleri; custom domain ile kalıcı URL.
# Aynı bucket'ta karışırlarsa key'i bilen herkes hassas belgeyi imzasız çeker.
# Bkz. docs/invariants.md INV-STORAGE-1 + docs/r2-bucket-split.md.
# Dev'de tek bucket yeterli: R2_PUBLIC_BUCKET boşsa private ile aynı kullanılır.
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
# Public profil logo/kapak görsellerinin KALICI URL'i (PUBLIC bucket'ın custom
# domain'i). Set DEĞİLSE görseller 15 dk'lık geçici presigned URL döner (kırılır).
# Prod'da ŞART. Değer: R2 custom domain (https://cdn.rothern.com).
# Web tarafı görsel optimizasyonu (next/image `remotePatterns`) bu değerden
# türetilir — API'nin `R2_PUBLIC_BASE_URL`i ile AYNI host olmalı. Boşsa
# görseller optimize edilmeden düz <img> ile servis edilir (kırılmaz).
NEXT_PUBLIC_CDN_URL=
R2_PUBLIC_BASE_URL=

# ---- AI (Faz AI-0 — Gemini) ------------------------------------------------
# Anahtar YALNIZ backend'de kalır (frontend'e asla sızmaz; çağrı yalnız API'den).
# BOŞSA AI özellikleri KAPALI (503, fail-closed) — boot engellenmez; prod'da
# warn log + Sentry uyarısı düşer. Placeholder/bozuk anahtar prod'da BOOT ETMEZ.
GEMINI_API_KEY=
AI_PROVIDER=gemini
# VERTEX AI modu (opsiyonel — datacenter'dan çağrıda konum kısıtı yaşarsan):
# generativelanguage.googleapis.com datacenter IP'lerini "User location not
# supported" ile reddediyor. Service account JSON verirsen çağrılar Vertex AI
# üzerinden gider (konum proje-bölgesinden, IP'den değil). JSON'un TAM içeriğini
# tek değere yapıştır; project_id JSON'dan okunur, location default "global".
GEMINI_SERVICE_ACCOUNT_JSON=
# GEMINI_VERTEX_PROJECT=  (opsiyonel — JSON'daki project_id'yi ezmek için)
# GEMINI_VERTEX_LOCATION=global
# Model kimlikleri (fiyat tablosu apps/api/src/modules/ai/ai.config.ts'te —
# yeni model = buradaki id + oradaki fiyat satırı; her AiUsage satırı costUsd
# snapshot'ı taşıdığından fiyat güncellemesi geçmişi bozmaz).
# NOT: gemini-2.5-flash yeni hesaplara üretime kapalı — güncel sınıflar:
AI_MODEL_DEFAULT=gemini-flash-latest
AI_MODEL_VISION=gemini-flash-latest
AI_MODEL_PREMIUM=gemini-pro-latest
# Premium'a yükseltme eşiği (tahmini girdi token'ı) + baştan-premium özellik
# anahtarları (virgülle; AI-1'de dolacak). Kullanıcı model SEÇEMEZ.
AI_PREMIUM_INPUT_TOKEN_THRESHOLD=50000
AI_PREMIUM_FEATURES=
AI_MAX_OUTPUT_TOKENS=8192
AI_TIMEOUT_MS=60000
# AI-1 belge çıkarımı: belge başına sayfa/görüntü tavanı (aşan istek reddedilir).
AI_MAX_PAGES=20

# ---- Gözlemlenebilirlik (opsiyonel) ---------------------------------------
# Sentry hata izleme. DSN boşsa Sentry NO-OP (dev'de gerekmez). Prod'da doldurun.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Performans izleme örnekleme oranı (0 = kapalı, yalnız hata izleme).
SENTRY_TRACES_SAMPLE_RATE=0
# Structured logger (Pino) seviyesi: fatal|error|warn|info|debug|trace.
LOG_LEVEL=info

# Self-servis premium yükseltme — ödeme entegrasyonuna kadar KAPALI (default
# false). Bugün premium yalnız admin grant ile verilir (INV-TIER-1). Ödeme
# geldiğinde true yap + upgradeToPremium'a ücretlendirme ekle.
PREMIUM_SELF_UPGRADE_ENABLED=false

# ---- Dev-only -------------------------------------------------------------
# Resend webhook signature bypass — production'da SİL.
ALLOW_INSECURE_WEBHOOK=true

# Cloudflare arkasında gerçek istemci IP'si (throttle/audit): Render/CF kurulumunda true; CF yoksa false.
TRUST_CF_CONNECTING_IP=false
# TOTP sırrı şifreleme anahtarı (opsiyonel; yoksa JWT_SECRET türevi). JWT_SECRET rotasyonundan ÖNCE eski değerle sabitle.
# TOTP_ENC_KEY=
