# Database
POSTGRES_USER=supkeys
POSTGRES_PASSWORD=changeme
POSTGRES_DB=supkeys
POSTGRES_PORT=5432
DATABASE_URL=postgresql://supkeys:changeme@localhost:5432/supkeys?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=supkeys
MINIO_ROOT_PASSWORD=changeme
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=supkeys-dev

# API
API_PORT=4000
API_URL=http://localhost:4000
# JWT_SECRET — production'da MUTLAKA değiştir. 64+ karakter öneriyoruz.
# Üretmek için: `openssl rand -hex 32`
JWT_SECRET=change_me_in_production_minimum_32_chars_long
# Security audit Y-1 — refresh token V2 sprint'inde gelecek; o zamana kadar
# access token kısa ömürlü tutuluyor.
JWT_EXPIRES_IN=1h

# Webhook (V2-1 — Resend imza doğrulayıcı için zorunlu prod'da)
RESEND_WEBHOOK_SECRET=
# Dev'de secret yoksa imza doğrulaması atlanır — ama bu sadece
# ALLOW_INSECURE_WEBHOOK=true set edilmişse mümkün. Production'da etkisiz.
ALLOW_INSECURE_WEBHOOK=false

# CORS — virgülle ayrılmış origin'ler
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Web (tenant)
WEB_PORT=3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Admin
ADMIN_PORT=3001
ADMIN_URL=http://localhost:3001

# Node
NODE_ENV=development

# Initial Platform Admin (seed only).
# UYARI — Production'da MUTLAKA güçlü bir parola koy. Seed çalışır ve bu
# değerle PlatformAdmin oluşturulur. Aşağıdaki "changeme" placeholder bir
# guard ile production'da reddedilir (packages/db/prisma/seed.ts).
INITIAL_ADMIN_EMAIL=admin@supkeys.com
INITIAL_ADMIN_PASSWORD=changeme
INITIAL_ADMIN_FIRST_NAME=Supkeys
INITIAL_ADMIN_LAST_NAME=Admin

# Resend (e-posta)
RESEND_API_KEY=re_xxx
EMAIL_FROM_NAME=Supkeys
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_REPLY_TO=

# E-posta provider seçimi: "mailpit" (lokal) veya "resend" (gerçek gönderim)
EMAIL_PROVIDER=mailpit

# Mailpit (lokal SMTP yakalayıcı — http://localhost:8025 web UI)
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Cloudflare R2 (V2-2 — S3-compatible object storage)
# Cloudflare Dashboard → R2 → Create bucket "supkeys-attachments"
# → Manage API Tokens → Create Account API Token (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=supkeys-attachments
# Boş bırakılırsa indirme hep presigned URL ile yapılır.
# V2 hosting'de "cdn.supkeys.com" gibi custom domain bağlanabilir.
R2_PUBLIC_BASE_URL=
