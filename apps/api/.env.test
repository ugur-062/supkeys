# Test ortamı için ayrı DB — `rothern_test` (aynı PG container'da).
# `test/setup.ts` ilk çalıştırmada DB oluşturur + migration uygular.
DATABASE_URL=postgresql://rothern:rothern_dev_password@localhost:5432/rothern_test?schema=public
NODE_ENV=test
JWT_SECRET=test_jwt_secret_only_for_unit_and_integration_tests_64bytes_minimum
JWT_EXPIRES_IN=1h
# E-posta queue'yu testte boğazlamamak için inline mock'lanıyor (test/helpers).
EMAIL_PROVIDER=mailpit
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
# R2 / Redis testlerde mock'lanır — gerçek bağlantı denemez.
REDIS_URL=redis://localhost:6379/15
RESEND_WEBHOOK_SECRET=
ALLOW_INSECURE_WEBHOOK=true
CORS_ORIGINS=http://localhost:3000
