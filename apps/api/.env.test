# Lokal test DB — docker-compose.test.yml (postgres:17, 5432). SIR DEĞİL: CI'ın
# inline env'iyle aynı sınıf fixture; .gitignore'da `!.env.test` ile commit'li.
# env.ts bunu kök .env'DEN ÖNCE yükler → buradaki DB URL'i kök .env'in Supabase
# URL'ini EZER (prod/dev'e dokunulmaz). DIRECT_URL ZORUNLU: env.ts base'i
# `DIRECT_URL || DATABASE_URL` — set edilmezse kök .env'in Supabase DIRECT_URL'i
# seçilirdi. global-setup migrate deploy bu DB'ye 28 migration'ı uygular.
DATABASE_URL=postgresql://rothern:rothern_test_password@localhost:5432/rothern_test?schema=public
DIRECT_URL=postgresql://rothern:rothern_test_password@localhost:5432/rothern_test?schema=public
NODE_ENV=test
JWT_SECRET=test_jwt_secret_only_for_unit_and_integration_tests_64bytes_minimum
JWT_EXPIRES_IN=1h
# E-posta queue'yu testte boğazlamamak için inline mock'lanıyor (test/helpers).
EMAIL_PROVIDER=mailpit
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
# R2 / Redis testlerde mock'lanır — gerçek bağlantı denemez.
REDIS_URL=redis://localhost:6379/15
RESEND_WEBHOOK_SECRET=
ALLOW_INSECURE_WEBHOOK=true
CORS_ORIGINS=http://localhost:3000
