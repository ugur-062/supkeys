{
  "name": "@supkeys/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n tsc,node -c blue,green \"tsc -w --preserveWatchOutput\" \"nodemon --watch dist --delay 300ms dist/main.js\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:unit": "jest --runInBand --testPathPattern='\\.spec\\.ts$' --testPathIgnorePatterns='\\.integration\\.spec\\.ts$'",
    "test:int": "jest --runInBand --testPathPattern='\\.integration\\.spec\\.ts$'",
    "test:db:prepare": "bash test/scripts/prepare-test-db.sh",
    "test:emails": "ts-node --transpile-only src/scripts/test-emails.ts",
    "test:webhook": "ts-node --transpile-only src/scripts/mock-resend-events.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@supkeys/db": "workspace:*",
    "@supkeys/email": "workspace:*",
    "@supkeys/shared": "workspace:*",
    "axios": "^1.15.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.76.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "puppeteer": "^24.43.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "svix": "^1.93.0",
    "xml2js": "^0.6.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "@types/xml2js": "^0.4.14",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
