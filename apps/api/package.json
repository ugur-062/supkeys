{
  "name": "@rothern/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n tsc,node -c blue,green \"tsc -w --preserveWatchOutput\" \"nodemon --watch dist --delay 300ms dist/main.js\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:db:up": "docker compose -f ../../docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f ../../docker-compose.test.yml down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@google/genai": "^2.13.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@rothern/db": "workspace:*",
    "@rothern/email": "workspace:*",
    "@rothern/shared": "workspace:*",
    "@sentry/nestjs": "^8.55.2",
    "@supabase/supabase-js": "^2.106.0",
    "axios": "^1.15.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "file-type": "^16.5.4",
    "heic-convert": "^2.1.0",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.6.1",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "svix": "^1.93.0",
    "xml2js": "^0.6.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/heic-convert": "^2.1.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/xml2js": "^0.4.14",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.0"
  }
}
